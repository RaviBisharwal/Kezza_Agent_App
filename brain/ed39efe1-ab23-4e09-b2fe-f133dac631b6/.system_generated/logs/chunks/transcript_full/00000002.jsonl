`, { status, reason: 'Updated by agent follow-up' })).data,\n26:     onSuccess: () => { void client.invalidateQueries({ queryKey: ['referral-detail', id] }); void client.invalidateQueries({ queryKey: ['agent-referrals'] }); },\n27:   });\n28:   const detail = query.data;\n29:   return (\n30:     <Screen refreshControl={<RefreshControl refreshing={query.isRefetching} onRefresh={() => void query.refetch()} tintColor={Colors.teal} />}>\n31:       <PageHeading eyebrow=\"Referral details\" title={detail?.patient_name ?? 'Patient referral'} subtitle={detail ? `${detail.reference} · ${detail.patient_phone_e164_masked}` : 'Loading referral activity…'} />\n32:       {query.isLoading ? <ActivityIndicator color={Colors.teal} /> : null}\n33:       {query.isError ? <InlineNotice tone=\"error\">{getErrorMessage(query.error, 'Could not load this referral.')}</InlineNotice> : null}\n34:       {detail ? <>\n35:         <Card>\n36:           <View style={styles.row}><Text style={styles.label}>Current status</Text><StatusBadge status={detail.status} /></View>\n37:           <View style={styles.row}><Text style={styles.label}>Service</Text><Text style={styles.value}>{detail.service || 'Not specified'}</Text></View>\n38:           <View style={styles.row}><Text style={styles.label}>Agent note</Text><Text style={styles.value}>{detail.agent_note || '—'}</Text></View>\n39:         </Card>\n40:         {!['converted', 'closed', 'not_converted'].includes(detail.status) ? <Card>\n41:           <Text style={styles.section}>Update referral</Text>\n42:           {detail.status === 'new' ? <Button variant=\"secondary\" onPress={() => update.mutate('contacted')} loading={update.isPending}>Mark as contacted</Button> : null}\n43:           {['new', 'contacted'].includes(detail.status) ? <Button variant=\"secondary\" onPress={() => update.mutate('in_progress')} loading={update.isPending}>Mark in progress</Button> : null}\n44:           <Button variant=\"quiet\" onPress={() => update.mutate('not_converted')} loading={update.isPending}>Close as not converted</Button>\n45:           {update.isError ? <InlineNotice tone=\"error\">{getErrorMessage(update.error, 'Could not update the referral.')}</InlineNotice> : null}\n46:         </Card> : null}\n47:         <Card><Text style={styles.section}>Referral timeline</Text>\n48:           {detail.events.map((event, index) => <View key={`${event.created_at}-${index}`} style={styles.timeline}>\n49:             <Text style={styles.value}>{event.status.replaceAll('_', ' ')}</Text><Text style={styles.muted}>{event.note || 'Status updated'} · {formatDate(event.created_at)}</Text>\n50:           </View>)}\n51:         </Card>\n52:         <Card><View style={styles.row}><Text style={styles.section}>Payment claims</Text><Button variant=\"quiet\" onPress={() => router.push('/add-payment')}>Add</Button></View>\n53:           {detail.payment_claims.length === 0 ? <Text style={styles.muted}>No collected payment has been submitted for this referral.</Text> : detail.payment_claims.map((payment) => (\n54:             <View key={payment.id} style={styles.timeline}><Text style={styles.value}>{payment.reference} · ₹{(payment.claimed_amount_paise / 100).toLocaleString('en-IN', { maximumFractionDigits: 2 })}</Text>\n55:               <Text style={styles.muted}>{payment.status.replaceAll('_', ' ')} · {formatDate(payment.created_at)}</Text>\n56:               <Button variant=\"quiet\" onPress={() => router.push({ pathname: '/payment-claim/[id]', params: { id: payment.id } })}>View claim</Button>\n57:             </View>\n58:           ))}\n59:         </Card>\n60:       </> : null}\n61:       <Button variant=\"quiet\" onPress={() => router.back()}>Back</Button>\n62:     </Screen>\n63:   );\n64: }\n65: \n66: const styles = StyleSheet.create({\n67:   row: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', gap: Space.md },\n68:   label: { color: Colors.inkMuted, fontSize: 13 }, value: { color: Colors.ink, fontSize: 14, 