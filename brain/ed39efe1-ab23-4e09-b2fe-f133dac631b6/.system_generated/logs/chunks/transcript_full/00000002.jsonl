{"step_index":143,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-17T06:53:17Z","content":"Created At: 2026-11-17T12:23:17+05:30\nCompleted At: 2026-11-17T12:23:17+05:30\nCreated At: 2026-11-17T12:23:17+05:30\nCompleted At: 2026-11-17T12:23:17+05:30\nShowing lines 1-93 of 93\n1: import * as DocumentPicker from 'expo-document-picker';\n2: import { router, useLocalSearchParams } from 'expo-router';\n3: import { useState } from 'react';\n4: import { ActivityIndicator, RefreshControl, StyleSheet, Text, View } from 'react-native';\n5: import { Button, InlineNotice } from '@/components/Button';\n6: import { FormField } from '@/components/FormField';\n7: import { Card, PageHeading, Screen } from '@/components/Screen';\n8: import { Colors, Space } from '@/constants/theme';\n9: import { usePaymentClaim, useUploadPaymentEvidence } from '@/features/payments/hooks';\n10: import { api } from '@/lib/api';\n11: import { formatDate } from '@/lib/format';\n12: import { getErrorMessage } from '@/lib/errors';\n13: \n14: export default function PaymentClaimScreen() {\n15:   const params = useLocalSearchParams<{ id?: string }>();\n16:   const id = typeof params.id === 'string' ? params.id : '';\n17:   const claim = usePaymentClaim(id);\n18:   const upload = useUploadPaymentEvidence(id);\n19:   const [response, setResponse] = useState('');\n20:   const [notice, setNotice] = useState('');\n21:   const [error, setError] = useState('');\n22:   const [sending, setSending] = useState(false);\n23: \n24:   async function pickReceipt() {\n25:     setError(''); setNotice('');\n26:     const result = await DocumentPicker.getDocumentAsync({ type: ['image/jpeg', 'image/png', 'application/pdf'], multiple: false, copyToCacheDirectory: true });\n27:     if (result.canceled) return;\n28:     const asset = result.assets[0];\n29:     if (!asset) return;\n30:     if (asset.size && asset.size > 8 * 1024 * 1024) { setError('Receipt must be no larger than 8 MB.'); return; }\n31:     try { await upload.mutateAsync(asset); setNotice('Receipt uploaded securely. Finance review can now inspect the claim.'); }\n32:     catch (caught) { setError(getErrorMessage(caught, 'The receipt could not be uploaded.')); }\n33:   }\n34: \n35:   async function sendAdditionalInfo() {\n36:     setError(''); setNotice('');\n37:     if (response.trim().length < 3) { setError('Enter a short response before resubmitting.'); return; }\n38:     setSending(true);\n39:     try { await api.post(`/agent/payments/claims/${id}/respond`, { message: response.trim() }); setResponse(''); setNotice('Your response was submitted for review.'); await claim.refetch(); }\n40:     catch (caught) { setError(getErrorMessage(caught, 'Your response could not be sent.')); }\n41:     finally { setSending(false); }\n42:   }\n43: \n44:   return (\n45:     <Screen refreshControl={<RefreshControl refreshing={claim.isRefetching} onRefresh={() => void claim.refetch()} tintColor={Colors.teal} />}>\n46:       <PageHeading eyebrow=\"Payment claim\" title={claim.data?.reference ?? 'Claim details'} subtitle=\"Review status, attach receipts, and respond to a reviewer if they need more information.\" />\n47:       {claim.isLoading ? <ActivityIndicator color={Colors.teal} /> : null}\n48:       {claim.isError ? <InlineNotice tone=\"error\">{getErrorMessage(claim.error, 'Could not load this payment claim.')}</InlineNotice> : null}\n49:       {claim.data ? <>\n50:         <Card>\n51:           <View style={styles.row}><Text style={styles.label}>Status</Text><Text style={styles.status}>{claim.data.status.replaceAll('_', ' ')}</Text></View>\n52:           <View style={styles.row}><Text style={styles.label}>Invoice</Text><Text style={styles.value}>{claim.data.invoice_number ?? '—'}</Text></View>\n53:           <View style={styles.row}><Text style={styles.label}>Invoice total</Text><Text style={styles.value}>{money(claim.data.invoice_amount_paise)}</Text></View>\n54:           <View style={styles.row}><Text style={styles.label}>Claimed now</Text><Text style={styles.amount}>{money(claim.data.claimed_amount_paise)}</Text></View>\n55:           <View style={styles.row}><Text style={styles.label}>Approved</Text><Text style={styles.value}>{money(claim.data.approved_amount_paise)}</Text></View>\n56:           <View style={styles.row}><Text style={styles.label}>Payment date</Text><Text style={styles.value}>{formatDate(claim.data.payment_date)}</Text></View>\n57:           {claim.data.review_reason ? <InlineNotice tone={claim.data.status === 'rejected' ? 'error' : 'info'}>{claim.data.review_reason}</InlineNotice> : null}\n58:         </Card>\n59:         {['submitted', 'needs_information', 'resubmitted'].includes(claim.data.status) ? <Card>\n60:           <Text style={styles.section}>Payment receipt</Text>\n61:           <Text style={styles.muted}>JPG, PNG or PDF · up to 8 MB. Files are private and only available to you and authorized reviewers.</Text>\n62:           <Button variant=\"secondary\" onPress={pickReceipt} loading={upload.isPending}>Choose receipt</Button>\n63:           {(claim.data.evidence ?? []).map((item) => <Text key={item.id} style={styles.muted}>✓ {item.name} · {(item.size_bytes / 1024).toFixed(0)} KB</Text>)}\n64:         </Card> : null}\n65:         {claim.data.status === 'needs_information' ? <Card>\n66:           <Text style={styles.section}>Respond to reviewer</Text>\n67:           <FormField label=\"Additional information\" value={response} onChangeText={setResponse} placeholder=\"Answer the request from the reviewer\" multiline maxLength={500} />\n68:           <Button onPress={sendAdditionalInfo} loading={sending}>Send response</Button>\n69:         </Card> : null}\n70:         <Card><Text style={styles.section}>Review history</Text>\n71:           {(claim.data.decisions ?? []).length === 0 ? <Text style={styles.muted}>No reviewer decision has been recorded yet.</Text> : (claim.data.decisions ?? []).map((item, index) => (\n72:             <View key={`${item.created_at}-${index}`} style={styles.timeline}>\n73:               <Text style={styles.value}>{item.decision.replaceAll('_', ' ')}</Text>\n74:               <Text style={styles.muted}>{item.reason || 'No reason provided'} · {formatDate(item.created_at)}</Text>\n75:             </View>\n76:           ))}\n77:         </Card>\n78:       </> : null}\n79:       {notice ? <InlineNotice tone=\"success\">{notice}</InlineNotice> : null}\n80:       {error ? <InlineNotice tone=\"error\">{error}</InlineNotice> : null}\n81:       <Button variant=\"quiet\" onPress={() => router.back()}>Back to payment claims</Button>\n82:     </Screen>\n83:   );\n84: }\n85: \n86: function money(paise: number | null) { return paise === null ? '—' : `₹${(paise / 100).toLocaleString('en-IN', { maximumFractionDigits: 2 })}`; }\n87: const styles = StyleSheet.create({\n88:   row: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-start', gap: Space.md },\n89:   label: { color: Colors.inkMuted, fontSize: 13 }, value: { color: Colors.ink, fontSize: 14, fontWeight: '700', textAlign: 'right', flex: 1 },\n90:   amount: { color: Colors.teal, fontSize: 18, fontWeight: '900' }, status: { color: Colors.amber, fontSize: 12, fontWeight: '900', textTransform: 'uppercase' },\n91:   section: { color: Colors.ink, fontSize: 16, fontWeight: '800' }, muted: { color: Colors.inkMuted, fontSize: 13, lineHeight: 19 },\n92:   timeline: { borderLeftWidth: 2, borderLeftColor: Colors.line, paddingLeft: Space.md, gap: Space.xs },\n93: });"}
