 flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginTop: Space.sm },\n44:   sectionTitle: { color: Colors.ink, fontSize: 18, fontWeight: '800' }, count: { color: Colors.inkMuted, fontSize: 12, fontWeight: '700' },\n45:   ledgerCard: { padding: Space.lg }, ledgerTop: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', gap: Space.md },\n46:   entryType: { color: Colors.ink, fontWeight: '800', fontSize: 14 }, amount: { color: Colors.teal, fontSize: 14, fontWeight: '900' },\n47:   negative: { color: Colors.red }, muted: { color: Colors.inkMuted, fontSize: 13, lineHeight: 19 },\n48:   emptyTitle: { color: Colors.ink, fontWeight: '800', fontSize: 16 }, footer: { textAlign: 'center', color: Colors.inkMuted, fontSize: 11, lineHeight: 16, marginTop: Space.sm },\n49: });"}
