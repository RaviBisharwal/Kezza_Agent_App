;\n31:   const [collected, setCollected] = useState('');\n32:   const [paymentDate, setPaymentDate] = useState(new Date().toISOString().slice(0, 10));\n33:   const [method, setMethod] = useState<(typeof methods)[number]['value']>('upi');\n34:   const [transaction, setTransaction] = useState('');\n35:   const [error, setError] = useState('');\n36: \n37:   async function submit() {\n38:     setError('');\n39:     if (!referralId) { setError('Choose the patient referral linked to this invoice.'); return; }\n40:     if (!profile.data?.branch_id) { setError('Your branch assignment is unavailable. Contact Kezza operations.'); return; }\n41:     const total = paise(invoiceAmount);\n42:     const current = paise(collected);\n43:     if (!invoice.trim()) { setError('Enter the invoice number.'); return; }\n44:     if (total === null || current === null) { setError('Enter positive rupee amounts, up to two decimal places.'); return; }\n45:     if (current > total) { setError('Collected amount cannot be greater than the invoice total.'); return; }\n46:     if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(paymentDate)) { setError('Enter the payment date as YYYY-MM-DD.'); return; }\n47:     try {\n48:       const payment = await createPayment.mutateAsync({\n49:         referral_id: referralId, branch_id: profile.data.branch_id, invoice_number: invoice.trim(),\n50:         invoice_amount_paise: total, claimed_amount_paise: current,\n51:         payment_date: new Date(`${paymentDate}T12:00:00+05:30`).toISOString(), payment_method: method,\n52:         ...(transaction.trim() ? { transaction_reference: transaction.trim() } : {}), idempotency_key: makeKey(),\n53:       });\n54:       router.replace({ pathname: '/payment-claim/[id]', params: { id: payment.id } });\n55:     } catch (caught) { setError(getErrorMessage(caught, 'The payment claim could not be saved.')); }\n56:   }\n57: \n58:   const availableReferrals = (referrals.data ?? []).filter((item) => !['closed', 'not_converted'].includes(item.status));\n59:   return (\n60:     <Screen>\n61:       <PageHeading eyebrow=\"Collected sale\" title=\"Record a payment\" subtitle=\"Enter the collected amount against the original invoice. For a later partial collection, use the same invoice number and total.\" />\n62:       <Card>\n63:         <View style={styles.fieldGroup}>\n64:           <Text style={styles.label}>Patient referral</Text>\n65:           {referrals.isLoading ? <Text style={styles.muted}>Loading referrals…</Text> : availableReferrals.length === 0 ? <InlineNotice tone=\"info\">Add a patient referral before recording a payment.</InlineNotice> : availableReferrals.map((item) => (\n66:             <Pressable key={item.id} onPress={() => setReferralId(item.id)} style={[styles.referral, referralId === item.id && styles.selected]}>\n67:               <Text style={styles.referralName}>{item.patient_name}</Text><Text style={styles.muted}>{item.reference} · {item.patient_phone_e164_masked} · {item.branch}</Text>\n68:             </Pressable>\n69:           ))}\n70:         </View>\n71:         <FormField label=\"Invoice number\" value={invoice} onChangeText={setInvoice} placeholder=\"Enter invoice number\" autoCapitalize=\"characters\" maxLength={100} />\n72:         <FormField label=\"Total invoice amount (₹)\" value={invoiceAmount} onChangeText={setInvoiceAmount} placeholder=\"1000.00\" keyboardType=\"decimal-pad\" maxLength={12} />\n73:         <FormField label=\"Amount collected now (₹)\" value={collected} onChangeText={setCollected} placeholder=\"500.00\" keyboardType=\"decimal-pad\" maxLength={12} />\n74:         <FormField label=\"Collection date (YYYY-MM-DD)\" value={paymentDate} onChangeText={setPaymentDate} placeholder=\"2026-11-17\" maxLength={10} />\n75:         <View style={styles.fieldGroup}><Text style={styles.label}>Payment method</Text><View style={styles.options}>{methods.map((item) => <Pressable key={item.value} onPress={() => setMethod(item.value)} style={[styles.option, method === item.value && styles.optionSelected]}><Text style={[styles.optionText, method === item.value && styles.optionTextSelected]}>{item.label}</Text></Pressable>)}</View></View>\n76:         <FormField label=\"Transaction reference (optional)\" value={transaction} onChangeText={setTransaction} placeholder=\"UPI / receipt reference\" maxLength={120} />\n77:         {error ? <InlineNotice tone=\"error\">{error}</InlineNotice> : null}\n78:         <InlineNotice tone=\"info\">Attach the Kezza receipt on the next screen. Finance review is required before points are added.</InlineNotice>\n79:         <Button onPress={submit} loading={createPayment.isPending} disabled={availableReferrals.length === 0}>Continue to receipt</Button>\n80:         <Button variant=\"quiet\" onPress={() => router.back()}>Cancel</Button>\n81:       </Card>\n82:     </Screen>\n83:   );\n84: }\n85: \n86: const styles = StyleSheet.create({ fieldGroup: { gap: Space.sm }, label: { color: Colors.ink, fontSize: 13, fontWeight: '700' },\n87:   referral: { padding: Space.md, borderRadius: 13, borderWidth: 1, borderColor: Colors.line, backgroundColor: Colors.white, gap: 3 },\n88:   selected: { borderColor: Colors.teal, backgroundColor: Colors.softTeal }, referralName: { color: Colors.ink, fontSize: 14, fontWeight: '800' },\n89:   muted: { color: Colors.inkMuted, fontSize: 12, lineHeight: 18 }, options: { flexDirection: 'row', flexWrap: 'wrap', gap: Space.sm },\n90:   option: { borderWidth: 1, borderColor: Colors.line, borderRadius: 16, paddingHorizontal: 12, paddingVertical: 9, backgroundColor: Colors.white },\n91:   optionSelected: { backgroundColor: Colors.softTeal, borderColor: Colors.teal }, optionText: { color: Colors.inkMuted, fontSize: 12, fontWeight: '700' },\n92:   optionTextSelected: { color: Colors.tealDark },\n93: });"}
