 default function PaymentsScreen() {\n  const payments = usePaymentClaims();\n  return (\n    <Screen refreshControl={<RefreshControl refreshing={payments.isRefetching} onRefresh={() => void payments.refetch()} tintColor={Colors.teal} />}>\n      <PageHeading eyebrow=\"Collected sale review\" title=\"Payment claims\" subtitle=\"Submit the collected amount and receipt. Points are posted only after finance review.\" />\n      <Button onPress={() => router.push('/add-payment')}>＋  Record a collected payment</Button>\n      {payments.isError ? <InlineNotice tone=\"error\">{getErrorMessage(payments.error, 'Could not load your payment claims.')}</InlineNotice> : null}\n      {payments.isLoading ? <Card><Text style={styles.muted}>Loading payment claims…</Text></Card> : (payments.data ?? []).length === 0 ? (\n        <Card><Text style={styles.emptyTitle}>No payments submitted</Text><Text style={styles.muted}>A claim begins when you record an amount collected against a patient referral and add its receipt.</Text></Card>\n      ) : (payments.data ?? []).map((item) => (\n        <Pressable key={item.id} onPress={() => router.push({ pathname: '/payment-claim/[id]', params: { id: item.id } })}>\n          <Card style={styles.card}>\n            <View style={styles.top}><Text style={styles.ref}>{item.reference}</Text><Status status={item.status} /></View>\n            <Text style={styles.amount}>₹{(item.claimed_amount_paise / 100).toLocaleString('en-IN', { maximumFractionDigits: 2 })}</Text>\n            <Text style={styles.muted}>Invoice {item.invoice_number || '—'} · {formatDate(item.payment_date)}</Text>\n            {item.review_reason ? <Text style={styles.reason}>{item.review_reason}</Text> : null}\n            <Text style={styles.action}>Open claim →</Text>\n          </Card>\n        </Pressable>\n      ))}\n    </Screen>\n  );\n}\n\nfunction Status({ status }: { status: string }) {\n  const color = status === 'approved' ? Colors.green : status === 'rejected' || status ==