{"step_index":135,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-17T06:52:46Z","content":"Created At: 2026-11-17T12:22:46+05:30\nCompleted At: 2026-11-17T12:22:46+05:30\nCreated At: 2026-11-17T12:22:46+05:30\nCompleted At: 2026-11-17T12:22:46+05:30\nCommand exited with code 0.\n\nCommand output:\nimport { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';\r\nimport { Platform } from 'react-native';\r\nimport { api } from '@/lib/api';\r\n\r\nexport type PaymentClaim = {\r\n  id: string;\r\n  reference: string;\r\n  referral_id: string;\r\n  sale_id: string;\r\n  invoice_number: string | null;\r\n  invoice_amount_paise: number | null;\r\n  claimed_amount_paise: number;\r\n  approved_amount_paise: number | null;\r\n  payment_date: string;\r\n  payment_method: string;\r\n  transaction_reference: string | null;\r\n  status: string;\r\n  review_reason: string | null;\r\n  created_at: string;\r\n  evidence?: { id: string; name: string; content_type: string; size_bytes: number; created_at: string }[];\r\n  decisions?: { decision: string; reason: string | null; approved_amount_paise: number | null; created_at: string }[];\r\n};\r\n\r\nexport type CreatePaymentClaim = {\r\n  referral_id: string;\r\n  branch_id: string;\r\n  service_id?: string;\r\n  invoice_number: string;\r\n  invoice_amount_paise: number;\r\n  claimed_amount_paise: number;\r\n  payment_date: string;\r\n  payment_method: 'cash' | 'card' | 'upi' | 'bank_transfer' | 'payment_link' | 'other';\r\n  transaction_reference?: string;\r\n  agent_notes?: string;\r\n  idempotency_key: string;\r\n};\r\n\r\nexport function usePaymentClaims() {\r\n  return useQuery({ queryKey: ['agent-payment-claims'], queryFn: async () => (await api.get<PaymentClaim[]>('/agent/payments/claims')).data });\r\n}\r\n\r\nexport function usePaymentClaim(id: string) {\r\n  return useQuery({ queryKey: ['agent-payment-claim', id], queryFn: async () => (await api.get<PaymentClaim>(`/agent/payments/claims/${id}`)).data, enabled: Boolean(id) });\r\n}\r\n\r\nexport function useCreatePaymentClaim() {\r\n  const client = useQueryClient();\r\n  return useMutation({\r\n    mutationFn: async (payload: CreatePaymentClaim) => (await api.post<PaymentClaim>('/agent/payments/claims', payload)).data,\r\n    onSuccess: () => { void client.invalidateQueries({ queryKey: ['agent-payment-claims'] }); void client.invalidateQueries({ queryKey: ['agent-dashboard'] }); },\r\n  });\r\n}\r\n\r\nexport function useUploadPaymentEvidence(paymentId: string) {\r\n  const client = useQueryClient();\r\n  return useMutation({\r\n    mutationFn: async (asset: { uri: string; name: string; mimeType?: string | null; file?: File }) => {\r\n      const body = new FormData();\r\n      if (Platform.OS === 'web' && asset.file) body.append('file', asset.file, asset.name);\r\n      else body.append('file', { uri: asset.uri, name: asset.name, type: asset.mimeType ?? 'application/octet-stream' } as unknown as Blob);\r\n      return (await api.post(`/agent/payments/claims/${paymentId}/evidence`, body, { headers: { 'Content-Type': 'multipart/form-data' } })).data;\r\n    },\r\n    onSuccess: () => { void client.invalidateQueries({ queryKey: ['agent-payment-claim', paymentId] }); },\r\n  });\r\n}\r\n"}
