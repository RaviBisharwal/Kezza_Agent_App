});\n39:     }, 1000);\n40:   }, []);\n41: \n42:   useEffect(() => {\n43:     // Start initial cooldown so user can't immediately resend\n44:     startCooldown();\n45:     return () => { if (timerRef.current) clearInterval(timerRef.current); };\n46:   }, [startCooldown]);\n47: \n48:   const submit = useCallback(async (otp: string) => {\n49:     setError('');\n50:     if (!/^\\d{6}$/.test(otp)) { setError('Enter the six-digit code.'); return; }\n51:     try {\n52:       const result = await verifyOtp.mutateAsync({ phone_e164: phone, otp_code: otp });\n53:       if (result.status === 'needs_activation') {\n54:         router.replace({ pathname: '/(auth)/register', params: { phone, verificationToken: result.phone_verification_token ?? '' } });\n55:         return;\n56:       }\n57:       const user = result.user;\n58:       if (user?.role !== 'agent' || !user.agent_id || !result.access_token) {\n59:         setError('This mobile number is not linked to an active agent account. Please use an agent number or contact Kezza support.');\n60:         return;\n61:       }\n62:       await useAuthStore.getState().signIn(result.access_token, {\n63:         id: user.id, fullName: user.full_name, phone: user.phone_e164 ?? phone,\n64:         role: user.role, agentId: user.agent_id,\n65:         agentCode: user.agent_code ?? undefined, branchId: user.branch_id ?? undefined,\n66:       }, result.refresh_token);\n67:       router.replace('/(tabs)');\n68:     } catch (caught) { setError(getErrorMessage(caught, 'That code could not be verified.')); }\n69:   }, [phone, verifyOtp]);\n70: \n71:   function handleCodeChange(value: string) {\n72:     const digits = value.replace(/\\D/g, '').slice(0, 6);\n73:     setCode(digits);\n74:     if (digits.length === 6) {\n75:       // Auto-submit when 6th digit entered\n76:       void submit(digits);\n77:     }\n78:   }\n79: \n80:   async function resend() {\n81:     if (cooldown > 0 || requestOtp.isPending) return;\n82:     setError('');\n83:     setCode('');\n84:     try {\n85:       await requestOtp.mutateAsync(toE164(phone.replace(/^\\+91/, '')));\n86:       startCooldown();\n87:     } catch (caught) {\n88:       setError(getErrorMessage(caught, 'Could not resend the verification code.'));\n89:     }\n90:   }\n91: \n92:   return (\n93:     <Screen>\n94:       <PageHeading eyebrow=\"Step 2 of 2\" title=\"Verify your number\" subtitle={`Enter the six-digit code sent to ${phone || 'your mobile number'}.`} />\n95: \n96:       {devCode ? (\n97:         <View style={styles.devBanner}>\n98:           <Text style={styles.devLabel}>Dev OTP</Text>\n99:           <Text style={styles.devCode}>{devCode}</Text>\n100:         </View>\n101:       ) : null}\n102: \n103:       <Card>\n104:         <FormField\n105:           label=\"Verification code\"\n106:           value={code}\n107:           onChangeText={handleCodeChange}\n108:           placeholder=\"123456\"\n109:           keyboardType=\"number-pad\"\n110:           maxLength={6}\n111:         />\n112:         {error ? <InlineNotice tone=\"error\">{error}</InlineNotice> : null}\n113:         <Button onPress={() => submit(code)} loading={verifyOtp.isPending}>\n114:           Verify and sign in\n115:         </Button>\n116:         <View style={styles.resendRow}>\n117:           {cooldown > 0 ? (\n118:             <Text style={styles.cooldownText}>Resend in {cooldown}s</Text>\n119:           ) : (\n120:             <Button variant=\"quiet\" onPress={resend} loading={requestOtp.isPending}>\n121:               Resend code\n122:             </Button>\n123:           )}\n124:         </View>\n125:         <Button variant=\"quiet\" onPress={() => router.back()}>Change mobile number</Button>\n126:       </Card>\n127: \n128:       <Text style={styles.security}>Your account is checked by the Kezza API before access is granted.</Text>\n129:     </Screen>\n130:   );\n131: }\n132: \n133: const styles = StyleSheet.create({\n134:   devBanner: {\n135:     backgroundColor: Colors.canvas,\n136:     borderRadius: 10,\n137:     padding: Space.md,\n138:     marginBottom: Space.md,\n139:     flexDirection: 'row',\n140:     alignItems: 'center',\n141:     gap: Space.sm,\n142:     borderWidth: 1,\n143:     borderColor: Colors.line,\n144:   },\n145:   devLabel: { fontSize: 12, fontWeight: '700', color: Colors.inkMuted, textTransform: 'uppercase', letterSpacing: 0.5 },\n146:   devCode: { fontSize: 20, fontWeight: '900', color: Colors.ink, letterSpacing: 4, fontVariant: ['tabular-nums'] },\n147:   resendRow: { alignItems: 'center', marginTop: Space.xs },\n148:   cooldownText: { fontSize: 13, color: Colors.inkMuted, textAlign: 'center', paddingVertical: Space.md },\n149:   security: { color: Colors.inkMuted, fontSize: 12, lineHeight: 18, textAlign: 'center', marginTop: 'auto', paddingTop: 24 },\n150: });"}
