{"step_index":177,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-17T06:55:41Z","content":"Created At: 2026-11-17T12:25:41+05:30\nCompleted At: 2026-11-17T12:25:41+05:30\nCreated At: 2026-11-17T12:25:41+05:30\nCompleted At: 2026-11-17T12:25:41+05:30\nShowing lines 1-35 of 35\n1: \"\"\"Create the first OTP-authenticated super-admin in an empty rewards database.\"\"\"\n2: import re\n3: \n4: from sqlalchemy import func, select, text\n5: \n6: from app.database import SessionLocal, engine\n7: from app.models import User\n8: \n9: \n10: def main() -> None:\n11:     with engine.connect() as connection:\n12:         database_name = connection.execute(text(\"select current_database()\")).scalar_one()\n13:     if database_name != \"kezza_rewards_db\":\n14:         raise SystemExit(f\"Refusing to bootstrap {database_name!r}; expected kezza_rewards_db\")\n15: \n16:     with SessionLocal() as db:\n17:         existing = db.scalar(select(func.count()).select_from(User).where(User.role == \"super_admin\")) or 0\n18:         if existing:\n19:             raise SystemExit(\"A super-admin already exists. This one-time bootstrap is disabled.\")\n20:         full_name = input(\"Super-admin full name: \").strip()\n21:         phone = input(\"Super-admin mobile number (+91XXXXXXXXXX): \").strip()\n22:         if len(full_name) < 2 or not re.fullmatch(r\"\\+91[6-9]\\d{9}\", phone):\n23:             raise SystemExit(\"Enter a name and a valid Indian mobile number in +91 format.\")\n24:         conflict = db.scalar(select(User.id).where(User.phone_e164 == phone))\n25:         if conflict:\n26:             raise SystemExit(\"That mobile number already belongs to another account.\")\n27:         user = User(phone_e164=phone, full_name=full_name, role=\"super_admin\", status=\"active\")\n28:         db.add(user)\n29:         db.commit()\n30:         print(f\"Created OTP-only super-admin {user.full_name} ({user.phone_e164[-4:]})\")\n31:         print(\"Sign in with this mobile number. No password or default OTP was created.\")\n32: \n33: \n34: if __name__ == \"__main__\":\n35:     main()"}
