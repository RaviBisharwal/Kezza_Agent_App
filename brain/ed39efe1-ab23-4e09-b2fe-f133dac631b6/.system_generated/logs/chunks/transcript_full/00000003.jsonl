{"step_index":179,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-17T06:55:47Z","content":"Created At: 2026-11-17T12:25:47+05:30\nCompleted At: 2026-11-17T12:25:47+05:30\nCreated At: 2026-11-17T12:25:47+05:30\nCompleted At: 2026-11-17T12:25:47+05:30\nShowing lines 1-46 of 46\n1: from functools import lru_cache\n2: \n3: from pydantic_settings import BaseSettings, SettingsConfigDict\n4: from sqlalchemy.engine import make_url\n5: \n6: \n7: class Settings(BaseSettings):\n8:     model_config = SettingsConfigDict(env_file=\".env\", env_file_encoding=\"utf-8\", extra=\"ignore\")\n9: \n10:     app_env: str = \"development\"\n11:     database_url: str = \"postgresql+psycopg://kezza_rewards_app:replace_me@127.0.0.1:5432/kezza_rewards_db\"\n12:     jwt_secret_key: str = \"dev-only-replace-with-at-least-32-random-characters\"\n13:     jwt_issuer: str = \"kezza-rewards-api\"\n14:     access_token_minutes: int = 15\n15:     refresh_token_days: int = 30\n16:     otp_provider: str = \"mock\"\n17:     otp_ttl_seconds: int = 300\n18:     otp_resend_seconds: int = 60\n19:     otp_max_attempts: int = 5\n20:     google_client_ids: str = \"\"\n21:     cors_origins: str = \"http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081\"\n22:     private_upload_dir: str = \"./private_uploads\"\n23:     max_upload_bytes: int = 8 * 1024 * 1024\n24:     public_base_url: str = \"http://127.0.0.1:8000\"\n25: \n26:     @property\n27:     def allowed_origins(self) -> list[str]:\n28:         return [origin.strip() for origin in self.cors_origins.split(\",\") if origin.strip()]\n29: \n30:     @property\n31:     def allowed_google_audiences(self) -> list[str]:\n32:         return [client_id.strip() for client_id in self.google_client_ids.split(\",\") if client_id.strip()]\n33: \n34: \n35: @lru_cache\n36: def get_settings() -> Settings:\n37:     settings = Settings()\n38:     if settings.app_env != \"development\" and (\n39:         len(settings.jwt_secret_key) < 32\n40:         or settings.jwt_secret_key.startswith(\"dev-only-\")\n41:         or \"replace\" in settings.jwt_secret_key.lower()\n42:     ):\n43:         raise ValueError(\"Set a unique, random JWT_SECRET_KEY of at least 32 characters outside development\")\n44:     if make_url(settings.database_url).database != \"kezza_rewards_db\":\n45:         raise ValueError(\"The rewards API must use the separate kezza_rewards_db database\")\n46:     return settings"}
