const platform = Platform.OS === 'ios' || Platform.OS === 'android' ? Platform.OS : 'web';\n13:   const channel = process.env.EXPO_PUBLIC_RELEASE_CHANNEL ?? 'development';\n14:   const update = useQuery({ queryKey: ['app-release', platform, version, channel], queryFn: async () => (await api.get<{ update_available: boolean; update_required: boolean; latest_version: string | null; minimum_supported_version: string | null; release_notes: string | null; download_url: string | null }>('/public/app-version', { params: { platform, channel, current_version: version } })).data });\n15:   return <Screen>\n16:     <PageHeading eyebrow=\"Kezza Agent\" title=\"About this app\" subtitle=\"A secure workspace for agent referrals, payment review, and rewards.\" />\n17:     <Card>\n18:       <Text style={styles.title}>App version {version}</Text>\n19:       {update.isLoading ? <Text style={styles.body}>Checking version…</Text> : null}\n20:       {update.isError ? <InlineNotice tone=\"info\">{getErrorMessage(update.error, 'Version information is unavailable.')}</InlineNotice> : null}\n21:       {update.data?.update_available ? <InlineNotice tone={update.data.update_required ? 'error' : 'info'}>{update.data.update_required ? 'An update is required.' : 'A newer app version is available.'} {update.data.latest_version ? `Latest: ${update.data.latest_version}.` : ''} {update.data.release_notes ?? ''}</InlineNotice> : null}\n22:       <Text style={styles.body}>Patient records, approvals, and reward points are managed by Kezza’s authorized services. The app does not calculate or edit balances on the device.</Text>\n23:       <Button variant=\"secondary\" onPress={() => void Linking.openURL('https://www.kezza.co.in/')}>Kezza website</Button>\n24:       <Button variant=\"secondary\" onPress={() => void Linking.openURL('https://www.kezza.co.in/review.html')}>Leave a review</Button>\n25:       <Button variant=\"quiet\" onPress={() => void Linking.openURL('https://www.kezza.co.in/terms.html')}>Terms of service</Button>\n26:     </Card>\n27:   </Screen>;\n28: }\n29: const styles = StyleSheet.create({ title: { color: Colors.ink, fontSize: 18, fontWeight: '800' }, body: { color: Colors.inkMuted, fontSize: 13, lineHeight: 20 } });"}
