oid finishLogout()}>Sign out</button></div>\n167:       </header>\n168:       <div className=\"content\">\n169:         {globalError ? <Notice tone=\"error\">{globalError}</Notice> : null}\n170:         {globalMessage ? <Notice tone=\"success\">{globalMessage}</Notice> : null}\n171:         {tab === 'overview' ? <Overview data={data} setTab={setTab} /> : null}\n172:         {tab === 'agents' ? <AgentsPanel data={data} staff={staff} api={api} refresh={refresh} /> : null}\n173:         {tab === 'reviews' ? <ReviewsPanel data={data} api={api} downloadFile={downloadFile} refresh={refresh} /> : null}\n174:         {tab === 'rewards' ? <RewardsPanel data={data} staff={staff} api={api} refresh={refresh} /> : null}\n175:         {tab === 'operations' ? <OperationsPanel data={data} staff={staff} api={api} refresh={refresh} /> : null}\n176:         {tab === 'feedback' ? <FeedbackPanel data={data} api={api} refresh={refresh} /> : null}\n177:         {tab === 'governance' ? <GovernancePanel data={data} staff={staff} api={api} downloadFile={downloadFile} refresh={refresh} /> : null}\n178:       </div>\n179:       <nav className=\"mobile-nav\">{visibleTabs.map((item) => <button key={item.id} onClick={() => setTab(item.id)} className={tab === item.id ? 'active' : ''}>{item.label}</button>)}</nav>\n180:     </main>\n181:   </div>;\n182: }\n183: \n184: function LoginScreen({ booting, onRequestOtp, onVerified }: { booting: boolean; onRequestOtp: (phone: string) => Promise<{ status: string; dev_code?: string }>; onVerified: (session: { access_token: string; user: Staff }) => Promise<void> }) {\n185:   const [phone, setPhone] = useState(''); const [code, setCode] = useState(''); const [devCode, setDevCode] = useState('');\n186:   const [stage, setStage] = useState<'phone' | 'otp'>('phone'); const [busy, setBusy] = useState(false); const [error, setError] = useState('');\n187:   async function request() {\n188:     setError(''); if (!/^\\+91[6-9]\\d{9}$/.test(phone)) { setError('Enter the administrator mobile in +91XXXXXXXXXX format.'); return; }\n189:     setBusy(true); try { const result = await onRequestOtp(phone); setDevCode(result.dev_code ?? ''); setStage('otp'); } catch (caught) { setError(message(caught)); } finally { setBusy(false); }\n190:   }\n191:   async function verify() {\n192:     setError(''); if (!/^\\d{6}$/.test(code)) { setError('Enter the six-digit OTP.'); return; }\n193:     setBusy(true);\n194:     try {\n195:       const session = await requestApi<{ status: string; access_token?: string; user?: Staff }>('/auth/otp/verify', null, () => undefined, { body: { phone_e164: phone, otp_code: code } });\n196:       if (!session.access_token || !session.user) throw new Error('This account is not activated for admin access. Ask a Kezza super-admin to check it.');\n197:       await onVerified({ access_token: session.access_token, user: session.user });\n198:     } catch (caught) { setError(message(caught)); } finally { setBusy(false); }\n199:   }\n200:   return <main className=\"login-wrap\"><section className=\"login-card\">\n201:     <div className=\"brand\"><div className=\"brand-mark\">K</div><div className=\"brand-name\">KEZZA<span className=\"brand-sub\">AGENT OPERATIONS</span></div></div>\n202:     <div className=\"eyebrow\">SECURE ADMINISTRATION</div><h1>{stage === 'phone' ? 'Welcome back' : 'Verify administrator'}</h1>\n203:     <p>{stage === 'phone' ? 'Sign in with your authorized Kezza administrator mobile number. Agent accounts do not have access to this portal.' : `Enter the verification code sent to ${phone}.`}</p>\n204:     {booting ? <Notice tone=\"info\">Checking for an active secure session…</Notice> : null}\n205:     <div className=\"stack\">{stage === 'phone' ? <Field label=\"Mobile number\" value={phone} onChange={setPhone} placeholder=\"+919876543210\" type=\"tel\" /> : <Field label=\"Six-digit OTP\" value={code} onChange={(value) => setCode(value.replace(/\\D/g, '').slice(0, 6))} placeholder=\"000000\" inputMode=\"numeric\" />}\n206:       {devCode ? <Notice tone=\"info\">Local development OTP: <strong>{devCode}</strong>. This code is shown only in development mode.</Notice> : null}\n207:       {error ? <Notice tone=\"error\">{error}</Notice> : null}\n208:       <div className=\"login-actions\">{stage === 'phone' ? <button className=\"button\" disabled={busy || booting} onClick={() => void request()}>{busy ? 'Sending…' : 'Continue with OTP'}</button> : <><button className=\"button\" disabled={busy} onClick={() => void verify()}>{busy ? 'Verifying…' : 'Verify and sign in'}</button><button className=\"button ghost\" onClick={() => { setStage('phone'); setCode(''); setError(''); }}>Use another mobile number</button></>}</div>\n209:     </div>\n210:     <div className=\"login-foot\">OTP authentication · Role checks enforced by FastAPI</div>\n211:   </section></main>;\n212: }\n213: \n214: function Overview({ data, setTab }: { data: Data; setTab: (tab: TabId) => void }) {\n215:   const dashboard = data.dashboard;\n216:   return <>\n217:     <div className=\"page-heading\"><div><div className=\"eyebrow\">OPERATIONS SNAPSHOT</div><h2>Good day, Kezza team</h2><p>Live counts from the rewards database. No demo records are used.</p></div><span className=\"badge active\">Live API data</span></div>\n218:     <div className=\"grid metric-grid\">\n219:       <Metric label=\"Active agents\" value={dashboard?.active_agents ?? '—'} note=\"Invited agents with active accounts\" />\n220:       <Metric label=\"Patient referrals\" value={dashboard?.referrals ?? '—'} note=\"Across your authorized branch scope\" />\n221:       <Metric label=\"Payment reviews\" value={dashboard?.pending_payment_reviews ?? '—'} note=\"Claims awaiting reviewer action\" accent />\n222:       <Metric label=\"Open feedback\" value={dashboard?.open_feedback ?? '—'} note=\"Agent messages to operations\" />\n223:     </div>\n224:     <div className=\"grid two-col\" style={{ marginTop: 17 }}>\n225:       <section className=\"card\"><div className=\"card-head\"><div><h3>Review priorities</h3><p>Actions currently waiting in the API queue</p></div><button className=\"button secondary small\" onClick={() => setTab('reviews')}>Open review queue</button></div>\n226:         <div className=\"stack\"><QueueRow title=\"Collected payment claims\" value={dashboard?.pending_payment_reviews ?? 0} description=\"Confirm evidence and approve, return, or reject.\" />\n227:           <QueueRow title=\"Agent feedback\" value={dashboard?.open_feedback ?? 0} description=\"Assign a response and resolve follow-up.\" />\n228:           <QueueRow title=\"Reward policies\" value={data.policies.filter((item) => item.status === 'draft').length} description=\"Draft policies need an independent super-admin approval.\" />\n229:         </div>\n230:       </section>\n231:       <section className=\"card\"><div className=\"card-head\"><div><h3>Branches</h3><p>Branch catalog currently visible to your account</p></div></div>\n232:         {data.branches.length ? data.branches.map((branch) => <div key={branch.id} className=\"inline\" style={{ justifyContent: 'space-between', borderTop: '1px solid #edf1f0', padding: '11px 0' }}><div><strong>{branch.name}</strong><div className=\"subtle\">{branch.code} · {branch.hours_text}</div></div><span className={`badge ${branch.is_active ? 'active' : ''}`}>{branch.is_active ? 'Active' : 'Inactive'}</span></div>) : <Empty>No branch records returned.</Empty>}\n233:         <div className=\"subtle\" style={{ marginTop: 10 }}>Last loaded: {dashboard?.data_as_of ? new Date(dashboard.data_as_of).toLocaleString('en-IN') : '—'}</div>\n234:       </section>\n235:     </div>\n236:   </>;\n237: }\n238: \n239: function AgentsPanel({ data, staff, api, refresh }: { data: Data; staff: Staff; api: ApiCall; refresh: () => Promise<void> }) {\n240:   const [name, setName] = useState(''); const [phone, setPhone] = useState(''); const [branch, setBranch] = useState('');\n241:   const [invite, setInvite] = useState<{ invite_code: string; agent_code: string; expires_at: string } | null>(null);\n242:   const [role, setRole] = useState<'branch_reviewer' | 'finance_reviewer' | 'operations_admin'>('branch_reviewer'); const [staffEmail, setStaffEmail] = useState('');\n243:   const [busy, setBusy] = useState(false); const [error, setError] = useState(''); const [messageText, setMessageText] = useState('');\n244:   async function createInvite(event: React.FormEvent) {\n245:     event.preventDefault(); setBusy(true); setError(''); setMessageText('');\n246:     try { const result = await api<{ invite_code: string; agent_code: string; expires_at: string }>('/admin/agents/invitations', { body: { full_name: name.trim(), phone_e164: phone, branch_id: branch, expires_in_days: 7 } }); setInvite(result); setMessageText('Invitation created. Copy the one-time code now; it is not shown again.'); setName(''); setPhone(''); await refresh(); }\n247:     catch (caught) { setError(message(caught)); } finally { setBusy(false); }\n248:   }\n249:   async function createStaff(event: React.FormEvent) {\n250:     event.preventDefault(); setBusy(true); setError(''); setMessageText('');\n251:     try { await api('/admin/users', { body: { full_name: name.trim(), phone_e164: phone, role, branch_id: role === 'operations_admin' ? (branch || null) : branch, email: staffEmail || null } }); setMessageText('Administrator account created. Sign-in uses OTP for its mobile number.'); setName(''); setPhone(''); setStaffEmail(''); await refresh(); }\n252:     catch (caught) { setError(message(caught)); } finally { setBusy(false); }\n253:   }\n254:   const branchName = (id: string | null) => data.branches.find((item) => item.id === id)?.name ?? '—';\n255:   return <>\n256:     <PageHeading eyebrow=\"Field team\" title=\"Agents and access\" subtitle=\"Invite agents to activate using OTP, and keep administrator access assigned by role.\" />\n257:     {error ? <Notice tone=\"error\">{error}</Notice> : null}{messageText ? <Notice tone=\"success\">{messageText}</Notice> : null}\n258:     {invite ? <section className=\"card\" style={{ marginBottom: 16 }}><div className=\"card-head\"><div><h3>One-time agent invitation</h3><p>Share this securely with the agent; the API stores only a hash.</p></div></div><div className=\"grid three-col\"><Info label=\"Agent code\" value={invite.agent_code} /><Info label=\"Invitation code\" value={invite.invite_code} /><Info label=\"Expires\" value={new Date(invite.expires_at).toLocaleString('en-IN')} /></div><div className=\"form-actions\"><button className=\"button secondary\" onClick={() => void navigator.clipboard.writeText(invite.invite_code)}>Copy invitation code</button><button className=\"button ghost\" onClick={() => setInvite(null)}>Hide code</button></div></section> : null}\n259:     <div className=\"grid two-col\">\n260:       <section className=\"card\"><div className=\"card-head\"><div><h3>Invite an agent</h3><p>Only the assigned branch can be selected for a branch-scoped administrator.</p></div></div>\n261:         <form onSubmit={(event) => void createInvite(event)} className=\"form-grid\"><Field label=\"Agent full name\" value={name} onChange={setName} placeholder=\"Full name\" required /><Field label=\"Mobile number\" value={phone} onChange={setPhone} placeholder=\"+919876543210\" type=\"tel\" required /><Select label=\"Branch\" value={branch} onChange={setBranch} options={data.branches.filter((item) => item.is_active).map((item) => [item.id, item.name])} required /><Field label=\"Invitation validity\" value=\"7 days\" onChange={() => undefined} disabled /><div className=\"form-actions field full\"><button className=\"button\" disabled={busy || !branch}>{busy ? 'Creating…' : 'Create agent invitation'}</button></div></form>\n262:       </section>\n263:       {staff.role === 'super_admin' ? <section className=\"card\"><div className=\"card-head\"><div><h3>Create an administrator</h3><p>Role and branch scope control every API request.</p></div></div>\n264:         <form onSubmit={(event) => void createStaff(event)} className=\"form-grid\"><Field label=\"Full name\" value={name} onChange={setName} placeholder=\"Full name\" required /><Field label=\"Mobile number\" value={phone} onChange={setPhone} placeholder=\"+919876543210\" type=\"tel\" required /><Select label=\"Role\" value={role} onChange={(value) => setRole(value as typeof role)} options={[[\"branch_reviewer\", \"Branch reviewer\"], [\"finance_reviewer\", \"Finance reviewer\"], [\"operations_admin\", \"Operations admin\"]]} /><Select label=\"Branch\" value={branch} onChange={setBranch} options={[[\"\", role === 'operations_admin' ? 'Global access' : 'Select a branch'], ...data.branches.filter((item) => item.is_active).map((item) => [item.id, item.name])]} /><Field label=\"Email (optional)\" value={staffEmail} onChange={setStaffEmail} placeholder=\"name@example.com\" type=\"email\" /><div className=\"form-actions field full\"><button className=\"button\" disabled={busy || (role !== 'operations_admin' && !branch)}>{busy ? 'Creating…' : 'Create administrator'}</button></div></form>\n265:       </section> : <section className=\"card\"><div className=\"card-head\"><div><h3>Role access</h3><p>Only a super-admin can create administrator accounts.</p></div></div><div className=\"subtle\">Branch reviewers can request information or reject. Finance reviewers make final payment approvals. Operations admins manage operational setup. Super-admins manage system access and approve policy.</div></section>}\n266:     </div>\n267:     <section className=\"card\" style={{ marginTop: 16 }}><div className=\"card-head\"><div><h3>Agent directory</h3><p>Mobile numbers are masked in this list.</p></div><span className=\"badge\">{data.agents.length} records</span></div>\n268:       {data.agents.length ? <div className=\"table-wrap\"><table><thead><tr><th>Agent</th><th>Agent code</th><th>Branch</th><th>Status</th><th>Created</th></tr></thead><tbody>{data.agents.map((agent) => <tr key={agent.id}><td><strong>{agent.full_name}</strong><div className=\"subtle\">{agent.phone_e164_masked}</div></td><td>{agent.agent_code ?? '—'}</td><td>{branchName(agent.branch_id)}</td><td><Badge value={agent.status} /></td><td>{date(agent.created_at)}</td></tr>)}</tbody></table></div> : <Empty>No agents are registered in this database yet.</Empty>}\n269:     </section>\n270:   </>;\n271: }\n272: \n273: function ReviewsPanel({ data, api, downloadFile, refresh }: { data: Data; api: ApiCall; downloadFile: (path: string, filename: string) => Promise<void>; refresh: () => Promise<void> }) {\n274:   const [selected, setSelected] = useState(''); const [decision, setDecision] = useState<'approve' | 'request_information' | 'reject' | 'reverse'>('approve');\n275:   const [reason, setReason] = useState(''); const [amount, setAmount] = useState(''); const [busy, setBusy] = useState(false); const [error, setError] = useState(''); const [success, setSuccess] = useState('');\n276:   const claim = data.reviews.find((item) => item.id === selected) ?? null;\n277:   async function submit(event: React.FormEvent) {\n278:     event.preventDefault(); if (!claim) return; setError(''); setSuccess(''); setBusy(true);\n279:     try { await api(`/admin/payment-reviews/${claim.id}/decision`, { body: { decision, ...(decision === 'approve' && amount ? { approved_amount_paise: Math.round(Number(amount) * 100) } : {}), reason, idempotency_key: idempotencyKey() } }); setSuccess(`Claim ${claim.reference}: ${title(decision)} recorded.`); setReason(''); setAmount(''); setSelected(''); await refresh(); }\n280:     catch (caught) { setError(message(caught)); } finally { setBusy(false); }\n281:   }\n282:   return <>\n283:     <PageHeading eyebrow=\"Maker and reviewer controls\" title=\"Payment review queue\" subtitle=\"Review receipts and invoice totals before posting rewards. Agent-submitted amounts never update a wallet by themselves.\" />\n284:     {error ? <Notice tone=\"error\">{error}</Notice> : null}{success ? <Notice tone=\"success\">{success}</Notice> : null}\n285:     <section className=\"card\"><div className=\"card-head\"><div><h3>Claims awaiting a decision</h3><p>Finance reviewers approve. A different user cannot approve their own claim.</p></div><span className=\"badge\">{data.reviews.length} pending</span></div>\n286:       {data.reviews.length ? <div className=\"table-wrap\"><table><thead><tr><th>Claim</th><th>Agent</th><th>Invoice</th><th>Claimed</th><th>Date</th><th>Status</th><th>Evidence</th><th></th></tr></thead><tbody>{data.reviews.map((item) => <tr key={item.id} style={{ background: selected === item.id ? '#f4faf8' : undefined }}>\n287:         <td><strong>{item.reference}</strong><div className=\"subtle\">{item.referral_reference ?? 'Referral'}</div></td><td>{item.agent?.name ?? '—'}<div className=\"subtle\">{item.agent?.phone_e164_masked}</div></td><td>{item.sale?.invoice_number ?? '—'}<div className=\"subtle\">Total {money(item.sale?.invoice_amount_paise)}</div></td><td><strong>{money(item.claimed_amount_paise)}</strong></td><td>{date(item.payment_date)}</td><td><Badge value={item.status} /></td><td>{item.evidence.length ? <div className=\"stack\">{item.evidence.map((file) => <button key={file.id} className=\"button ghost small\" onClick={() => void downloadFile(`/agent/payments/evidence/${file.id}`, file.name)}>{file.name}</button>)}</div> : <span className=\"badge rejected\">Receipt required</span>}</td><td><button className=\"button secondary small\" onClick={() => setSelected(selected === item.id ? '' : item.id)}>{selected === item.id ? 'Close' : 'Review'}</button></td>\n288:       </tr>)}</tbody></table></div> : <Empty>No payment claims are waiting for review.</Empty>}\n289:     </section>\n290:     {claim ? <section className=\"card\" style={{ marginTop: 16 }}><div className=\"card-head\"><div><h3>Review {claim.reference}</h3><p>Read the uploaded receipt, confirm invoice balance, and record a reason for every decision.</p></div><Badge value={claim.status} /></div>\n291:       <div className=\"grid three-col\"><Info label=\"Agent\" value={claim.agent?.name ?? '—'} /><Info label=\"Invoice\" value={claim.sale?.invoice_number ?? '—'} /><Info label=\"Collected amount\" value={money(claim.claimed_amount_paise)} /><Info label=\"Invoice total\" value={money(claim.sale?.invoice_amount_paise)} /><Info label=\"Method\" value={title(claim.payment_method)} /><Info label=\"Transaction ref\" value={claim.transaction_reference ?? '—'} /></div>\n292:       {claim.agent_notes ? <div className=\"notice info\">Agent note: {claim.agent_notes}</div> : null}\n293:       <div className=\"stack\" style={{ marginTop: 15 }}>{claim.evidence.length ? claim.evidence.map((file) => <button key={file.id} className=\"button ghost small\" onClick={() => void downloadFile(`/agent/payments/evidence/${file.id}`, file.name)}>Download private evidence · {file.name} · {(file.size_bytes / 1024).toFixed(0)} KB</button>) : <Notice tone=\"error\">At least one receipt is required before approval.</Notice>}</div>\n294:       <form onSubmit={(event) => void submit(event)} className=\"form-grid\" style={{ marginTop: 16 }}><Select label=\"Decision\" value={decision} onChange={(value) => setDecision(value as typeof decision)} options={[[\"approve\", \"Approve collected payment\"], [\"request_information\", \"Request more information\"], [\"reject\", \"Reject claim\"], [\"reverse\", \"Reverse an approved claim\"]]} /><Field label=\"Approved amount (₹; optional)\" value={amount} onChange={setAmount} placeholder={String((claim.claimed_amount_paise / 100).toFixed(2))} type=\"number\" step=\"0.01\" disabled={decision !== 'approve'} /><Field label=\"Decision reason\" value={reason} onChange={setReason} placeholder=\"Required, at least five characters\" required /><div className=\"field full subtle\">Approval also requires an approved reward policy, an open cycle for the payment date, and receipt evidence.</div><div className=\"form-actions field full\"><button className={`button ${decision === 'reject' || decision === 'reverse' ? 'danger' : ''}`} disabled={busy || (decision === 'approve' && claim.evidence.length === 0)}>{busy ? 'Saving…' : `Record ${title(decision)}`}</button></div></form>\n295:       {claim.decisions.length ? <div style={{ marginTop: 17 }}><h3>Decision history</h3>{claim.decisions.map((item, index) => <div className=\"subtle\" key={`${item.created_at}-${index}`}>{title(item.decision)} · {item.reason ?? 'No reason'} · {date(item.created_at)}</div>)}</div> : null}\n296:     </section> : null}\n297:   </>;\n298: }\n299: \n300: function RewardsPanel({ data, staff, api, refresh }: { data: Data; staff: Staff; api: ApiCall; refresh: () => Promise<void> }) {"}
