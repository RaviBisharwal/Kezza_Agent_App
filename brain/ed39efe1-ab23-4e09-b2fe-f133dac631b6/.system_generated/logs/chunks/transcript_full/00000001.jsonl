{"step_index":26,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-17T06:40:30Z","content":"Created At: 2026-11-17T12:10:30+05:30\nCompleted At: 2026-11-17T12:10:32+05:30\nCreated At: 2026-11-17T12:10:30+05:30\nCompleted At: 2026-11-17T12:10:32+05:30\nCommand exited with code 0.\n\nCommand output:\nimport * as Clipboard from 'expo-clipboard';\r\nimport { router } from 'expo-router';\r\nimport { useState } from 'react';\r\nimport { Pressable, RefreshControl, Share, StyleSheet, Text, View } from 'react-native';\r\nimport { Button, InlineNotice } from '@/components/Button';\r\nimport { Card, Screen } from '@/components/Screen';\r\nimport { StatusBadge } from '@/components/StatusBadge';\r\nimport { Colors, Space } from '@/constants/theme';\r\nimport { useAgentDashboard, useAgentReferrals } from '@/features/referrals/hooks';\r\nimport { formatDate } from '@/lib/format';\r\nimport { getErrorMessage } from '@/lib/errors';\r\nimport { useAuthStore } from '@/store/auth-store';\r\n\r\nexport default function OverviewScreen() {\r\n  const user = useAuthStore((state) => state.user);\r\n  const dashboard = useAgentDashboard();\r\n  const referrals = useAgentReferrals();\r\n  const [copied, setCopied] = useState(false);\r\n  const refreshing = referrals.isRefetching || dashboard.isRefetching;\r\n  const items = referrals.data ?? [];\r\n\r\n  async function copyCode() {\r\n    if (!dashboard.data?.referral_code) return;\r\n    await Clipboard.setStringAsync(dashboard.data.referral_code);\r\n    setCopied(true);\r\n    setTimeout(() => setCopied(false), 1800);\r\n  }\r\n\r\n  async function shareCode() {\r\n    if (!dashboard.data?.share_text) return;\r\n    await Share.share({ message: dashboard.data.share_text });\r\n  }\r\n\r\n  return (\r\n    <Screen refreshControl={<RefreshControl refreshing={refreshing} onRefresh={() => { void referrals.refetch(); void dashboard.refetch(); }} tintColor={Colors.teal} />}>\r\n      <View style={styles.topline}>\r\n        <View><Text style={styles.kicker}>KEZZA AGENT</Text><Text style={styles.greeting}>Hello, {user?.fullName.split(' ')[0] ?? 'Agent'}</Text></View>\r\n        <Pressable accessibilityRole=\"button\" accessibilityLabel=\"Open profile and menu\" onPress={() => router.push('/profile')} style={styles.avatar}><Text style={styles.avatarText}>{user?.fullName.slice(0, 1).toUpperCase() ?? 'A'}</Text></Pressable>\r\n      </View>\r\n      <Text style={styles.subheading}>Your referral and reward workspace.</Text>\r\n\r\n      {dashboard.isError ? <InlineNotice tone=\"error\">{getErrorMessage(dashboard.error, 'Could not load your dashboard. Pull down to retry.')}</InlineNotice> : null}\r\n      <View style={styles.statsRow}>\r\n        <Stat label=\"Patients referred\" value={String(dashboard.data?.referral_count ?? items.length)} />\r\n        <Stat label=\"Payments waiting\" value={String(dashboard.data?.pending_payment_count ?? 0)} />\r\n        <Stat label=\"Reward points\" value={String(dashboard.data?.points_balance ?? 0)} accent />\r\n      </View>\r\n\r\n      <Card style={styles.inviteCard}>\r\n        <View><Text style={styles.inviteEyebrow}>YOUR AGENT CODE</Text><Text style={styles.code}>{dashboard.data?.referral_code ?? '—'}</Text></View>\r\n        <Text style={styles.cardCopy}>Share your assigned code, or add a patient referral directly in this app.</Text>\r\n        <View style={styles.actionRow}>\r\n          <View style={styles.actionCell}><Button variant=\"secondary\" disabled={!dashboard.data?.referral_code} onPress={copyCode}>{copied ? 'Copied' : 'Copy code'}</Button></View>\r\n          <View style={styles.actionCell}><Button variant=\"secondary\" disabled={!dashboard.data?.share_text} onPress={shareCode}>Share code</Button></View>\r\n        </View>\r\n      </Card>\r\n\r\n      {dashboard.data?.cycle ? <Card>\r\n        <View style={styles.cycleTop}><Text style={styles.sectionTitle}>{dashboard.data.cycle.name}</Text><Text style={styles.points}>{dashboard.data.cycle.points} pts</Text></View>\r\n        <Text style={styles.muted}>{formatDate(dashboard.data.cycle.starts_at)} – {formatDate(dashboard.data.cycle.ends_at)}</Text>\r\n        <View style={styles.track}><View style={[styles.fill, { width: `${dashboard.data.cycle.progress_percent}%` }]} /></View>\r\n        <Text style={styles.muted}>{formatRupees(dashboard.data.cycle.eligible_sales_paise)} of {formatRupees(dashboard.data.cycle.threshold_paise)} eligible sales</Text>\r\n      </Card> : <InlineNotice tone=\"info\">No reward cycle is open. Cycle progress appears after Kezza configures and approves the reward policy dates.</InlineNotice>}\r\n\r\n      <View style={styles.actionRow}>\r\n        <View style={styles.actionCell}><Button onPress={() => router.push('/add-patient')}>＋  Add patient</Button></View>\r\n        <View style={styles.actionCell}><Button variant=\"secondary\" onPress={() => router.push('/add-payment')}>＋  Add payment</Button></View>\r\n      </View>\r\n\r\n      <View style={styles.sectionHeader}><Text style={styles.sectionTitle}>Recent referrals</Text><Pressable onPress={() => router.push('/patients')}><Text style={styles.seeAll}>View all</Text></Pressable></View>\r\n      {referrals.isLoading ? <Card><Text style={styles.muted}>Loading your referral activity…</Text></Card> : items.length === 0 ? (\r\n        <Card><Text style={styles.emptyTitle}>Your first referral starts here</Text><Text style={styles.muted}>Add a patient to create the first tracked referral.</Text></Card>\r\n      ) : items.slice(0, 3).map((item) => (\r\n        <Pressable key={item.id} onPress={() => router.push({ pathname: '/referral/[id]', params: { id: item.id } })}>\r\n          <Card style={styles.referralCard}>\r\n            <View style={styles.referralTop}><Text style={styles.patientName} numberOfLines={1}>{item.patient_name}</Text><StatusBadge status={item.status} /></View>\r\n            <Text style={styles.muted}>{item.service || 'Service not specified'} · {item.branch} · Added {formatDate(item.created_at)}</Text>\r\n          </Card>\r\n        </Pressable>\r\n      ))}\r\n      <Text style={styles.disclaimer}>Points are posted only after finance review. The agent app cannot edit reward balances.</Text>\r\n    </Screen>\r\n  );\r\n}\r\n\r\nfunction Stat({ label, value, accent = false }: { label: string; value: string; accent?: boolean }) {\r\n  return <View style={styles.stat}><Text style={[styles.statValue, accent && { color: Colors.teal }]}>{value}</Text><Text style={styles.statLabel}>{label}</Text></View>;\r\n}\r\nfunction formatRupees(paise: number) { return `₹${(paise / 100).toLocaleString('en-IN', { maximumFractionDigits: 2 })}`; }\r\n\r\nconst styles = StyleSheet.create({\r\n  topline: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginTop: Space.sm },\r\n  kicker: { fontSize: 10, letterSpacing: 1.4, color: Colors.teal, fontWeight: '900' },\r\n  greeting: { fontSize: 27, lineHeight: 33, fontWeight: '900', color: Colors.ink, marginTop: 3 },\r\n  subheading: { color: Colors.inkMuted, fontSize: 14, marginTop: -Space.md },\r\n  avatar: { width: 44, height: 44, borderRadius: 16, backgroundColor: Colors.softTeal, alignItems: 'center', justifyContent: 'center' },\r\n  avatarText: { color: Colors.tealDark, fontSize: 18, fontWeight: '800' },\r\n  statsRow: { flexDirection: 'row', gap: Space.sm },\r\n  stat: { flex: 1, minHeight: 84, borderRadius: 16, backgroundColor: Colors.white, borderColor: Colors.line, borderWidth: 1, padding: Space.md, justifyContent: 'center', gap: 4 },\r\n  statValue: { color: Colors.ink, fontSize: 23, fontWeight: '900' }, statLabel: { color: Colors.inkMuted, fontSize: 11, fontWeight: '700', lineHeight: 15 },\r\n  inviteCard: { backgroundColor: Colors.ink, borderColor: Colors.ink, paddingVertical: Space.xl },\r\n  inviteEyebrow: { color: '#B8D9D4', fontSize: 10, fontWeight: '900', letterSpacing: 1.3 },\r\n  code: { color: Colors.white, fontSize: 29, letterSpacing: 2, fontWeight: '900' },\r\n  cardCopy: { color: '#D9E8E5', fontSize: 13, lineHeight: 19 }, actionRow: { flexDirection: 'row', gap: Space.md }, actionCell: { flex: 1 },\r\n  cycleTop: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }, sectionTitle: { color: Colors.ink, fontSize: 18, fontWeight: '800' },\r\n  points: { color: Colors.teal, fontSize: 15, fontWeight: '900' }, track: { height: 9, borderRadius: 5, backgroundColor: Colors.line, overflow: 'hidden' },\r\n  fill: { height: 9, borderRadius: 5, backgroundColor: Colors.teal }, muted: { color: Colors.inkMuted, fontSize: 13, lineHeight: 19 },\r\n  sectionHeader: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', marginTop: Space.sm }, seeAll: { color: Colors.teal, fontSize: 13, fontWeight: '800' },\r\n  referralCard: { padding: Space.lg }, referralTop: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', gap: Space.sm },\r\n  patientName: { color: Colors.ink, fontWeight: '800', fontSize: 15, flex: 1 }, emptyTitle: { color: Colors.ink, fontSize: 16, fontWeight: '800' },\r\n  disclaimer: { textAlign: 'center', marginTop: Space.sm, color: Colors.inkMuted, fontSize: 11, lineHeight: 16 },\r\n});\r\n"}
{"step_index":27,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-17T06:40:31Z","content":"Created At: 2026-11-17T12:10:31+05:30\nCompleted At: 2026-11-17T12:10:32+05:30\nCreated At: 2026-11-17T12:10:31+05:30\nCompleted At: 2026-11-17T12:10:32+05:30\nCommand exited with code 0.\n\nCommand output:\nimport { useState } from 'react';\r\nimport { router } from 'expo-router';\r\nimport { StyleSheet, Text, View } from 'react-native';\r\nimport { Button, InlineNotice } from '@/components/Button';\r\nimport { Card, PageHeading, Screen } from '@/components/Screen';\r\nimport { FormField } from '@/components/FormField';\r\nimport { Colors, Space } from '@/constants/theme';\r\nimport { useRequestOtp } from '@/features/auth/hooks';\r\nimport { getErrorMessage } from '@/lib/errors';\r\nimport { isIndianMobile, normalizeIndianMobile, toE164 } from '@/lib/phone';\r\n\r\nexport default function LoginScreen() {\r\n  const [phone, setPhone] = useState('');\r\n  const [error, setError] = useState('');\r\n  const requestOtp = useRequestOtp();\r\n  const normalized = normalizeIndianMobile(phone);\r\n\r\n  async function submit() {\r\n    setError('');\r\n    if (!isIndianMobile(normalized)) { setError('Enter a valid 10-digit Indian mobile number.'); return; }\r\n    try {\r\n      const result = await requestOtp.mutateAsync(toE164(normalized));\r\n      router.push({ pathname: '/(auth)/verify', params: { phone: toE164(normalized), devCode: result.dev_code ?? '' } });\r\n    } catch (caught) { setError(getErrorMessage(caught, 'We could not send the verification code.')); }\r\n  }\r\n\r\n  return (\r\n    <Screen>\r\n      <View style={styles.brand}><View style={styles.mark}><Text style={styles.markText}>K</Text></View><Text style={styles.brandName}>KEZZA <Text style={styles.brandAccent}>AGENT</Text></Text></View>\r\n      <PageHeading eyebrow=\"Agent workspace\" title=\"Welcome back\" subtitle=\"Sign in to manage patient referrals and follow up with confidence.\" />\r\n      <Card>\r\n        <Text style={styles.cardTitle}>Secure sign in</Text>\r\n        <Text style={styles.body}>We’ll send a one-time verification code to your mobile number.</Text>\r\n        <FormField label=\"Mobile number\" value={phone} onChangeText={setPhone} placeholder=\"98765 43210\" keyboardType=\"phone-pad\" maxLength={14} />\r\n        {error ? <InlineNotice tone=\"error\">{error}</InlineNotice> : null}\r\n        <Button onPress={submit} loading={requestOtp.isPending}>Continue with OTP</Button>\r\n      </Card>\r\n      <Text style={styles.footnote}>Agent accounts only · Your session is stored securely on this device.</Text>\r\n    </Screen>\r\n  );\r\n}\r\n\r\nconst styles = StyleSheet.create({\r\n  brand: { flexDirection: 'row', alignItems: 'center', gap: Space.md, marginTop: Space.xxl, marginBottom: Space.md },\r\n  mark: { width: 42, height: 42, borderRadius: 14, backgroundColor: Colors.teal, alignItems: 'center', justifyContent: 'center' },\r\n  markText: { color: Colors.white, fontSize: 25, fontWeight: '900' },\r\n  brandName: { color: Colors.ink, fontSize: 15, letterSpacing: 1.3, fontWeight: '900' },\r\n  brandAccent: { color: Colors.teal },\r\n  cardTitle: { fontSize: 19, fontWeight: '800', color: Colors.ink },\r\n  body: { color: Colors.inkMuted, fontSize: 14, lineHeight: 21 },\r\n  footnote: { marginTop: 'auto', paddingTop: Space.xxxl, textAlign: 'center', color: Colors.inkMuted, fontSize: 12, lineHeight: 18 },\r\n});\r\n"}
{"step_index":28,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-17T06:40:32Z","content":"Created At: 2026-11-17T12:10:32+05:30\nCompleted At: 2026-11-17T12:10:32+05:30\nCreated At: 2026-11-17T12:10:32+05:30\nCompleted At: 2026-11-17T12:10:32+05:30\nCommand exited with code 0.\n\nCommand output:\nimport axios, { create } from 'axios';\r\nimport { Platform } from 'react-native';\r\nimport { useAuthStore } from '@/store/auth-store';\r\n\r\nconst baseURL = process.env.EXPO_PUBLIC_API_URL?.trim().replace(/\\/$/, '');\r\n\r\nexport const api = create({\r\n  baseURL,\r\n  timeout: 15_000,\r\n  headers: {\r\n    'Content-Type': 'application/json',\r\n    'X-Kezza-Client': Platform.OS === 'web' ? 'web' : 'mobile',\r\n  },\r\n  withCredentials: true,\r\n});\r\n\r\napi.interceptors.request.use((config) => {\r\n  if (!baseURL) {\r\n    throw new Error('API address is not configured. Copy .env.example to .env and set EXPO_PUBLIC_API_URL.');\r\n  }\r\n  const token = useAuthStore.getState().accessToken;\r\n  if (token) config.headers.Authorization = `Bearer ${token}`;\r\n  return config;\r\n});\r\n\r\napi.interceptors.response.use(\r\n  (response) => response,\r\n  async (error) => {\r\n    const original = error?.config as (typeof error.config & { _retry?: boolean }) | undefined;\r\n    const isAuthRoute = String(original?.url ?? '').startsWith('/auth/');\r\n    if (error?.response?.status === 401 && original && !original._retry && !isAuthRoute && baseURL) {\r\n      const refreshToken = useAuthStore.getState().refreshToken;\r\n      if (refreshToken || typeof document !== 'undefined') {\r\n        original._retry = true;\r\n        try {\r\n          const refreshed = await axios.post<{ access_token: string; refresh_token?: string }>(\r\n            `${baseURL}/auth/refresh`, { refresh_token: refreshToken }, {\r\n              withCredentials: true,\r\n              timeout: 15_000,\r\n              headers: { 'X-Kezza-Client': Platform.OS === 'web' ? 'web' : 'mobile' },\r\n            },\r\n          );\r\n          await useAuthStore.getState().updateTokens(refreshed.data.access_token, refreshed.data.refresh_token);\r\n          original.headers.Authorization = `Bearer ${refreshed.data.access_token}`;\r\n          return api(original);\r\n        } catch {\r\n          await useAuthStore.getState().signOut();\r\n        }\r\n      } else {\r\n        await useAuthStore.getState().signOut();\r\n      }\r\n    }\r\n    if (error?.response?.status === 401 && !isAuthRoute) await useAuthStore.getState().signOut();\r\n    return Promise.reject(error);\r\n  },\r\n);\r\n"}
