{"step_index":64,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-15T08:56:55Z","content":"Created At: 2026-11-15T14:26:55+05:30\nCompleted At: 2026-11-15T14:26:55+05:30\nCreated At: 2026-11-15T14:26:55+05:30\nCompleted At: 2026-11-15T14:26:55+05:30\nShowing lines 1-57 of 57\n1: /* Graceful media fallback: original clinic photos/videos are never replaced unless the requested file fails. */\n2: (function(){\n3:   'use strict';\n4:   var F='/images/fallbacks/';\n5:   function pathOf(el){var raw=(el.getAttribute('src')||el.getAttribute('poster')||'').toLowerCase();try{return decodeURIComponent(raw);}catch(e){return raw;}}\n6:   function isCaseImage(p,alt){return /before[-_ ]?after|before|after|patient[-_ ]?(case|result|photo)|clinical[-_ ]?result|transformation|outcome|hairline[-_ ]?restoration/.test(p+' '+(alt||'').toLowerCase());}\n7:   function chooseFallback(p,alt){\n8:     if(/logo\\.(png|webp|jpe?g|svg)|\\bkezza[-_ ]?logo/.test(p))return F+'logo.webp';\n9:     if(/doctor|dr[-_ ]?[a-z]|\\bdoctor\\d/.test(p))return F+'clinical-team.webp';\n10:     if(/hair|scalp|follic|transplant|prp|gfc|wig|beard/.test(p))return F+'hair-restoration.webp';\n11:     if(/laser|electrolysis|hair[-_ ]?removal|q[-_ ]?switch|ipl/.test(p))return F+'laser-treatment.webp';\n12:     if(/lip|microblad|eyeliner|permanent[-_ ]?makeup|pmu|neutralization/.test(p))return F+'permanent-makeup.webp';\n13:     if(/hifu|cryo|body|weight|stretch[-_ ]?mark|contour/.test(p))return F+'body-treatment.webp';\n14:     if(/skin|acne|scar|pigment|peel|hydra|facial|botox|glutathione|dark[-_ ]?circle/.test(p))return F+'skin-treatment.webp';\n15:     if(/branch|location|clinic|building|reception|map/.test(p))return F+'clinic-location.webp';\n16:     return F+'generic-media.webp';\n17:   }\n18:   function addCaseNote(img){\n19:     var host=img.closest('.ba-img-container,.ba-slider-container,.case-img-pair,.ba-gallery-card,.before-after-section,.sm-ba-container,.dc-ba-container,.prp-ba-container');\n20:     if(!host)host=img.parentElement;\n21:     if(!host)return;\n22:     // Clear image/source elements so a missing patient image is never replaced with an unrelated image.\n23:     var pic=img.closest('picture');\n24:     if(pic){pic.querySelectorAll('source').forEach(function(s){s.removeAttribute('srcset');});}\n25:     img.style.display='none';\n26:     if(host.querySelector('.kz-media-placeholder'))return;\n27:     var box=document.createElement('div');box.className='kz-media-placeholder kz-media-placeholder--case';box.setAttribute('role','note');\n28:     var strong=document.createElement('strong');strong.textContent='Patient case photo unavailable';box.appendChild(strong);\n29:     var small=document.createElement('small');small.textContent='The original image was not included in this archive. Add the consented, verified case photo before publishing this section. Individual results vary.';box.appendChild(small);\n30:     host.appendChild(box);\n31:   }\n32:   function imgError(event){\n33:     var img=event.target;\n34:     if(!img||img.tagName!=='IMG'||img.dataset.kzFallbackApplied==='1')return;\n35:     var p=pathOf(img), alt=img.getAttribute('alt')||'';\n36:     if(isCaseImage(p,alt)){addCaseNote(img);img.dataset.kzFallbackApplied='1';return;}\n37:     img.dataset.kzFallbackApplied='1';\n38:     var picture=img.closest('picture');\n39:     if(picture)picture.querySelectorAll('source').forEach(function(s){s.removeAttribute('srcset');});\n40:     var fallback=chooseFallback(p,alt);\n41:     img.setAttribute('src',fallback);img.removeAttribute('srcset');img.removeAttribute('sizes');\n42:     if(/doctor|dr[-_ ]?[a-z]|\\bdoctor\\d/.test(p))img.alt='Kezza clinical team image placeholder';\n43:     else if(/logo/.test(p))img.alt='Kezza Hair & Skin Clinic';\n44:     else img.alt='Illustrative Kezza Hair & Skin Clinic information card; original image unavailable';\n45:   }\n46:   function mediaError(event){\n47:     var el=event.target;\n48:     if(!el||el.tagName!=='VIDEO'||el.dataset.kzFallbackApplied==='1')return;\n49:     el.dataset.kzFallbackApplied='1';el.style.display='none';\n50:     var host=el.parentElement||el.parentNode;if(!host||host.querySelector('.kz-video-fallback'))return;\n51:     var box=document.createElement('div');box.className='kz-video-fallback';box.setAttribute('role','note');\n52:     var strong=document.createElement('strong');strong.textContent='Video preview unavailable';box.appendChild(strong);\n53:     var small=document.createElement('small');small.textContent='The original video file was not included in this archive. Restore it to show the video here.';box.appendChild(small);host.appendChild(box);\n54:   }\n55:   document.addEventListener('error',imgError,true);\n56:   document.addEventListener('error',mediaError,true);\n57: })();"}
