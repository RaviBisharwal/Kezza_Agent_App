:         // Process elements and assign stagger delays based on sibling index\n179:         const allTargetCards = document.querySelectorAll(cardSelectors.join(', '));\n180:         allTargetCards.forEach(el => {\n181:             if (!el.classList.contains('pro-reveal') && !el.classList.contains('pro-reveal-scale')) {\n182:                 // Large hero image wraps and Before/After cards get scale reveal\n183:                 if (\n184:                     el.classList.contains('dc-hero-media-wrap') ||\n185:                     el.classList.contains('sm-hero-media-wrap') ||\n186:                     el.classList.contains('dc-ba-card') ||\n187:                     el.classList.contains('sm-ba-card') ||\n188:                     el.classList.contains('dc-verdict-box') ||\n189:                     el.classList.contains('sm-verdict-box')\n190:                 ) {\n191:                     el.classList.add('pro-reveal-scale');\n192:                 } else {\n193:                     el.classList.add('pro-reveal');\n194:                 }\n195: \n196:                 // If in a parent grid, assign a stagger class\n197:                 const parent = el.parentElement;\n198:                 if (parent && parent.children.length > 1) {\n199:                     const idx = Array.prototype.indexOf.call(parent.children, el);\n200:                     const staggerNum = (idx % 6) + 1;\n201:                     el.classList.add('stagger-' + staggerNum);\n202:                 }\n203:             }\n204:         });\n205: \n206:         const reveals = document.querySelectorAll('.pro-reveal, .pro-reveal-scale, .pro-reveal-left, .pro-reveal-right');\n207:         if (!reveals.length) return;\n208: \n209:         if ('IntersectionObserver' in window) {\n210:             const revealObserver = new IntersectionObserver((entries, observer) => {\n211:                 entries.forEach(entry => {\n212:                     if (entry.isIntersecting) {\n213:                         entry.target.classList.add('is-revealed');\n214:                         observer.unobserve(entry.target);\n215:                     }\n216:                 });\n217:             }, {\n218:                 root: null,\n219:                 threshold: 0.05,\n220:                 rootMargin: '120px 0px 40px 0px'\n221:             });\n222: \n223:             reveals.forEach(el => {\n224:                 revealObserver.observe(el);\n225:             });\n226:         } else {\n227:             reveals.forEach(el => el.classList.add('is-revealed'));\n228:         }\n229:     }\n230: \n231:     /* ── 4. Live Count-Up Animation for Metrics & Stats ── */\n232:     function initCountUpStats() {\n233:         if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;\n234: \n235:         // Auto-tag numeric stats that don't have data-count\n236:         const autoStatElements = document.querySelectorAll('.dc-metric-value, .sm-metric-value, .stat-box .stat-num');\n237:         autoStatElements.forEach(el => {\n238:             if (!el.hasAttribute('data-count')) {\n239:                 const text = el.textContent.trim();\n240:                 // Check if text starts with or contains numbers e.g. \"98%\", \"3-6\", \"30-60\", \"70%+\", \"10,000+\"\n241:                 const match = text.match(/^(\\d+(?:,\\d+)?)/);\n242:                 if (match && !text.includes('–') && !text.includes('-')) {\n243:                     const num = parseInt(match[1].replace(/,/g, ''), 10);\n244:                     if (num > 0) {\n245:                         const suffix = text.slice(match[0].length);\n246:                         el.setAttribute('data-count', num);\n247:                         el.setAttribute('data-suffix', suffix);\n248:                         el.classList.add('stat-number-pro');\n249:                     }\n250:                 }\n251:             }\n252:         });\n253: \n254:         const statElements = document.querySelectorAll('.stat-number-pro[data-count]');\n255:         if (!statElements.length) return;\n256: \n257:         function animateSingleCounter(el) {\n258:             const target = parseInt(el.getAttribute('data-count'), 10) || 0;\n259:             const prefix = el.getAttribute('data-prefix') || '';\n260:             const suffix = el.getAttribute('data-suffix') || '';\n261:             const duration = 1600; // ms\n262:             const startTime = performance.now();\n263: \n264:             function easeOutExpo(x) {\n265:                 return x === 1 ? 1 : 1 - Math.pow(2, -10 * x);\n266:             }\n267: \n268:             function updateCounter(currentTime) {\n269:                 const elapsed = currentTime - startTime;\n270:                 const progress = Math.min(elapsed / duration, 1);\n271:                 const currentVal = Math.floor(easeOutExpo(progress) * target);\n272: \n273:                 el.textContent = `${prefix}${currentVal.toLocaleString()}${suffix}`;\n274: \n275:                 if (progress < 1) {\n276:                     requestAnimationFrame(updateCounter);\n277:                 } else {\n278:                     el.textContent = `${prefix}${target.toLocaleString()}${suffix}`;\n279:                 }\n280:             }\n281: \n282:             requestAnimationFrame(updateCounter);\n283:         }\n284: \n285:         if ('IntersectionObserver' in window) {\n286:             const observer = new IntersectionObserver((entries, obs) => {\n287:                 entries.forEach(entry => {\n288:                     if (entry.isIntersecting) {\n289:                         animateSingleCounter(entry.target);\n290:                         obs.unobserve(entry.target);\n291:                     }\n292:                 });\n293:             }, { threshold: 0.15 });\n294: \n295:             statElements.forEach(el => observer.observe(el));\n296:         } else {\n297:             statElements.forEach(el => animateSingleCounter(el));\n298:         }\n299:     }\n300: "}
