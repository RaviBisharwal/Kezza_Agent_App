{"step_index":76,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-15T08:57:23Z","content":"Created At: 2026-11-15T14:27:23+05:30\nCompleted At: 2026-11-15T14:27:24+05:30\nCreated At: 2026-11-15T14:27:23+05:30\nCompleted At: 2026-11-15T14:27:24+05:30\nShowing lines 1-100 of 213\n1: /**\n2:  * Kezza Clinic - Continuous Horizontal Image Carousel\n3:  * Implements silky-smooth linear auto-scroll (Right -> Left),\n4:  * seamless infinite looping, desktop hover pause, and touch swipe with momentum.\n5:  */\n6: (function () {\n7:     'use strict';\n8: \n9:     function initContinuousGallery() {\n10:         const viewport = document.getElementById('galleryCarouselViewport');\n11:         const track = document.getElementById('galleryCarouselTrack');\n12: \n13:         if (!viewport || !track) return;\n14: \n15:         const cards = track.querySelectorAll('.gallery-carousel-card');\n16:         if (cards.length < 2) return;\n17: \n18:         // Switch track to JS-controlled RAF loop\n19:         track.classList.add('js-controlled');\n20: \n21:         // State variables\n22:         let currentX = 0;\n23:         let halfWidth = 0;\n24:         let baseSpeed = 180; // pixels per second (~3.0px at 60fps - fast, lively continuous scroll)\n25:         let isHovered = false;\n26:         let isDragging = false;\n27:         let isMomentum = false;\n28:         let dragLastX = 0;\n29:         let dragVelocityX = 0;\n30:         let lastTimestamp = performance.now();\n31:         let animationFrameId = null;\n32:         let onScreen = true;\n33: \n34:         // Respect user's motion preference\n35:         const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n36: \n37:         // Calculate the exact wrap distance based on layout without forced reflows\n38:         function updateDimensions() {\n39:             halfWidth = track.scrollWidth / 2;\n40:         }\n41: \n42:         if (window.ResizeObserver) {\n43:             new ResizeObserver(entries => {\n44:                 for (const entry of entries) {\n45:                     if (entry.contentRect && entry.contentRect.width > 0) {\n46:                         halfWidth = entry.contentRect.width / 2;\n47:                     }\n48:                 }\n49:             }).observe(track);\n50:         } else {\n51:             window.addEventListener('load', updateDimensions);\n52:             let resizeTimer = null;\n53:             window.addEventListener('resize', () => {\n54:                 clearTimeout(resizeTimer);\n55:                 resizeTimer = setTimeout(updateDimensions, 100);\n56:             });\n57:         }\n58: \n59:         // Apply hardware-accelerated transform\n60:         function render() {\n61:             // Keep currentX within [-halfWidth, 0)\n62:             if (halfWidth > 0) {\n63:                 while (currentX <= -halfWidth) {\n64:                     currentX += halfWidth;\n65:                 }\n66:                 while (currentX > 0) {\n67:                     currentX -= halfWidth;\n68:                 }\n69:             }\n70:             track.style.transform = `translate3d(${currentX.toFixed(2)}px, 0, 0)`;\n71:         }\n72: \n73:         // Main Animation Loop\n74:         function animate(now) {\n75:             const dt = Math.min((now - lastTimestamp) / 1000, 0.1); // clamp delta in case of tab freeze\n76:             lastTimestamp = now;\n77: \n78:             if (!prefersReducedMotion && !isDragging) {\n79:                 const isPageScrolling = document.body && document.body.classList.contains('is-scrolling');\n80:                 if (isMomentum) {\n81:                     // Decay momentum swipe smoothly\n82:                     currentX += dragVelocityX * dt;\n83:                     dragVelocityX *= Math.pow(0.1, dt); // gentle friction decay\n84:                     if (Math.abs(dragVelocityX) < 15) {\n85:                         isMomentum = false;\n86:                         dragVelocityX = 0;\n87:                     }\n88:                     render();\n89:                 } else if (!isHovered && !isPageScrolling) {\n90:                     // Constant linear movement Right -> Left\n91:                     currentX -= baseSpeed * dt;\n92:                     render();\n93:                 }\n94:             }\n95: \n96:             animationFrameId = requestAnimationFrame(animate);\n97:         }\n98: \n99:         // Hover pause for desktop\n100:         viewport.addEventListener('mouseenter', () => {"}
