34:                 card.style.transform = `perspective(900px) translateY(-7px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) scale3d(1.02, 1.02, 1.02)`;\n335:             });\n336: \n337:             card.addEventListener('mouseleave', () => {\n338:                 isHovered = false;\n339:                 cardRect = null;\n340:                 card.style.transition = 'transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease, border-color 0.35s ease';\n341:                 card.style.transform = '';\n342:             });\n343:         });\n344:     }\n345: \n346:     /* ── 6. Interactive Before/After Transformation Slider ── */\n347:     function initBeforeAfterSlider() {\n348:         const container = document.querySelector('.ba-slider-container');\n349:         if (!container) return;\n350: \n351:         const beforeWrap = container.querySelector('.ba-img-before-wrap');\n352:         const divider = container.querySelector('.ba-divider');\n353:         const beforeImg = beforeWrap ? beforeWrap.querySelector('img') : null;\n354: \n355:         if (!beforeWrap || !divider || !beforeImg) return;\n356: \n357:         let isDragging = false;\n358:         let cachedSliderRect = null;\n359: \n360:         function applyDimensions(w, h) {\n361:             if (beforeImg && w > 0 && h > 0) {\n362:                 beforeImg.style.width = Math.round(w) + 'px';\n363:                 beforeImg.style.height = Math.round(h) + 'px';\n364:             }\n365:         }\n366: \n367:         if (window.ResizeObserver) {\n368:             const ro = new ResizeObserver(entries => {\n369:                 for (const entry of entries) {\n370:                     if (entry.contentRect && entry.contentRect.width > 0) {\n371:                         applyDimensions(entry.contentRect.width, entry.contentRect.height);\n372:                     }\n373:                 }\n374:             });\n375:             ro.observe(container);\n376:         } else {\n377:             function syncFallback() {\n378:                 const rect = container.getBoundingClientRect();\n379:                 applyDimensions(rect.width, rect.height);\n380:             }\n381:             window.addEventListener('resize', syncFallback);\n382:             window.addEventListener('orientationchange', syncFallback);\n383:             beforeImg.addEventListener('load', syncFallback);\n384:             requestAnimationFrame(syncFallback);\n385:         }\n386: \n387:         function setPosition(xPos) {\n388:             if (!cachedSliderRect) {\n389:                 cachedSliderRect = container.getBoundingClientRect();\n390:             }\n391:             const rect = cachedSliderRect;\n392:             let offsetX = xPos - rect.left;\n393: \n394:             const minX = rect.width * 0.05;\n395:             const maxX = rect.width * 0.95;\n396:             offsetX = Math.max(minX, Math.min(offsetX, maxX));\n397: \n398:             const percentage = (offsetX / rect.width) * 100;\n399:             beforeWrap.style.width = percentage + '%';\n400:             divider.style.left = percentage + '%';\n401:             const handle = divider.querySelector('.ba-handle');\n402:             if (handle) {\n403:                 handle.setAttribute('aria-valuenow', String(Math.round(percentage)));\n404:             }\n405:         }\n406: \n407:         function getClientX(e) {\n408:             if (e.clientX !== undefined) return e.clientX;\n409:             if (e.touches && e.touches.length > 0) return e.touches[0].clientX;\n410:             if (e.changedTouches && e.changedTouches.length > 0) return e.changedTouches[0].clientX;\n411:             return null;\n412:         }\n413: \n414:         function onPointerDown(e) {\n415:             isDragging = true;\n416:             cachedSliderRect = container.getBoundingClientRect();\n417:             container.style.cursor = 'ew-resize';\n418:             const clientX = getClientX(e);\n419:             if (clientX !== null) setPosition(clientX);\n420:         }\n421: \n422:         function onPointerMove(e) {\n423:             if (!isDragging) return;\n424:             const clientX = getClientX(e);\n425:             if (clientX !== null) setPosition(clientX);\n426:         }\n427: \n428:         function onPointerUp() {\n429:             isDragging = false;\n430:             cachedSliderRect = null;\n431:             container.style.cursor = 'default';\n432:         }\n433: \n434:         container.addEventListener('mousedown', onPointerDown);\n435:         window.addEventListener('mousemove', onPointerMove);\n436:         window.addEventListener('mouseup', onPointerUp);\n437: \n438:         container.addEventListener('touchstart', onPointerDown, { passive: true });\n439:         window.addEventListener('touchmove', onPointerMove, { passive: true });\n440:         window.addEventListener('touchend', onPointerUp, { passive: true });\n441:         window.addEventListener('touchcancel', onPointerUp, { passive: true });\n442:     }\n443: \n444:     /* ── 7. Testimonial Category Filters ── */\n445:     function initTestimonialFilters() {\n446:         const filterBtns = document.querySelectorAll('.testi-filter-btn');\n447:         const cards = document.querySelectorAll('.testi-card-pro');\n448:         if (!filterBtns.length || !cards.length) return;\n449: \n450:         filterBtns.forEach(btn => {\n451:             btn.addEventListener('click', function () {\n452:                 const filter = this.getAttribute('data-filter');\n453:                 if (!filter) return;\n454: \n455:                 filterBtns.forEach(b => b.classList.remove('active'));\n456:                 this.classList.add('active');\n457: \n458:                 let visibleIndex = 0;\n459:                 cards.forEach(card => {\n460:                     const category = card.getAttribute('data-category');\n461:                     const shouldShow = (filter === 'all' || category === filter);\n462: \n463:                     if (shouldShow) {\n464:                         card.style.display = 'flex';\n465:                         card.style.opacity = '0';\n466:                         card.style.transform = 'translateY(12px)';\n467:                         setTimeout(() => {\n468:                             card.style.transition = 'opacity 0.35s ease, transform 0.35s ease';\n469:                             card.style.opacity = '1';\n470:                             card.style.transform = 'translateY(0)';\n471:                         }, visibleIndex * 45);\n472:                         visibleIndex++;\n473:                     } else {\n474:                         card.style.display = 'none';\n475:                     }\n476:                 });\n477:             });\n478:         });\n479:     }\n480: \n481: })();"}
