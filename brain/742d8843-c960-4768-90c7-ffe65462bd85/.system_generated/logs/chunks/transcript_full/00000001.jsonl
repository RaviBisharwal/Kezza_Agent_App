 loadReviews(clinic, clinicLabel, grid, loading) {\n119:         if (loading) loading.style.display = 'flex';\n120: \n121:         function applyData(all) {\n122:             if (loading) loading.style.display = 'none';\n123:             var filtered = all.filter(function (r) {\n124:                 if (clinic === 'all') return true;\n125:                 return (r.branchId || '').toLowerCase() === clinic.toLowerCase();\n126:             });\n127: \n128:             if (!filtered.length) {\n129:                 renderEmptyState(grid, clinic, clinicLabel);\n130:                 return;\n131:             }\n132: \n133:             var html = '';\n134:             filtered.forEach(function (r, i) {\n135:                 html += buildHomeCard(r, i);\n136:             });\n137:             grid.innerHTML = html;\n138:         }\n139: \n140:         if (cachedReviews) {\n141:             applyData(cachedReviews);\n142:             return;\n143:         }\n144: \n145:         fetch('/data/genuine-reviews.json')\n146:             .then(function (res) { return res.json(); })\n147:             .then(function (data) {\n148:                 cachedReviews = data.reviews || [];\n149:                 applyData(cachedReviews);\n150:             })\n151:             .catch(function (err) {\n152:                 console.warn('[kezza-reviews] Could not load genuine-reviews.json:', err);\n153:                 if (loading) loading.style.display = 'none';\n154:                 renderEmptyState(grid, clinic, clinicLabel);\n155:             });\n156:     }\n157: \n158:     function init() {\n159:         var grid = document.getElementById('testiGrid');\n160:         var tabs = document.getElementById('testiClinicTabs');\n161:         var loading = document.getElementById('testiLoading');\n162: \n163:         if (!grid || !tabs) return;\n164: \n165:         // Determine active clinic from existing DOM or default to 'jaipur'\n166:         var activeBtn = tabs.querySelector('.testi-clinic-tab.active') || tabs.querySelector('.testi-clinic-tab');\n167:         var activeClinic = activeBtn ? (activeBtn.getAttribute('data-clinic') || 'jaipur') : 'jaipur';\n168:         var clinicLabels = { jaipur: 'Jaipur', sikar: 'Sikar', ajmer: 'Ajmer', all: 'All Clinics' };\n169: \n170:         // Set active tab UI\n171:         tabs.querySelectorAll('.testi-clinic-tab').forEach(function (btn) {\n172:             var isActive = btn.getAttribute('data-clinic') === activeClinic;\n173:             btn.classList.toggle('active', isActive);\n174:             btn.setAttribute('aria-selected', isActive ? 'true' : 'false');\n175:         });\n176: \n177:         loadReviews(activeClinic, clinicLabels[activeClinic] || activeClinic, grid, loading);\n178: \n179:         tabs.addEventListener('click', function (e) {\n180:             var btn = e.target.closest('.testi-clinic-tab');\n181:             if (!btn) return;\n182:             var clinic = btn.getAttribute('data-clinic');\n183:             if (!clinic || clinic === activeClinic) return;\n184: \n185:             tabs.querySelectorAll('.testi-clinic-tab').forEach(function (b) {\n186:                 var isActive = b === btn;\n187:                 b.classList.toggle('active', isActive);\n188:                 b.setAttribute('aria-selected', isActive ? 'true' : 'false');\n189:             });\n190:             activeClinic = clinic;\n191:             loadReviews(clinic, clinicLabels[clinic] || clinic, grid, loading);\n192:         });\n193:     }\n194: \n195:     if (document.readyState === 'loading') {\n196:         document.addEventListener('DOMContentLoaded', init);\n197:     } else {\n198:         init();\n199:     }\n200: })();"}
