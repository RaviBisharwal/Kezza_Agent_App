roll Progress Bar ── */\n47:     function initScrollProgressBar() {\n48:         if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;\n49:         if (document.getElementById('kz-scroll-progress')) return;\n50:         // smooth-scroll.js already draws the reading-progress bar on pages that load it.\n51:         if (document.getElementById('kzScrollProgress') || window.KezzaSmoothScroll) return;\n52: \n53:         const progressBar = document.createElement('div');\n54:         progressBar.id = 'kz-scroll-progress';\n55:         progressBar.setAttribute('aria-hidden', 'true');\n56:         document.body.appendChild(progressBar);\n57: \n58:         let ticking = false;\n59:         let cachedDocHeight = 0;\n60:         function measureDocHeight() {\n61:             cachedDocHeight = Math.max(0, document.documentElement.scrollHeight - document.documentElement.clientHeight);\n62:         }\n63: \n64:         function updateProgress() {\n65:             const scrollTop = window.pageYOffset || document.documentElement.scrollTop;\n66:             if (scrollTop === 0) {\n67:                 ticking = false;\n68:                 return;\n69:             }\n70:             if (cachedDocHeight <= 0) {\n71:                 measureDocHeight();\n72:             }\n73:             if (cachedDocHeight > 0) {\n74:                 const percent = Math.min(100, Math.max(0, (scrollTop / cachedDocHeight) * 100));\n75:                 progressBar.style.width = '100%';\n76:                 progressBar.style.transformOrigin = '0 50%';\n77:                 progressBar.style.transform = 'scaleX(' + (percent / 100).toFixed(4) + ')';\n78:             }\n79:             ticking = false;\n80:         }\n81: \n82:         let resizeTimer = null;\n83:         function onResize() {\n84:             clearTimeout(resizeTimer);\n85:             resizeTimer = setTimeout(function () {\n86:                 measureDocHeight();\n87:                 updateProgress();\n88:             }, 120);\n89:         }\n90: \n91:         window.addEventListener('scroll', function () {\n92:             if (!ticking) {\n93:                 window.requestAnimationFrame(updateProgress);\n94:                 ticking = true;\n95:             }\n96:         }, { passive: true });\n97:         window.addEventListener('resize', onResize, { passive: true });\n98:         window.addEventListener('orientationchange', onResize, { passive: true });\n99:         window.addEventListener('load', measureDocHeight, { passive: true });\n100:     }"}
