rs.push(`${f}: ${m}`);\n32: const warn = (f, m) => warnings.push(`${f}: ${m}`);\n33: \n34: function walk(dir) {\n35:   return fs.readdirSync(dir, { withFileTypes: true }).flatMap((d) => {\n36:     const p = path.join(dir, d.name);\n37:     if (d.isDirectory()) return SKIP_DIRS.has(d.name) ? [] : walk(p);\n38:     if (/^google[a-z0-9]+\\.html$/i.test(d.name)) return [];\n39:     return d.name.endsWith('.html') ? [p] : [];\n40:   });\n41: }\n42: \n43: const decode = (s) => s.replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '\"')\n44:   .replace(/&#39;|&#x27;/g, \"'\").replace(/&nbsp;/g, ' ').replace(/&ndash;/g, '–').replace(/&mdash;/g, '—')\n45:   .replace(/&rsquo;/g, '’').replace(/&ldquo;|&rdquo;/g, '\"').replace(/&middot;/g, '·').replace(/&bull;/g, '•');\n46: const textOf = (html) => decode(html.replace(/<script[\\s\\S]*?<\\/script>|<style[\\s\\S]*?<\\/style>/gi, ' ').replace(/<[^>]+>/g, ' ')).replace(/\\s+/g, ' ');\n47: const norm = (s) => decode(s).toLowerCase().replace(/[^a-z0-9\\u0900-\\u097f]+/g, ' ').trim(); // keeps Devanagari\n48: \n49: function localTarget(fromFile, href) {\n50:   if (href && href.includes('${')) return null;                  // JS template strings"}
