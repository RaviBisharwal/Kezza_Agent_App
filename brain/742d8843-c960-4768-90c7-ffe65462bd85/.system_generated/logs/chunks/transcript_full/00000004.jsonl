ress\":\"4th Floor, Shakambhari Heights, Opposite S.K. Hospital, Silver Jubilee Road\",\"addressLocality\":\"Sikar\",\"addressRegion\":\"Rajasthan\",\"postalCode\":\"332001\",\"addressCountry\":\"IN\"},\"openingHoursSpecification\":[{\"@type\":\"OpeningHoursSpecification\",\"dayOfWeek\":[\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\",\"Sunday\"],\"opens\":\"09:00\",\"closes\":\"20:00\"}],\"image\":\"https://www.kezza.co.in/images/fallbacks/clinic-location.webp\",\"hasMap\":\"https://maps.app.goo.gl/kFkEyXNvTP6DSGKq6\",\"priceRange\":\"₹₹\",\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":27.6133424,\"longitude\":75.1518958},\"logo\":{\"@id\":\"https://www.kezza.co.in/#logo\"},\"email\":\"support@kezza.co.in\",\"areaServed\":{\"@type\":\"City\",\"name\":\"Sikar\"},\"medicalSpecialty\":[\"Dermatology\",\"PlasticSurgery\"],\"sameAs\":[\"https://www.facebook.com/kezzaclinic\",\"https://www.instagram.com/kezza_clinic\",\"https://www.youtube.com/@Kezza_Clinic_Jaipur\"],\"contactPoint\":[{\"@type\":\"ContactPoint\",\"telephone\":\"+91-9284517427\",\"contactType\":\"appointments\",\"availableLanguage\":[\"en\",\"hi\"]},{\"@type\":\"ContactPoint\",\"telephone\":\"+91-7073565197\",\"contactType\":\"appointments\",\"availableLanguage\":[\"en\",\"hi\"]}]},{\"@type\":\"MedicalClinic\",\"@id\":\"https://www.kezza.co.in/locations/ajmer/#clinic\",\"name\":\"Kezza Hair & Skin Clinic – Ajmer\",\"url\":\"https://www.kezza.co.in/locations/ajmer/\",\"parentOrganization\":{\"@id\":\"https://www.kezza.co.in/#organization\"},\"telephone\":\"+91-9216088257\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"1st Floor, Hotel Oasis Complex, Shastri Nagar, Jawahar Nagar\",\"addressLocality\":\"Ajmer\",\"addressRegion\":\"Rajasthan\",\"postalCode\":\"305001\",\"addressCountry\":\"IN\"},\"openingHoursSpecification\":[{\"@type\":\"OpeningHoursSpecification\",\"dayOfWeek\":[\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\",\"Sunday\"],\"opens\":\"09:00\",\"closes\":\"20:00\"}],\"image\":\"https://www.kezza.co.in/images/fallbacks/clinic-location.webp\",\"hasMap\":\"https://maps.app.goo.gl/zMajvKmT5N7coswJA\",\"priceRange\":\"₹₹\",\"logo\":{\"@id\":\"https://www.kezza.co.in/#logo\"},\"email\":\"kezzaclinic@gmail.com\",\"areaServed\":{\"@type\":\"City\",\"name\":\"Ajmer\"},\"medicalSpecialty\":[\"Dermatology\",\"PlasticSurgery\"],\"sameAs\":[\"https://www.facebook.com/kezzaclinic\",\"https://www.instagram.com/kezza_clinic\",\"https://www.youtube.com/@Kezza_Clinic_Jaipur\"]},{\"@type\":\"FAQPage\",\"@id\":\"https://www.kezza.co.in/#faq\",\"isPartOf\":{\"@id\":\"https://www.kezza.co.in/#webpage\"},\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Is a hair transplant painful?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The procedure is performed under local anaesthesia, so you stay awake but feel no pain during it. Most patients describe mild soreness for two to three days afterwards, which is managed with simple prescribed medication.\"}},{\"@type\":\"Question\",\"name\":\"How long does the procedure take?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"A typical session runs four to eight hours in a single day, depending on the number of grafts. You walk out the same day — no hospital stay is required.\"}},{\"@type\":\"Question\",\"name\":\"Are the results permanent?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Transplanted follicles are taken from the donor area at the back of the scalp, which is genetically resistant to hair loss. Those grafts are permanent. Existing non-transplanted hair can still thin over time, which is why we plan the hairline with your long-term pattern in mind.\"}},{\"@type\":\"Question\",\"name\":\"What does it cost, and is EMI available?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Cost depends on the graft count and technique, so it is confirmed only after a scalp assessment. We offer no-cost EMI plans on most procedures. Book a free consultation and you will get a written estimate before committing to anything.\"}},{\"@type\":\"Question\",\"name\":\"How soon can I return to work?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Most patients resume desk work in three to five days. Visible scabbing settles within about ten days, and new growth typically becomes noticeable from the third to fourth month, with full results at twelve months.\"}},{\"@type\":\"Question\",\"name\":\"Who is a good candidate?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Adults with stable hair loss and a healthy donor area are usually suitable. Age, the pattern and rate of loss, and general health all matter, so candidacy is confirmed by our surgeon during the consultation rather than online.\"}}]}]}</script>\n38: <link href=\"/css/site-quality.css?v=20261013\" rel=\"stylesheet\"/>\n39: <link href=\"/css/upgrades-pro.css\" rel=\"stylesheet\"/>\n40: <script src=\"/js/media-fallbacks.min.js?v=664242f3\"></script>\n41: <link href=\"/site.webmanifest\" rel=\"manifest\"/>\n42: <meta content=\"#00afc0\" name=\"theme-color\"/>\n43: </head>\n44: <body>\n45: "}
