     }\n30:         }\n31: \n32:         categoryCards.forEach(card => {\n33:             card.addEventListener('click', function(e) {\n34:                 const category = this.getAttribute('data-category');\n35:                 if (category) {\n36:                     e.preventDefault();\n37:                     switchCategory(category, true);\n38:                 }\n39:             });\n40:         });\n41: \n42:         tabButtons.forEach(btn => {\n43:             btn.addEventListener('click', function(e) {\n44:                 e.preventDefault();\n45:                 e.stopPropagation(); // tab clicks never reach document-level handlers (open dropdowns stay open)\n46:                 const category = this.getAttribute('data-category');\n47:                 if (category) {\n48:                     switchCategory(category, false);\n49:                 }\n50:             });"}
