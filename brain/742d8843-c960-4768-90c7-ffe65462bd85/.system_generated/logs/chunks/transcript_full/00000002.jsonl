t('hex').slice(0, 8);\n41: const versionOf = (rel) => {\n42:   const file = path.join(FE, rel);\n43:   return fs.existsSync(file) ? md5(fs.readFileSync(file)) : null;\n44: };\n45: \n46: let before = 0;\n47: let after = 0;\n48: function minify(name) {\n49:   const src = fs.readFileSync(path.join(JS_DIR, name), 'utf8');\n50:   let code;\n51:   try {\n52:     code = esbuild.transformSync(src, { loader: 'js', minify: true, charset: 'utf8', legalComments: 'none' }).code;\n53:   } catch (err) {\n54:     console.error(`Could not minify js/${name}:\\n${err.message}`);\n55:     process.exit(1);\n56:   }\n57:   const dest = name.replace(/\\.js$/, '.min.js');\n58:   const destPath = path.join(JS_DIR, dest);\n59:   if (!fs.existsSync(destPath) || fs.readFileSync(destPath, 'utf8') !== code) fs.writeFileSync(destPath, code);\n60:   before += Buffer.byteLength(src);\n61:   after += Buffer.byteLength(code);\n62: }\n63: \n64: // 1. Everything except the runtime loaders\n65: const sources = fs.readdirSync(JS_DIR).filter((f) => f.endsWith('.js') && !f.endsWith('.min.js')).sort();\n66: sources.filter((f) => !LOADERS.includes(f)).forEach(minify);\n67: \n68: // 2. Stamp the files the loaders inject at runtime, then minify the loaders\n69: const RUNTIME_REF = /(['\"])(\\/?)((?:js\\/[A-Za-z0-9._-]+?\\.min\\.js)|(?:css\\/bundle-[A-Za-z0-9._-]+\\.min\\.css))(?:\\?v=[A-Za-z0-9._-]*)?\\1/g;\n70: for (const name of LOADERS) {\n71:   const file = path.join(JS_DIR, name);\n72:   if (!fs.existsSync(file)) continue;\n73:   const src = fs.readFileSync(file, 'utf8');\n74:   const out = src.replace(RUNTIME_REF, (m, q, slash, rel) => {\n75:     const v = versionOf(rel);\n76:     if (!v) { console.warn(`  ! js/${name} refers to a missing file: ${rel}`); return m; }\n77:     return `${q}${slash}${rel}?v=${v}${q}`;\n78:   });\n79:   if (out !== src) fs.writeFileSync(file, out);\n80:   minify(name);\n81: }\n82: \n83: // 3. Point every page at the minified files, with content hashes\n84: function walk(dir) {\n85:   return fs.readdirSync(dir, { withFileTypes: true }).flatMap((d) => {\n86:     const p = path.join(dir, d.name);\n87:     if (d.isDirectory()) return SKIP_DIRS.has(d.name) ? [] : walk(p);\n88:     return d.name.endsWith('.html') ? [p] : [];\n89:   });\n90: }\n91: const TAG = /<script\\b[^>]*\\ssrc=\"(\\/?)js\\/([A-Za-z0-9._-]+?)(?:\\.min)?\\.js(?:\\?v=[^\"]*)?\"[^>]*>/g;\n92: let pagesChanged = 0;\n93: const missing = new Set();\n94: for (const file of walk(FE)) {\n95:   const html = fs.readFileSync(file, 'utf8');\n96:   const out = html.replace(TAG, (tag, slash, name) => {\n97:     const rel = `js/${name}.min.js`;\n98:     const v = versionOf(rel);\n99:     if (!v) { missing.add(`${path.relative(FE, file)} -> js/${name}.js`); return tag; }\n100:     return tag.replace(/src=\"[^\"]*\"/, `src=\"${slash}${rel}?v=${v}\"`);"}
