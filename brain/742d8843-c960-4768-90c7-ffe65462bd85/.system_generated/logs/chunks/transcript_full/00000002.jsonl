 {\n86:       pendingSpace = true;\n87:       i++;\n88:       continue;\n89:     }\n90:     emit(c);\n91:     i++;\n92:   }\n93:   return out.trim() + '\\n';\n94: }\n95: \n96: function bundleCss(files) {\n97:   const hoisted = [];\n98:   const body = files.map((rel) => {\n99:     let css = fs.readFileSync(path.join(FE, rel), 'utf8').replace(/^﻿/, '');\n100:     // @charset / @import must stay at the very top of the combined file"}
