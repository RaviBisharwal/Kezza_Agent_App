xception(status_code=409, detail=\"Invoice amount does not match the saved invoice\")\n258:         if payload.invoice_number and re.sub(r\"\\s+\", \"\", payload.invoice_number).casefold() != sale.invoice_number_normalized:\n259:             raise HTTPException(status_code=409, detail=\"Invoice number does not match the saved invoice\")\n260:     else:\n261:         if not payload.invoice_number or payload.invoice_amount_paise is None:\n262:             raise HTTPException(status_code=422, detail=\"Invoice number and invoice amount are required for a new invoice\")\n263:         normalized = re.sub(r\"\\s+\", \"\", payload.invoice_number).casefold()\n264:         sale = db.scalar(select(Sale).where(Sale.branch_id == payload.branch_id,\n265:                                             Sale.invoice_number_normalized == normalized).with_for_update())\n266:         if sale:\n267:             if sale.agent_id != user.id or sale.referral_id != referral.id or sale.invoice_amount_paise != payload.invoice_amount_paise:\n268:                 raise HTTPException(status_code=409, detail=\"Invoice number is already linked to another sale\")\n269:         else:\n270:             sale = Sale(referral_id=referral.id, agent_id=user.id, branch_id=payload.branch_id,\n271:                         service_id=payload.service_id or referral.service_id,\n272:                         invoice_number=payload.invoice_number.strip(), invoice_number_normalized=normalized,\n273:                         invoice_amount_paise=payload.invoice_amount_paise)\n274:             db.add(sale)\n275:             db.flush()\n276:     if payload.claimed_amount_paise > sale.invoice_amount_paise:\n277:         raise HTTPException(status_code=422, detail=\"Claimed collection cannot exceed the invoice amount\")\n278:     reserved = db.scalar(select(func.coalesce(func.sum(PaymentRequest.claimed_amount_paise), 0)).where(\n279:         PaymentRequest.sale_id == sale.id,\n280:         PaymentRequest.status.in_((\"submitted\", \"under_review\", \"needs_information\", \"resubmitted\", \"approved\")),\n281:     )) or 0\n282:     if reserved + payload.claimed_amount_paise > sale.invoice_amount_paise:\n283:         raise HTTPException(status_code=409, detail=\"This collection plus earlier claims would exceed the invoice total\")\n284:     payment = PaymentRequest(\n285:         request_ref=f\"PC-{uuid.uuid4().hex[:10].upper()}\", referral_id=referral.id, sale_id=sale.id,\n286:         agent_id=user.id, branch_id=payload.branch_id, service_id=payload.service_id or sale.service_id,\n287:         claimed_amount_paise=payload.claimed_amount_paise, payment_date=payload.payment_date,\n288:         payment_method=payload.payment_method, transaction_reference=payload.transaction_reference,\n289:         status=\"submitted\", agent_notes=payload.agent_notes, idempotency_key=payload.idempotency_key,\n290:         submitted_at=utcnow(),\n291:     )\n292:     db.add(payment)\n293:     db.flush()\n294:     reviewer_query = select(User).where(User.status == \"active\", User.role.in_((\"branch_reviewer\", \"finance_reviewer\", \"operations_admin\")))\n295:     reviewer_query = reviewer_query.where((User.branch_id == payload.branch_id) | (User.role == \"operations_admin\"))\n296:     reviewers = db.scalars(reviewer_query).all()\n297:     for reviewer in reviewers:\n298:         notify(db, user_id=reviewer.id, event_type=\"payment.submitted\", title=\"Payment claim submitted\",\n299:                body=f\"A payment claim {payment.request_ref} is ready for review.\", entity_type=\"payment_request\", entity_id=payment.id)\n300:     audit(db, actor_id=user.id, action=\"payment_claim.submitted\", entity_type=\"payment_request\", entity_id=payment.id,\n301:           after={\"reference\": payment.request_ref, \"claimed_amount_paise\": payment.claimed_amount_paise, \"sale_id\": str(sale.id)},\n302:           request_id=request.headers.get(\"x-request-id\"))\n303:     try:\n304:         db.commit()\n305:     except IntegrityError:\n306:         db.rollback()\n307:         raise HTTPException(status_code=409, detail=\"This invoice or payment claim was submitted already\") from None\n308:     db.refresh(payment)\n309:     return _payment_json(payment, sale)\n310: \n311: \n312: @router.get(\"/agent/payments/claims/{payment_id}\")\n313: def payment_detail(payment_id: uuid.UUID, user: User = Depends(agent_only), db: Session = Depends(get_db)) -> dict:\n314:     payment = _payment_access(db, payment_id, user)\n315:     sale = db.get(Sale, payment.sale_id)\n316:     decisions = db.scalars(select(PaymentDecision).where(PaymentDecision.payment_request_id == payment.id)\n317:                            .order_by(PaymentDecision.created_at.asc())).all()\n318:     evidence = db.scalars(select(PaymentEvidence).where(PaymentEvidence.payment_request_id == payment.id)\n319:                           .order_by(PaymentEvidence.created_at.asc())).all()\n320:     return {**_payment_json(payment, sale),\n321:             \"evidence\": [{\"id\": str(item.id), \"name\": item.original_name, \"content_type\": item.content_type,\n322:                           \"size_bytes\": item.size_bytes, \"created_at\": item.created_at.isoformat()} for item in evidence],\n323:             \"decisions\": [{\"decision\": item.decision, \"reason\": item.reason,\n324:                            \"approved_amount_paise\": item.approved_amount_paise,\n325:                            \"created_at\": item.created_at.isoformat()} for item in decisions]}\n326: \n327: \n328: @router.post(\"/agent/payments/claims/{payment_id}/evidence\", status_code=201)\n329: async def upload_evidence(payment_id: uuid.UUID, file: UploadFile = File(...),\n330:                           user: User = Depends(agent_only), db: Session = Depends(get_db)) -> dict:\n331:     payment = _payment_access(db, payment_id, user)\n332:     if payment.status not in {\"submitted\", \"needs_information\", \"resubmitted\"}:\n333:         raise HTTPException(status_code=409, detail=\"Evidence cannot be changed after a final decision\")\n334:     allowed_types = {\"image/jpeg\": \".jpg\", \"image/png\": \".png\", \"application/pdf\": \".pdf\"}\n335:     suffix = allowed_types.get(file.content_type or \"\")\n336:     if not suffix:\n337:         raise HTTPException(status_code=415, detail=\"Upload a JPG, PNG, or PDF receipt\")\n338:     data = await file.read(get_settings().max_upload_bytes + 1)\n339:     if not data or len(data) > get_settings().max_upload_bytes:\n340:         raise HTTPException(status_code=413, detail=\"File is empty or exceeds the 8 MB limit\")\n341:     valid = ((suffix == \".pdf\" and data.startswith(b\"%PDF-\")) or\n342:              (suffix == \".jpg\" and data.startswith(b\"\\xff\\xd8\\xff\")) or\n343:              (suffix == \".png\" and data.startswith(b\"\\x89PNG\\r\\n\\x1a\\n\")))\n344:     if not valid:\n345:         raise HTTPException(status_code=415, detail=\"The file content does not match its file type\")\n346:     settings = get_settings()\n347:     directory = Path(settings.private_upload_dir).resolve()\n348:     directory.mkdir(parents=True, exist_ok=True)\n349:     storage_name = f\"{uuid.uuid4().hex}{suffix}\"\n350:     target = directory / storage_name\n351:     target.write_bytes(data)\n352:     safe_name = re.sub(r\"[^A-Za-z0-9._ -]\", \"_\", Path(file.filename or f\"receipt{suffix}\").name)[:120]\n353:     evidence = PaymentEvidence(payment_request_id=payment.id, storage_key=storage_name,\n354:                                original_name=safe_name, content_type=file.content_type or \"application/octet-stream\",\n355:                                size_bytes=len(data), sha256_digest=hashlib.sha256(data).hexdigest(), uploaded_by_id=user.id)\n356:     db.add(evidence)\n357:     audit(db, actor_id=user.id, action=\"payment_evidence.uploaded\", entity_type=\"payment_evidence\", entity_id=evidence.id,\n358:           after={\"payment_request_id\": str(payment.id), \"size_bytes\": len(data), \"sha256\": evidence.sha256_digest})\n359:     db.commit()\n360:     return {\"id\": str(evidence.id), \"name\": evidence.original_name, \"size_bytes\": evidence.size_bytes}\n361: \n362: \n363: @router.get(\"/agent/payments/evidence/{evidence_id}\")\n364: def download_evidence(evidence_id: uuid.UUID, user: User = Depends(require_roles(\n365:         \"agent\", \"branch_reviewer\", \"finance_reviewer\", \"operations_admin\", \"super_admin\")),\n366:                       db: Session = Depends(get_db)) -> FileResponse:\n367:     evidence = db.get(PaymentEvidence, evidence_id)\n368:     if not evidence:\n369:         raise HTTPException(status_code=404, detail=\"Evidence not found\")\n370:     payment = db.get(PaymentRequest, evidence.payment_request_id)\n371:     _payment_access(db, payment.id, user)\n372:     target = (Path(get_settings().private_upload_dir).resolve() / Path(evidence.storage_key).name).resolve()\n373:     if target.parent != Path(get_settings().private_upload_dir).resolve() or not target.is_file():\n374:         raise HTTPException(status_code=404, detail=\"Evidence file is unavailable\")\n375:     return FileResponse(target, media_type=evidence.content_type, filename=evidence.original_name,\n376:                         headers={\"Cache-Control\": \"private, no-store\", \"X-Content-Type-Options\": \"nosniff\"})\n377: \n378: \n379: @router.post(\"/agent/payments/claims/{payment_id}/respond\")\n380: def respond_to_payment_request(payment_id: uuid.UUID, payload: AdditionalInfoBody, request: Request,\n381:                                user: User = Depends(agent_only), db: Session = Depends(get_db)) -> dict:\n382:     payment = _payment_access(db, payment_id, user)\n383:     if payment.status != \"needs_information\":\n384:         raise HTTPException(status_code=409, detail=\"This payment claim is not waiting for information\")\n385:     before = payment.status\n386:     payment.status = \"resubmitted\"\n387:     payment.agent_notes = ((payment.agent_notes or \"\") + f\"\\nAgent response: {payload.message}\").strip()[-500:]\n388:     payment.submitted_at = utcnow()\n389:     payment.updated_at = utcnow()\n390:     audit(db, actor_id=user.id, action=\"payment_claim.resubmitted\", entity_type=\"payment_request\", entity_id=payment.id,\n391:           before={\"status\": before}, after={\"status\": payment.status}, request_id=request.headers.get(\"x-request-id\"))\n392:     db.commit()\n393:     return {\"id\": str(payment.id), \"status\": payment.status}\n394: \n395: \n396: @router.get(\"/agent/wallet\")\n397: def get_wallet(user: User = Depends(agent_only), db: Session = Depends(get_db)) -> dict:\n398:     entries = db.scalars(select(RewardLedgerEntry).where(RewardLedgerEntry.agent_id == user.id)\n399:                          .order_by(RewardLedgerEntry.created_at.desc()).limit(100)).all()\n400:     balance = db.scalar(select(func.coalesce(func.sum(RewardLedgerEntry.points_delta), 0)).where(\n401:         RewardLedgerEntry.agent_id == user.id)) or 0\n402:     versioned_points = db.execute(select(\n403:         RewardLedgerEntry.policy_version, func.coalesce(func.sum(RewardLedgerEntry.points_delta), 0)\n404:     ).where(RewardLedgerEntry.agent_id == user.id)\n405:      .group_by(RewardLedgerEntry.policy_version)).all()\n406:     estimate = 0\n407:     has_conversion = False\n408:     for policy_version, points in versioned_points:\n409:         policy = db.scalar(select(RewardPolicy).where(\n410:             RewardPolicy.policy_key == \"agent_referral_rewards\", RewardPolicy.version == policy_version,\n411:         ).limit(1))\n412:         if policy and policy.payout_mode != \"unselected\" and policy.points_per_reward_rupee:\n413:             estimate += int(points) * 100 // policy.points_per_reward_rupee\n414:             has_conversion = True\n415:     if not has_conversion:\n416:         estimate = None\n417:     return {\"points_balance\": balance, \"estimated_value_paise\": estimate,\n418:             \"value_disclaimer\": \"Indicative estimate only; it is not a cash or treatment-credit promise.\" if estimate is not None else None,\n419:             \"entries\": [{\"id\": str(item.id), \"cycle_id\": str(item.cycle_id), \"entry_type\": item.entry_type,\n420:                          \"points_delta\": item.points_delta, \"reason\": item.reason,\n421:                          \"created_at\": item.created_at.isoformat()} for item in entries]}\n422: \n423: \n424: @router.get(\"/agent/branches\")\n425: def list_branches(_user: User = Depends(agent_only), db: Session = Depends(get_db)) -> list[dict]:\n426:     branches = db.scalars(select(Branch).where(Branch.is_active.is_(True)).order_by(Branch.name)).all()\n427:     return [{\"id\": str(item.id), \"code\": item.code, \"name\": item.name, \"address\": item.address,\n428:              \"phone_e164\": item.phone_e164, \"hours_text\": item.hours_text, \"maps_url\": item.maps_url,\n429:              \"is_assigned\": item.id == _user.branch_id} for item in branches]\n430: \n431: \n432: @router.get(\"/agent/services\")\n433: def list_services(_user: User = Depends(agent_only), db: Session = Depends(get_db)) -> list[dict]:\n434:     services = db.scalars(select(ServiceCatalog).where(ServiceCatalog.is_active.is_(True))\n435:                           .order_by(ServiceCatalog.sort_order, ServiceCatalog.name)).all()\n436:     return [{\"id\": str(item.id), \"code\": item.code, \"name\": item.name, \"category\": item.category} for item in services]\n437: \n438: \n439: @router.get(\"/agent/legal-documents\")\n440: def list_active_documents(_user: User = Depends(agent_only), db: Session = Depends(get_db)) -> list[dict]:\n441:     docs = db.scalars(select(LegalDocument).where(LegalDocument.is_active.is_(True))\n442:                       .order_by(LegalDocument.document_type, LegalDocument.version.desc())).all()\n443:     return [{\"id\": str(item.id), \"document_type\": item.document_type, \"version\": item.version,\n444:              \"title\": item.title, \"body\": item.body, \"source_url\": item.source_url} for item in docs]\n445: \n446: \n447: @router.post(\"/agent/legal-documents/{document_id}/accept\")\n448: def accept_agent_document(document_id: uuid.UUID, request: Request,\n449:                           user: User = Depends(agent_only), db: Session = Depends(get_db)) -> dict:\n450:     document = db.get(LegalDocument, document_id)\n451:     if not document or not document.is_active or document.document_type not in {\"agent_terms\", \"privacy_notice\", \"reward_policy\"}:\n452:         raise HTTPException(status_code=404, detail=\"Active agent document not found\")\n453:     existing = db.scalar(select(PolicyAcceptance).where(PolicyAcceptance.user_id == user.id,\n454:                                                        PolicyAcceptance.document_id == document.id))\n455:     if not existing:\n456:         row = PolicyAcceptance(user_id=user.id, document_id=document.id,\n457:                                request_id=request.headers.get(\"x-request-id\"))\n458:         db.add(row)\n459:         db.flush()\n460:         audit(db, actor_id=user.id, action=\"legal_document.accepted\", entity_type=\"policy_acceptance\", entity_id=row.id,\n461:               after={\"document_id\": str(document.id), \"version\": document.version})\n462:         db.commit()\n463:     return {\"document_id\": str(document.id), \"version\": document.version, \"accepted\": True}\n464: \n465: \n466: @router.post(\"/agent/branch-change-requests\", status_code=201)\n467: def request_branch_change(payload: BranchChangeBody, request: Request,\n468:                           user: User = Depends(agent_only), db: Session = Depends(get_db)) -> dict:\n469:     branch = db.get(Branch, payload.requested_branch_id)\n470:     if not branch or not branch.is_active:\n471:         raise HTTPException(status_code=422, detail=\"Selected branch is unavailable\")\n472:     pending = db.scalar(select(BranchChangeRequest).where(BranchChangeRequest.agent_id == user.id,\n473:                                                          BranchChangeRequest.status == \"submitted\").limit(1))\n474:     if pending:\n475:         raise HTTPException(status_code=409, detail=\"A branch-change request is already waiting for review\")\n476:     row = BranchChangeRequest(agent_id=user.id, requested_branch_id=branch.id, reason=payload.reason)\n477:     db.add(row)\n478:     db.flush()\n479:     audit(db, actor_id=user.id, action=\"branch_change.requested\", entity_type=\"branch_change_request\", entity_id=row.id,\n480:           after={\"requested_branch_id\": str(branch.id)}, reason=payload.reason,\n481:           request_id=request.headers.get(\"x-request-id\"))\n482:     db.commit()\n483:     return {\"id\": str(row.id), \"status\": row.status, \"requested_branch\": branch.name}\n484: \n485: \n486: @router.post(\"/agent/feedback\", status_code=201)\n487: def submit_feedback(payload: FeedbackCreateBody, request: Request,\n488:                     user: User = Depends(agent_only), db: Session = Depends(get_db)) -> dict:\n489:     row = Feedback(user_id=user.id, category=payload.category, message=payload.message,\n490:                    rating=payload.rating, contact_permission=payload.contact_permission)\n491:     db.add(row)\n492:     db.flush()\n493:     audit(db, actor_id=user.id, action=\"feedback.created\", entity_type=\"feedback\", entity_id=row.id,\n494:           after={\"category\": row.category, \"rating\": row.rating}, request_id=request.headers.get(\"x-request-id\"))\n495:     db.commit()\n496:     return {\"id\": str(row.id), \"status\": row.status, \"created_at\": row.created_at.isoformat()}\n497: \n498: \n499: @router.get(\"/agent/notifications\")\n500: def list_notifications(user: User = Depends(agent_only), db: Session = Depends(get_db)) -> list[dict]:\n501:     rows = db.scalars(select(Notification).where(Notification.user_id == user.id)\n502:                       .order_by(Notification.created_at.desc()).limit(100)).all()\n503:     return [{\"id\": str(item.id), \"event_type\": item.event_type, \"title\": item.title,\n504:              \"body\": item.body, \"read\": item.read_at is not None, \"created_at\": item.created_at.isoformat()} for item in rows]\n505: \n506: \n507: @router.post(\"/agent/notifications/{notification_id}/read\")\n508: def mark_notification_read(notification_id: uuid.UUID, user: User = Depends(agent_only),\n509:                            db: Session = Depends(get_db)) -> dict:\n510:     row = db.get(Notification, notification_id)\n511:     if not row or row.user_id != user.id:\n512:         raise HTTPException(status_code=404, detail=\"Notification not found\")\n513:     if row.read_at is None:\n514:         row.read_at = utcnow()\n515:         db.commit()\n516:     return {\"id\": str(row.id), \"read\": True}"}
