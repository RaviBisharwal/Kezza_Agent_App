: int = Field(default=10, ge=1, le=10000)\n141:     payout_mode: Literal[\"unselected\", \"cash\", \"treatment_credit\", \"hybrid\"] = \"unselected\"\n142:     threshold_mode: Literal[\"unselected\", \"all_eligible_sales\", \"only_after_threshold\"] = \"unselected\"\n143:     late_approval_mode: Literal[\"unselected\", \"include_in_cycle\", \"approve_no_points\", \"require_rejection\"] = \"unselected\"\n144:     eligible_sales_basis: Literal[\"approved_collected_net\"] = \"approved_collected_net\"\n145:     expires_unused_points: bool = True\n146:     reason: str = Field(min_length=5, max_length=500)\n147: \n148: \n149: class CycleCreateBody(BaseModel):\n150:     name: str = Field(min_length=4, max_length=80)\n151:     policy_id: UUID\n152:     starts_at: datetime\n153:     ends_at: datetime\n154: \n155:     @field_validator(\"starts_at\", \"ends_at\")\n156:     @classmethod\n157:     def require_timezone(cls, value: datetime) -> datetime:\n158:         if value.tzinfo is None or value.utcoffset() is None:\n159:             raise ValueError(\"cycle boundaries must include a timezone\")\n160:         return value\n161: \n162: \n163: class CycleCloseBody(BaseModel):\n164:     confirmation: str = Field(pattern=r\"^CLOSE$\", description=\"The explicit confirmation word CLOSE is required.\")\n165:     reason: str = Field(min_length=5, max_length=500)\n166: \n167: \n168: class CycleExpiryBody(BaseModel):\n169:     confirmation: str = Field(pattern=r\"^EXPIRE$\")\n170:     reason: str = Field(min_length=5, max_length=500)\n171: \n172: \n173: class SettlementCreateBody(BaseModel):\n174:     agent_id: UUID\n175:     external_reference: str | None = Field(default=None, max_length=120)\n176:     reason: str = Field(min_length=5, max_length=500)\n177: \n178: \n179: class SettlementMarkBody(BaseModel):\n180:     external_reference: str = Field(min_length=3, max_length=120)\n181:     confirmation: str = Field(pattern=r\"^SETTLED$\")\n182:     reason: str = Field(min_length=5, max