basis\": policy.eligible_sales_basis,\n565:                 \"expires_unused_points\": policy.expires_unused_points}\n566:     cycle = RewardCycle(name=payload.name.strip(), policy_id=policy.id, starts_at=payload.starts_at,\n567:                         ends_at=payload.ends_at, threshold_paise=policy.threshold_paise,\n568:                         status=status_value, policy_snapshot=snapshot, created_by_id=user.id)\n569:     db.add(cycle)\n570:     db.flush()\n571:     audit(db, actor_id=user.id, action=\"reward_cycle.created\", entity_type=\"reward_cycle\", entity_id=cycle.id,\n572:           after={\"name\": cycle.name, \"starts_at\": cycle.starts_at.isoformat(), \"ends_at\": cycle.ends_at.isoformat(),\n573:                  \"policy_version\": policy.version}, request_id=request.headers.get(\"x-request-id\"))\n574:     try:\n575:         db.commit()\n576:     except IntegrityError:\n577:         db.rollback()\n578:         raise HTTPException(status_code=409, detail=\"Cycle name conflicts with an existing cycle\") from None\n579:     return {\"id\": str(cycle.id), \"name\": cycle.name, \"status\": cycle.status,\n580:             \"starts_at\": cycle.starts_at.isoformat(), \"ends_at\": cycle.ends_at.isoformat()}\n581: \n582: \n583: @router.get(\"/cycles\")\n584: def list_cycles(_user: User = Depends(admin_reader), db: Session = Depends(get_db)) -> list[dict]:\n585:     rows = db.scalars(select(RewardCycle).order_by(RewardCycle.starts_at.desc())).all()\n586:     return [{\"id\": str(row.id), \"name\": row.name, \"status\": row.status,\n587:              \"starts_at\": row.starts_at.isoformat(), \"ends_at\": row.ends_at.isoformat(),\n588:              \"threshold_paise\": row.threshold_paise, \"policy_snapshot\": row.policy_snapshot} for row in rows]\n589: \n590: \n591: @router.get(\"/cycles/{cycle_id}/preview\")\n592: def preview_cycle(cycle_id: uuid.UUID, _user: User = Depends(admin_reader), db: Session = Depends(get_db)) -> dict:\n593:     cycle = db.get(RewardCycle, cycle_id)\n594:     if not cycle:\n595:         raise HTTPException(status_code=404, detail=\"Reward cycle not found\")\n596:     rows = _cycle_summary(db, cycle)\n597:     if not _is_global_admin(_user):\n598:         if _user.branch_id is None:\n599:             raise HTTPException(status_code=403, detail=\"Your account is missing a branch assignment\")\n600:         rows = [row for row in rows if row[\"branch_id\"] == str(_user.branch_id)]\n601:     return {\"cycle_id\": str(cycle.id), \"name\": cycle.name, \"status\": cycle.status,\n602:             \"starts_at\": cycle.starts_at.isoformat(), \"ends_at\": cycle.ends_at.isoformat(),\n603:             \"preview_only\": True, \"label\": \"Indicative reward preview; not a payout instruction.\", \"agents\": rows}\n604: \n605: \n606: @router.post(\"/cycles/{cycle_id}/close\")\n607: def close_cycle(cycle_id: uuid.UUID, payload: CycleCloseBody, request: Request,\n608:                 user: User = Depends(require_roles(\"operations_admin\", \"super_admin\")),\n609:                 db: Session = Depends(get_db)) -> dict:\n610:     _require_global_admin(user)\n611:     cycle = db.scalar(select(RewardCycle).where(RewardCycle.id == cycle_id).with_for_update())\n612:     if not cycle:\n613:         raise HTTPException(status_code=404, detail=\"Reward cycle not found\")\n614:     if cycle.status == \"closed\":\n615:         raise HTTPException(status_code=409, detail=\"This cycle is already closed\")\n616:     if utcnow() < cycle.ends_at:\n617:         raise HTTPException(status_code=409, detail=\"A reward cycle cannot close before its configured end date\")\n618:     policy = db.get(RewardPolicy, cycle.policy_id)\n619:     if (not policy or policy.status != \"approved\" or policy.payout_mode == \"unselected\"\n620:             or policy.threshold_mode == \"unselected\" or policy.late_approval_mode == \"unselected\"):\n621:         raise HTTPException(status_code=409, detail=\"The reward policy is not approved for cycle close\")\n622:     pending = db.scalar(select(func.count()).select_from(PaymentRequest).where(\n623:         PaymentRequest.payment_date >= cycle.starts_at, PaymentRequest.payment_date < cycle.ends_at,\n624:         PaymentRequest.status.in_((\"submitted\", \"under_review\", \"needs_information\", \"resubmitted\")))) or 0\n625:     if pending:\n626:         raise HTTPException(status_code=409, detail=f\"{pending} payment claim(s) in the cycle still need a decision\")\n627:     summary = _cycle_summary(db, cycle)\n628:     for item in summary:\n629:         if not item[\"threshold_met\"] or item[\"points\"] <= 0:\n630:             continue\n631:         exists = db.scalar(select(CycleSettlement.id).where(\n632:             CycleSettlement.cycle_id == cycle.id, CycleSettlement.agent_id == uuid.UUID(item[\"agent_id\"])))\n633:         if not exists:\n634:             db.add(CycleSettlement(cycle_id=cycle.id, agent_id=uuid.UUID(item[\"agent_id\"]),\n635:                 points=item[\"points\"], reward_value_paise=item[\"estimated_value_paise\"],\n636:                 payout_mode=policy.payout_mode, status=\"eligible\", created_by_id=user.id))\n637:     cycle.status = \"closed\"\n638:     cycle.closed_at = utcnow()\n639:     cycle.closed_by_id = user.id\n640:     cycle.close_preview = {\"agent_count\": len(summary), \"threshold_met_count\": sum(1 for row in summary if row[\"threshold_met\"]),\n641:                            \"agents\": summary, \"closed_by\": str(user.id), \"reason\": payload.reason}\n642:     audit(db, actor_id=user.id, action=\"reward_cycle.closed\", entity_type=\"reward_cycle\", entity_id=cycle.id,\n643:           after={\"status\": cycle.status, \"agent_count\": len(summary)}, reason=payload.reason,\n644:           request_id=request.headers.get(\"x-request-id\"))\n645:     db.commit()\n646:     return {\"id\": str(cycle.id), \"status\": cycle.status,\n647:             \"eligible_settlements\": sum(1 for row in summary if row[\"threshold_met\"] and row[\"points\"] > 0),\n648:             \"message\": \"Cycle closed and eligible records prepared; no funds were transferred.\"}\n649: \n650: \n651: @router.post(\"/cycles/{cycle_id}/expire-points\")\n652: def expire_cycle_points(cycle_id: uuid.UUID, payload: CycleExpiryBody, request: Request,\n653:                         user: User = Depends(super_admin), db: Session = Depends(get_db)) -> dict:\n654:     cycle = db.scalar(select(RewardCycle).where(RewardCycle.id == cycle_id).with_for_update())\n655:     if not cycle or cycle.status != \"closed\":\n656:         raise HTTPException(status_code=409, detail=\"Only a closed reward cycle can be considered for expiry\")\n657:     policy = db.get(RewardPolicy, cycle.policy_id)\n658:     if not policy or not policy.expires_unused_points:\n659:         raise HTTPException(status_code=409, detail=\"The approved policy does not expire unused points\")\n660:     unsettled = db.scalar(select(func.count()).select_from(CycleSettlement).where(\n661:         CycleSettlement.cycle_id == cycle.id, CycleSettlement.status.in_((\"eligible\", \"approved\")))) or 0\n662:     if unsettled:\n663:         raise HTTPException(status_code=409, detail=\"Settle or formally cancel cycle settlement records before expiring points\")\n664:     rows = db.execute(select(RewardLedgerEntry.agent_id,\n665:                              func.coalesce(func.sum(RewardLedgerEntry.points_delta), 0))\n666:                       .where(RewardLedgerEntry.cycle_id == cycle.id)\n667:                       .group_by(RewardLedgerEntry.agent_id)).all()\n668:     expired_total = 0\n669:     for agent_id, balance in rows:\n670:         if balance <= 0:\n671:             continue\n672:         idempotency_key = f\"expiry:{cycle.id}:{agent_id}\"\n673:         exists = db.scalar(select(RewardLedgerEntry.id).where(RewardLedgerEntry.idempotency_key == idempotency_key))\n674:         if exists:\n675:             continue\n676:         db.add(RewardLedgerEntry(agent_id=agent_id, cycle_id=cycle.id, source_type=\"reward_cycle\",\n677:             source_id=uuid.uuid4(), entry_type=\"expiry\", points_delta=-int(balance), policy_version=policy.ve"}
