questCreateBody(BaseModel):\n49:     referral_id: UUID\n50:     branch_id: UUID\n51:     service_id: UUID | None = None\n52:     sale_id: UUID | None = None\n53:     invoice_number: str | None = Field(default=None, min_length=1, max_length=100)\n54:     invoice_amount_paise: int | None = Field(default=None, gt=0, le=10_000_000_000)\n55:     claimed_amount_paise: int = Field(gt=0, le=10_000_000_000)\n56:     payment_date: datetime\n57:     payment_method: Literal[\"cash\", \"card\", \"upi\", \"bank_transfer\", \"payment_link\", \"other\"]\n58:     transaction_reference: str | None = Field(default=None, max_length=120)\n59:     agent_notes: str | None = Field(default=None, max_length=500)\n60:     idempotency_key: str = Field(min_length=8, max_length=100)\n61: \n62:     @field_validator(\"payment_date\")\n63:     @classmethod\n64:     def require_timezone(cls, value: datetime) -> datetime:\n65:         if value.tzinfo is None or value.utcoffset() is None:\n66:             raise ValueError(\"payment_date must include a timezone\")\n67:         return value\n68: \n69: \n70: class PaymentSubmitBody(BaseModel):\n71:     confirm_submission: bool\n72: \n73: \n74: class AdditionalInfoBody(BaseModel):\n75:     message: str = Field(min_length=3, max_length=500)\n76: \n77: \n78: class PaymentDecisionBody(BaseModel):\n79:     decision: Literal[\"approve\", \"reject\", \"request_information\", \"reverse\"]\n80:     approved_amount_paise: int | None = Field(default=None, ge=0, le=10_000_000_000)\n81:     reason: str | None = Field(default=None, max_length=500)\n82:     idempotency_key: str = Field(min_length=8, max_length=100)\n83: \n84: \n85: class BranchChangeBody(BaseModel):\n86:     requested_branch_id: UUID\n87:     reason: str = Field(min_length=5, max_length=300)\n88: \n89: \n90: class FeedbackCreateBody(BaseModel):\n91:     category: Literal[\"app\", \"referral\", \"payment\", \"rewards\", \"branch\", \"other\"]\n92:     message: str = Field(min_length=5, max_length=2000)\