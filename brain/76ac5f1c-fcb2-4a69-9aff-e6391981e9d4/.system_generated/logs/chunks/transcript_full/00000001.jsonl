{"step_index":17,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-17T06:44:47Z","content":"Created At: 2026-11-17T12:14:47+05:30\nCompleted At: 2026-11-17T12:14:49+05:30\nCreated At: 2026-11-17T12:14:47+05:30\nCompleted At: 2026-11-17T12:14:49+05:30\nPartial read (lines 1-800 of 973). Showing bytes 0-46080 of 54473 in this line range, truncated at the 46080-byte limit. To read the rest of this line range, call this tool again with the same StartLine and EndLine and ByteOffset=46080.\n1: import csv\n2: import io\n3: import uuid\n4: from datetime import timedelta\n5: \n6: from fastapi import APIRouter, Depends, HTTPException, Query, Request\n7: from fastapi.responses import StreamingResponse\n8: from sqlalchemy import func, select\n9: from sqlalchemy.exc import IntegrityError\n10: from sqlalchemy.orm import Session\n11: \n12: from app.audit import audit, notify\n13: from app.database import get_db\n14: from app.dependencies import require_roles\n15: from app.models import (\n16:     AgentInvitation, AppRelease, AuditLog, Branch, BranchChangeRequest, CycleSettlement,\n17:     Feedback, LegalDocument, Notification, PaymentDecision, PaymentRequest, PaymentEvidence,\n18:     Referral, RewardCycle, RewardLedgerEntry, RewardPolicy, Sale, ServiceCatalog, User,\n19: )\n20: from app.schemas import (\n21:     AdminUserCreateBody, AgentInviteBody, BranchChangeDecisionBody, BranchCreateBody,\n22:     CycleCloseBody, CycleCreateBody, CycleExpiryBody, FeedbackUpdateBody, LegalDocumentApprovalBody,\n23:     LegalDocumentCreateBody, PaymentDecisionBody, PolicyCreateBody, ReleaseCreateBody,\n24:     ServiceCreateBody, SettlementMarkBody,\n25: )\n26: from app.security import digest_secret, generate_invitation_code, utcnow\n27: \n28: router = APIRouter(prefix=\"/admin\", tags=[\"Admin portal\"])\n29: admin_reader = require_roles(\"branch_reviewer\", \"finance_reviewer\", \"operations_admin\", \"super_admin\")\n30: policy_admin = require_roles(\"operations_admin\", \"super_admin\")\n31: super_admin = require_roles(\"super_admin\")\n32: \n33: \n34: def _branch_allowed(user: User, branch_id: uuid.UUID) -> bool:\n35:     return user.role == \"super_admin\" or (user.role == \"operations_admin\" and user.branch_id is None) or user.branch_id == branch_id\n36: \n37: \n38: def _is_global_admin(user: User) -> bool:\n39:     return user.role == \"super_admin\" or (user.role == \"operations_admin\" and user.branch_id is None)\n40: \n41: \n42: def _require_global_admin(user: User) -> None:\n43:     if not _is_global_admin(user):\n44:         raise HTTPException(status_code=403, detail=\"A global operations administrator must perform this action\")\n45: \n46: \n47: def _require_branch(user: User, branch_id: uuid.UUID) -> None:\n48:     if not _branch_allowed(user, branch_id):\n49:         raise HTTPException(status_code=404, detail=\"Record not found\")\n50:     if user.role in {\"branch_reviewer\", \"finance_reviewer\", \"operations_admin\"} and user.branch_id is None and not _is_global_admin(user):\n51:         raise HTTPException(status_code=403, detail=\"Your account is missing a branch assignment\")\n52: \n53: \n54: def _payment_detail(db: Session, payment: PaymentRequest) -> dict:\n55:     sale = db.get(Sale, payment.sale_id)\n56:     referral = db.get(Referral, payment.referral_id)\n57:     agent = db.get(User, payment.agent_id)\n58:     evidence = db.scalars(select(PaymentEvidence).where(PaymentEvidence.payment_request_id == payment.id)\n59:                           .order_by(PaymentEvidence.created_at.asc())).all()\n60:     decisions = db.scalars(select(PaymentDecision).where(PaymentDecision.payment_request_id == payment.id)\n61:                            .order_by(PaymentDecision.created_at.asc())).all()\n62:     return {\n63:         \"id\": str(payment.id), \"reference\": payment.request_ref, \"status\": payment.status,\n64:         \"agent\": {\"id\": str(agent.id), \"name\": agent.full_name, \"phone_e164_masked\": f\"{agent.phone_e164[:3]}••••{agent.phone_e164[-4:]}\", \"code\": agent.agent_code} if agent else None,\n65:         \"referral_id\": str(referral.id) if referral else None, \"referral_reference\": referral.referral_ref if referral else None,\n66:         \"sale\": {\"id\": str(sale.id), \"invoice_number\": sale.invoice_number,\n67:                  \"invoice_amount_paise\": sale.invoice_amount_paise} if sale else None,\n68:         \"branch_id\": str(payment.branch_id), \"claimed_amount_paise\": payment.claimed_amount_paise,\n69:         \"approved_amount_paise\": payment.approved_amount_paise, \"payment_date\": payment.payment_date.isoformat(),\n70:         \"payment_method\": payment.payment_method, \"transaction_reference\": payment.transaction_reference,\n71:         \"agent_notes\": payment.agent_notes, \"review_reason\": payment.review_reason,\n72:         \"created_at\": payment.created_at.isoformat(), \"submitted_at\": payment.submitted_at.isoformat() if payment.submitted_at else None,\n73:         \"evidence\": [{\"id\": str(row.id), \"name\": row.original_name, \"content_type\": row.content_type,\n74:                       \"size_bytes\": row.size_bytes, \"created_at\": row.created_at.isoformat()} for row in evidence],\n75:         \"decisions\": [{\"decision\": row.decision, \"reason\": row.reason,\n76:                        \"approved_amount_paise\": row.approved_amount_paise,\n77:                        \"reviewer_id\": str(row.reviewer_id), \"created_at\": row.created_at.isoformat()} for row in decisions],\n78:     }\n79: \n80: \n81: def _award_cycle_points(db: Session, payment: PaymentRequest, cycle: RewardCycle, policy: RewardPolicy, actor: User) -> list[RewardLedgerEntry]:\n82:     # Serialize recalculation for an agent so simultaneous claim decisions cannot\n83:     # race the cycle-level points balance.\n84:     db.scalar(select(User).where(User.id == payment.agent_id).with_for_update())\n85:     approved = db.scalars(select(PaymentRequest).where(\n86:         PaymentRequest.agent_id == payment.agent_id,\n87:         PaymentRequest.cycle_id == cycle.id,\n88:         PaymentRequest.status == \"approved\",\n89:     )).all()\n90:     eligible_sales_paise = sum(\n91:         row.approved_amount_paise or 0 for row in approved\n92:         if not (policy.late_approval_mode == \"approve_no_points\"\n93:                 and row.decided_at is not None and row.decided_at >= cycle.ends_at)\n94:     )\n95:     if policy.threshold_mode == \"all_eligible_sales\":\n96:         eligible_rupees = eligible_sales_paise // 100\n97:     elif policy.threshold_mode == \"only_after_threshold\":\n98:         eligible_rupees = max(0, eligible_sales_paise - cycle.threshold_paise) // 100\n99:     else:\n100:         raise HTTPException(status_code=409, detail=\"Reward threshold rule has not been approved\")\n101:     desired_points = eligible_rupees * policy.points_per_rupee\n102:     current_points = db.scalar(select(func.coalesce(func.sum(RewardLedgerEntry.points_delta), 0)).where(\n103:         RewardLedgerEntry.agent_id == payment.agent_id,\n104:         RewardLedgerEntry.cycle_id == cycle.id,\n105:         RewardLedgerEntry.entry_type.in_((\"credit\", \"reversal\", \"adjustment\")),\n106:     )) or 0\n107:     delta = int(desired_points - current_points)\n108:     if not delta:\n109:         return []\n110: \n111:     is_new_payment_credit = delta > 0 and not db.scalar(select(RewardLedgerEntry.id).where(\n112:         RewardLedgerEntry.source_type == \"payment_request\", RewardLedgerEntry.source_id == payment.id,\n113:         RewardLedgerEntry.entry_type == \"credit\"))\n114:     if is_new_payment_credit:\n115:         entry = RewardLedgerEntry(\n116:             agent_id=payment.agent_id, cycle_id=cycle.id, payment_request_id=payment.id,\n117:             source_type=\"payment_request\", source_id=payment.id, entry_type=\"credit\", points_delta=delta,\n118:             policy_version=policy.version, reason=\"Approved eligible collected sales reconciled under the active cycle policy\",\n119:             actor_id=actor.id, idempotency_key=f\"credit:{payment.id}:{policy.version}\",\n120:         )\n121:     else:\n122:         entry = RewardLedgerEntry(\n123:             agent_id=payment.agent_id, cycle_id=cycle.id, payment_request_id=payment.id,\n124:             source_type=\"cycle_reconciliation\", source_id=uuid.uuid4(), entry_type=\"adjustment\", points_delta=delta,\n125:             policy_version=policy.version, reason=\"Cycle points reconciled after a payment decision\",\n126:             actor_id=actor.id, idempotency_key=f\"reconcile:{cycle.id}:{payment.agent_id}:{uuid.uuid4().hex}\",\n127:         )\n128:     db.add(entry)\n129:     return [entry]\n130: \n131: \n132: def _cycle_summary(db: Session, cycle: RewardCycle) -> list[dict]:\n133:     policy = db.get(RewardPolicy, cycle.policy_id)\n134:     rows = db.execute(select(PaymentRequest.agent_id, PaymentRequest.approved_amount_paise,\n135:                              PaymentRequest.decided_at)\n136:                       .where(PaymentRequest.cycle_id == cycle.id, PaymentRequest.status == \"approved\")).all()\n137:     sales_by_agent: dict[uuid.UUID, int] = {}\n138:     for agent_id, amount, decided_at in rows:\n139:         if (policy and policy.late_approval_mode == \"approve_no_points\"\n140:                 and decided_at is not None and decided_at >= cycle.ends_at):\n141:             continue\n142:         sales_by_agent[agent_id] = sales_by_agent.get(agent_id, 0) + int(amount or 0)\n143:     output = []\n144:     for agent_id, sales_paise in sales_by_agent.items():\n145:         user = db.get(User, agent_id)\n146:         points = db.scalar(select(func.coalesce(func.sum(RewardLedgerEntry.points_delta), 0)).where(\n147:             RewardLedgerEntry.agent_id == agent_id, RewardLedgerEntry.cycle_id == cycle.id,\n148:             RewardLedgerEntry.entry_type.in_((\"credit\", \"reversal\", \"adjustment\")))) or 0\n149:         eligible = sales_paise >= cycle.threshold_paise\n150:         estimate = points * 100 // policy.points_per_reward_rupee if policy and policy.points_per_reward_rupee else 0\n151:         output.append({\"agent_id\": str(agent_id), \"agent_name\": user.full_name if user else \"Unknown\",\n152:                       \"agent_code\": user.agent_code if user else None, \"branch_id\": str(user.branch_id) if user and user.branch_id else None,\n153:                       \"eligible_sales_paise\": int(sales_paise), \"threshold_paise\": cycle.threshold_paise,\n154:                       \"threshold_met\": eligible, \"points\": int(points),\n155:                       \"estimated_value_paise\": estimate if eligible else 0})\n156:     return output\n157: \n158: \n159: @router.get(\"/dashboard\")\n160: def dashboard(user: User = Depends(admin_reader), db: Session = Depends(get_db)) -> dict:\n161:     branches = db.scalars(select(Branch).order_by(Branch.name)).all()\n162:     branch_ids = [item.id for item in branches if _branch_allowed(user, item.id)]\n163:     base_users = select(func.count()).select_from(User).where(User.role == \"agent\", User.status == \"active\")\n164:     base_referrals = select(func.count()).select_from(Referral)\n165:     base_payments = select(func.count()).select_from(PaymentRequest)\n166:     if user.role != \"super_admin\" and user.branch_id is not None:\n167:         base_users = base_users.where(User.branch_id == user.branch_id)\n168:         base_referrals = base_referrals.where(Referral.branch_id == user.branch_id)\n169:         base_payments = base_payments.where(PaymentRequest.branch_id == user.branch_id)\n170:     pending = db.scalar(base_payments.where(PaymentRequest.status.in_((\"submitted\", \"under_review\", \"resubmitted\")))) or 0\n171:     agents = db.scalar(base_users) or 0\n172:     referrals = db.scalar(base_referrals) or 0\n173:     feedback = db.scalar(select(func.count()).select_from(Feedback).where(Feedback.status.in_((\"open\", \"in_progress\")))) or 0\n174:     return {\"active_agents\": agents, \"referrals\": referrals, \"pending_payment_reviews\": pending,\n175:             \"open_feedback\": feedback, \"branches\": [{\"id\": str(b.id), \"name\": b.name} for b in branches if b.id in branch_ids],\n176:             \"data_as_of\": utcnow().isoformat()}\n177: \n178: \n179: @router.get(\"/agents\")\n180: def list_agents(user: User = Depends(admin_reader), db: Session = Depends(get_db)) -> list[dict]:\n181:     query = select(User).where(User.role == \"agent\").order_by(User.created_at.desc()).limit(500)\n182:     if user.role != \"super_admin\" and user.branch_id is not None:\n183:         query = query.where(User.branch_id == user.branch_id)\n184:     rows = db.scalars(query).all()\n185:     return [{\"id\": str(row.id), \"full_name\": row.full_name, \"phone_e164_masked\": f\"{row.phone_e164[:3]}••••{row.phone_e164[-4:]}\",\n186:              \"agent_code\": row.agent_code, \"branch_id\": str(row.branch_id) if row.branch_id else None,\n187:              \"status\": row.status, \"created_at\": row.created_at.isoformat()} for row in rows]\n188: \n189: \n190: @router.post(\"/agents/invitations\", status_code=201)\n191: def invite_agent(payload: AgentInviteBody, request: Request, user: User = Depends(policy_admin),\n192:                  db: Session = Depends(get_db)) -> dict:\n193:     branch = db.get(Branch, payload.branch_id)\n194:     if not branch or not branch.is_active:\n195:         raise HTTPException(status_code=422, detail=\"Selected branch is unavailable\")\n196:     _require_branch(user, branch.id)\n197:     existing = db.scalar(select(User).where(User.phone_e164 == payload.phone_e164).with_for_update())\n198:     if existing and (existing.role != \"agent\" or existing.status != \"invited\"):\n199:         raise HTTPException(status_code=409, detail=\"This mobile number already belongs to an active or non-agent account\")\n200:     raw_code = generate_invitation_code()\n201:     agent_code = f\"KZ{uuid.uuid4().hex[:8].upper()}\"\n202:     invite = AgentInvitation(phone_e164=payload.phone_e164, token_hash=digest_secret(raw_code),\n203:                              branch_id=branch.id, agent_code=agent_code,\n204:                              expires_at=utcnow() + timedelta(days=payload.expires_in_days), created_by_id=user.id)\n205:     if existing:\n206:         existing.full_name = payload.full_name.strip()\n207:         existing.branch_id = branch.id\n208:         existing.agent_code = agent_code\n209:         existing.created_by_id = user.id\n210:     else:\n211:         existing = User(phone_e164=payload.phone_e164, full_name=payload.full_name.strip(), role=\"agent\",\n212:                         status=\"invited\", branch_id=branch.id, agent_code=agent_code, created_by_id=user.id)\n213:         db.add(existing)\n214:     db.add(invite)\n215:     db.flush()\n216:     audit(db, actor_id=user.id, action=\"agent.invited\", entity_type=\"agent_invitation\", entity_id=invite.id,\n217:           after={\"agent_id\": str(existing.id), \"branch_id\": str(branch.id), \"expires_at\": invite.expires_at.isoformat()},\n218:           request_id=request.headers.get(\"x-request-id\"))\n219:     db.commit()\n220:     return {\"invitation_id\": str(invite.id), \"agent_id\": str(existing.id), \"agent_code\": agent_code,\n221:             \"invite_code\": raw_code, \"expires_at\": invite.expires_at.isoformat(),\n222:             \"delivery\": \"Share this one-time code with the agent through Kezza's approved channel.\"}\n223: \n224: \n225: @router.post(\"/users\", status_code=201)\n226: def create_admin_user(payload: AdminUserCreateBody, request: Request,\n227:                       user: User = Depends(super_admin), db: Session = Depends(get_db)) -> dict:\n228:     if payload.branch_id:\n229:         branch = db.get(Branch, payload.branch_id)\n230:         if not branch or not branch.is_active:\n231:             raise HTTPException(status_code=422, detail=\"Selected branch is unavailable\")\n232:     elif payload.role != \"operations_admin\":\n233:         raise HTTPException(status_code=422, detail=\"Branch reviewer and finance reviewer accounts need a branch\")\n234:     existing = db.scalar(select(User.id).where(User.phone_e164 == payload.phone_e164))\n235:     if existing:\n236:         raise HTTPException(status_code=409, detail=\"An account already uses this mobile number\")\n237:     row = User(phone_e164=payload.phone_e164, full_name=payload.full_name.strip(), email=str(payload.email) if payload.email else None,\n238:                role=payload.role, status=\"active\", branch_id=payload.branch_id, created_by_id=user.id)\n239:     db.add(row)\n240:     db.flush()\n241:     audit(db, actor_id=user.id, action=\"admin_user.created\", entity_type=\"user\", entity_id=row.id,\n242:           after={\"role\": row.role, \"branch_id\": str(row.branch_id) if row.branch_id else None},\n243:           request_id=request.headers.get(\"x-request-id\"))\n244:     db.commit()\n245:     return {\"id\": str(row.id), \"full_name\": row.full_name, \"role\": row.role,\n246:             \"phone_e164_masked\": f\"{row.phone_e164[:3]}••••{row.phone_e164[-4:]}\"}\n247: \n248: \n249: @router.get(\"/payment-reviews\")\n250: def payment_review_queue(status_filter: str | None = Query(default=None, alias=\"status\"),\n251:                          user: User = Depends(admin_reader), db: Session = Depends(get_db)) -> list[dict]:\n252:     query = select(PaymentRequest).where(PaymentRequest.status.in_((\"submitted\", \"under_review\", \"needs_information\", \"resubmitted\")))\n253:     if status_filter:\n254:         query = query.where(PaymentRequest.status == status_filter)\n255:     if user.role != \"super_admin\" and user.branch_id is not None:\n256:         query = query.where(PaymentRequest.branch_id == user.branch_id)\n257:     rows = db.scalars(query.order_by(PaymentRequest.submitted_at.asc()).limit(500)).all()\n258:     return [_payment_detail(db, row) for row in rows]\n259: \n260: \n261: @router.get(\"/payment-reviews/{payment_id}\")\n262: def payment_review_detail(payment_id: uuid.UUID, user: User = Depends(admin_reader), db: Session = Depends(get_db)) -> dict:\n263:     payment = db.get(PaymentRequest, payment_id)\n264:     if not payment:\n265:         raise HTTPException(status_code=404, detail=\"Payment claim not found\")\n266:     _require_branch(user, payment.branch_id)\n267:     return _payment_detail(db, payment)\n268: \n269: \n270: @router.post(\"/payment-reviews/{payment_id}/decision\")\n271: def decide_payment(payment_id: uuid.UUID, payload: PaymentDecisionBody, request: Request,\n272:                    user: User = Depends(admin_reader), db: Session = Depends(get_db)) -> dict:\n273:     payment = db.scalar(select(PaymentRequest).where(PaymentRequest.id == payment_id).with_for_update())\n274:     if not payment:\n275:         raise HTTPException(status_code=404, detail=\"Payment claim not found\")\n276:     _require_branch(user, payment.branch_id)\n277:     if payment.agent_id == user.id:\n278:         raise HTTPException(status_code=403, detail=\"You cannot review your own payment claim\")\n279:     duplicate = db.scalar(select(PaymentDecision).where(PaymentDecision.idempotency_key == payload.idempotency_key))\n280:     if duplicate:\n281:         if duplicate.payment_request_id != payment.id or duplicate.reviewer_id != user.id:\n282:             raise HTTPException(status_code=409, detail=\"This decision key has already been used\")\n283:         return {\"id\": str(payment.id), \"status\": payment.status, \"replayed\": True}\n284:     now = utcnow()\n285:     before = payment.status\n286:     if payload.decision == \"approve\":\n287:         if user.role not in {\"finance_reviewer\", \"super_admin\"}:\n288:             raise HTTPException(status_code=403, detail=\"A finance reviewer must approve collected payment claims\")\n289:         if payment.status not in {\"submitted\", \"under_review\", \"resubmitted\"}:\n290:             raise HTTPException(status_code=409, detail=\"This claim is not ready for approval\")\n291:         if not payload.reason or len(payload.reason.strip()) < 5:\n292:             raise HTTPException(status_code=422, detail=\"A decision reason is required\")\n293:         evidence_count = db.scalar(select(func.count()).select_from(PaymentEvidence).where(\n294:             PaymentEvidence.payment_request_id == payment.id)) or 0\n295:         if evidence_count == 0:\n296:             raise HTTPException(status_code=409, detail=\"Upload and review at least one payment receipt before approval\")\n297:         amount = payload.approved_amount_paise if payload.approved_amount_paise is not None else payment.claimed_amount_paise\n298:         if amount <= 0 or amount > payment.claimed_amount_paise:\n299:             raise HTTPException(status_code=422, detail=\"Approved amount must be positive and no greater than the claim\")\n300:         sale = db.get(Sale, payment.sale_id)\n301:         already_approved = db.scalar(select(func.coalesce(func.sum(PaymentRequest.approved_amount_paise), 0)).where(\n302:             PaymentRequest.sale_id == sale.id, PaymentRequest.status == \"approved\", PaymentRequest.id != payment.id)) or 0\n303:         if already_approved + amount > sale.invoice_amount_paise:\n304:             raise HTTPException(status_code=409, detail=\"Approved collections would exceed the invoice total\")\n305:         cycle = db.scalar(select(RewardCycle).where(\n306:             RewardCycle.starts_at <= payment.payment_date, RewardCycle.ends_at > payment.payment_date,\n307:             RewardCycle.status.in_((\"open\", \"scheduled\")),\n308:         ).with_for_update().limit(1))\n309:         if not cycle:\n310:             raise HTTPException(status_code=409, detail=\"No open, configured reward cycle covers this payment date\")\n311:         if payment.payment_date > now or now < cycle.starts_at:\n312:             raise HTTPException(status_code=409, detail=\"This payment cannot be approved before its collection date and cycle start\")\n313:         policy = db.get(RewardPolicy, cycle.policy_id)\n314:         if (not policy or policy.status != \"approved\" or policy.payout_mode == \"unselected\"\n315:                 or policy.threshold_mode == \"unselected\" or policy.late_approval_mode == \"unselected\"):\n316:             raise HTTPException(status_code=409, detail=\"The reward policy is not approved for payment awards\")\n317:         if policy.points_per_rupee <= 0 or policy.points_per_reward_rupee <= 0:\n318:             raise HTTPException(status_code=409, detail=\"The reward point conversion is not configured\")\n319:         late = now >= cycle.ends_at\n320:         if late and policy.late_approval_mode == \"require_rejection\":\n321:             raise HTTPException(status_code=409, detail=\"This policy requires late payment claims to be rejected\")\n322:         if cycle.status == \"scheduled\" and now < cycle.ends_at:\n323:             cycle.status = \"open\"\n324:         payment.approved_amount_paise = amount\n325:         payment.status = \"approved\"\n326:         payment.review_reason = payload.reason.strip()\n327:         payment.cycle_id = cycle.id\n328:         payment.decided_at = now\n329:         payment.updated_at = now\n330:         referral = db.get(Referral, payment.referral_id)\n331:         if referral and referral.status != \"converted\":\n332:             referral.status = \"converted\"\n333:             referral.updated_at = now\n334:         ledger_entries = [] if late and policy.late_approval_mode == \"approve_no_points\" else _award_cycle_points(db, payment, cycle, policy, user)\n335:         notify(db, user_id=payment.agent_id, event_type=\"payment.approved\", title=\"Payment claim approved\",\n336:                body=f\"Claim {payment.request_ref} has been approved. Your wallet shows any points awarded.\",\n337:                entity_type=\"payment_request\", entity_id=payment.id)\n338:     elif payload.decision == \"request_information\":\n339:         if payment.status not in {\"submitted\", \"under_review\", \"resubmitted\"}:\n340:             raise HTTPException(status_code=409, detail=\"This claim cannot be returned for information\")\n341:         if not payload.reason or len(payload.reason.strip()) < 5:\n342:             raise HTTPException(status_code=422, detail=\"Explain what information is required\")\n343:         payment.status = \"needs_information\"\n344:         payment.review_reason = payload.reason.strip()\n345:         payment.updated_at = now\n346:         ledger_entries = []\n347:         notify(db, user_id=payment.agent_id, event_type=\"payment.needs_information\", title=\"More information required\",\n348:                body=f\"Claim {payment.request_ref} needs information. Open the claim to review the request.\",\n349:                entity_type=\"payment_request\", entity_id=payment.id)\n350:     elif payload.decision == \"reject\":\n351:         if payment.status not in {\"submitted\", \"under_review\", \"resubmitted\"}:\n352:             raise HTTPException(status_code=409, detail=\"This claim cannot be rejected in its current status\")\n353:         if not payload.reason or len(payload.reason.strip()) < 5:\n354:             raise HTTPException(status_code=422, detail=\"A rejection reason is required\")\n355:         payment.status = \"rejected\"\n356:         payment.review_reason = payload.reason.strip()\n357:         payment.decided_at = now\n358:         payment.updated_at = now\n359:         ledger_entries = []\n360:         notify(db, user_id=payment.agent_id, event_type=\"payment.rejected\", title=\"Payment claim not approved\",\n361:                body=f\"Claim {payment.request_ref} was not approved. See the reason in the app.\",\n362:                entity_type=\"payment_request\", entity_id=payment.id)\n363:     else:\n364:         if user.role not in {\"finance_reviewer\", \"super_admin\"}:\n365:             raise HTTPException(status_code=403, detail=\"A finance reviewer must record a payment reversal\")\n366:         if payment.status != \"approved\":\n367:             raise HTTPException(status_code=409, detail=\"Only approved payment claims can be reversed\")\n368:         approved_cycle = db.get(RewardCycle, payment.cycle_id) if payment.cycle_id else None\n369:         if approved_cycle and approved_cycle.status == \"closed\":\n370:             raise HTTPException(status_code=409, detail=\"Reversals after cycle close require a Kezza-approved policy rule\")\n371:         if not payload.reason or len(payload.reason.strip()) < 5:\n372:             raise HTTPException(status_code=422, detail=\"A reversal reason is required\")\n373:         credits = db.scalars(select(RewardLedgerEntry).where(\n374:             RewardLedgerEntry.source_type == \"payment_request\", RewardLedgerEntry.source_id == payment.id,\n375:             RewardLedgerEntry.entry_type == \"credit\")).all()\n376:         for credit in credits:\n377:             existing_reversal = db.scalar(select(RewardLedgerEntry.id).where(\n378:                 RewardLedgerEntry.source_type == \"payment_request\", RewardLedgerEntry.source_id == payment.id,\n379:                 RewardLedgerEntry.entry_type == \"reversal\", RewardLedgerEntry.reversal_of_id == credit.id))\n380:             if not existing_reversal and credit.points_delta:\n381:                 db.add(RewardLedgerEntry(agent_id=credit.agent_id, cycle_id=credit.cycle_id,\n382:                     payment_request_id=payment.id, source_type=\"payment_request\", source_id=payment.id,\n383:                     entry_type=\"reversal\", points_delta=-credit.points_delta, policy_version=credit.policy_version,\n384:                     reason=payload.reason.strip(), actor_id=user.id,\n385:                     idempotency_key=f\"reversal:{credit.id}\", reversal_of_id=credit.id))\n386:         payment.status = \"reversed\"\n387:         payment.review_reason = payload.reason.strip()\n388:         payment.decided_at = now\n389:         payment.updated_at = now\n390:         ledger_entries = []\n391:         if approved_cycle:\n392:             policy = db.get(RewardPolicy, approved_cycle.policy_id)\n393:             if policy:\n394:                 ledger_entries = _award_cycle_points(db, payment, approved_cycle, policy, user)\n395:         notify(db, user_id=payment.agent_id, event_type=\"payment.reversed\", title=\"Payment claim reversed\",\n396:                body=f\"Claim {payment.request_ref} was reversed. See the wallet ledger for the adjustment.\",\n397:                entity_type=\"payment_request\", entity_id=payment.id)\n398:     decision = PaymentDecision(payment_request_id=payment.id, reviewer_id=user.id, prior_status=before,\n399:                                decision=payload.decision, approved_amount_paise=payment.approved_amount_paise if payload.decision == \"approve\" else None,\n400:                                reason=payload.reason, idempotency_key=payload.idempotency_key)\n401:     db.add(decision)\n402:     audit(db, actor_id=user.id, action=f\"payment_claim.{payload.decision}\", entity_type=\"payment_request\", entity_id=payment.id,\n403:           before={\"status\": before}, after={\"status\": payment.status,\n404:           \"approved_amount_paise\": payment.approved_amount_paise if payload.decision == \"approve\" else None,\n405:           \"reward_entries_created\": len(ledger_entries)}, reason=payload.reason,\n406:           request_id=request.headers.get(\"x-request-id\"))\n407:     try:\n408:         db.commit()\n409:     except IntegrityError:\n410:         db.rollback()\n411:         raise HTTPException(status_code=409, detail=\"The payment decision conflicted with another review\") from None\n412:     return {\"id\": str(payment.id), \"status\": payment.status,\n413:             \"approved_amount_paise\": payment.approved_amount_paise,\n414:             \"reward_points_created\": sum(entry.points_delta for entry in ledger_entries)}\n415: \n416: \n417: @router.get(\"/branches\")\n418: def list_branches(user: User = Depends(admin_reader), db: Session = Depends(get_db)) -> list[dict]:\n419:     rows = db.scalars(select(Branch).order_by(Branch.name)).all()\n420:     return [{\"id\": str(row.id), \"code\": row.code, \"name\": row.name, \"address\": row.address,\n421:              \"phone_e164\": row.phone_e164, \"hours_text\": row.hours_text, \"maps_url\": row.maps_url,\n422:              \"is_active\": row.is_active} for row in rows if _branch_allowed(user, row.id)]\n423: \n424: \n425: @router.post(\"/branches\", status_code=201)\n426: def create_branch(payload: BranchCreateBody, request: Request, user: User = Depends(policy_admin),\n427:                   db: Session = Depends(get_db)) -> dict:\n428:     _require_global_admin(user)\n429:     row = Branch(**payload.model_dump())\n430:     db.add(row)\n431:     db.flush()\n432:     audit(db, actor_id=user.id, action=\"branch.created\", entity_type=\"branch\", entity_id=row.id,\n433:           after={\"code\": row.code, \"name\": row.name}, request_id=request.headers.get(\"x-request-id\"))\n434:     try:\n435:         db.commit()\n436:     except IntegrityError:\n437:         db.rollback()\n438:         raise HTTPException(status_code=409, detail=\"Branch code or name already exists\") from None\n439:     return {\"id\": str(row.id), \"code\": row.code, \"name\": row.name}\n440: \n441: \n442: @router.patch(\"/branches/{branch_id}/active\")\n443: def set_branch_active(branch_id: uuid.UUID, request: Request, active: bool,\n444:                       reason: str = Query(min_length=5, max_length=500),\n445:                       user: User = Depends(policy_admin), db: Session = Depends(get_db)) -> dict:\n446:     _require_global_admin(user)\n447:     row = db.get(Branch, branch_id)\n448:     if not row:\n449:         raise HTTPException(status_code=404, detail=\"Branch not found\")\n450:     before = row.is_active\n451:     row.is_active = active\n452:     audit(db, actor_id=user.id, action=\"branch.active_changed\", entity_type=\"branch\", entity_id=row.id,\n453:           before={\"is_active\": before}, after={\"is_active\": active}, reason=reason,\n454:           request_id=request.headers.get(\"x-request-id\") if request else None)\n455:     db.commit()\n456:     return {\"id\": str(row.id), \"is_active\": row.is_active}\n457: \n458: \n459: @router.get(\"/services\")\n460: def list_services(_user: User = Depends(admin_reader), db: Session = Depends(get_db)) -> list[dict]:\n461:     rows = db.scalars(select(ServiceCatalog).order_by(ServiceCatalog.sort_order, ServiceCatalog.name)).all()\n462:     return [{\"id\": str(row.id), \"code\": row.code, \"name\": row.name, \"category\": row.category,\n463:              \"is_active\": row.is_active, \"sort_order\": row.sort_order} for row in rows]\n464: \n465: \n466: @router.post(\"/services\", status_code=201)\n467: def create_service(payload: ServiceCreateBody, request: Request, user: User = Depends(policy_admin),\n468:                    db: Session = Depends(get_db)) -> dict:\n469:     _require_global_admin(user)\n470:     row = ServiceCatalog(**payload.model_dump())\n471:     db.add(row)\n472:     db.flush()\n473:     audit(db, actor_id=user.id, action=\"service.created\", entity_type=\"service\", entity_id=row.id,\n474:           after={\"code\": row.code, \"name\": row.name}, request_id=request.headers.get(\"x-request-id\"))\n475:     try:\n476:         db.commit()\n477:     except IntegrityError:\n478:         db.rollback()\n479:         raise HTTPException(status_code=409, detail=\"Service code or name already exists\") from None\n480:     return {\"id\": str(row.id), \"code\": row.code, \"name\": row.name}\n481: \n482: \n483: @router.post(\"/policies\", status_code=201)\n484: def create_policy(payload: PolicyCreateBody, request: Request, user: User = Depends(policy_admin),\n485:                   db: Session = Depends(get_db)) -> dict:\n486:     _require_global_admin(user)\n487:     version = (db.scalar(select(func.max(RewardPolicy.version)).where(RewardPolicy.policy_key == \"agent_referral_rewards\")) or 0) + 1\n488:     policy = RewardPolicy(version=version, status=\"draft\", cycle_months=payload.cycle_months,\n489:                           threshold_paise=payload.threshold_paise, points_per_rupee=payload.points_per_rupee,\n490:                           points_per_reward_rupee=payload.points_per_reward_rupee, payout_mode=payload.payout_mode,\n491:                           threshold_mode=payload.threshold_mode, late_approval_mode=payload.late_approval_mode,\n492:                           eligible_sales_basis=payload.eligible_sales_basis,\n493:                           expires_unused_points=payload.expires_unused_points, created_by_id=user.id)\n494:     db.add(policy)\n495:     db.flush()\n496:     audit(db, actor_id=user.id, action=\"reward_policy.created\", entity_type=\"reward_policy\", entity_id=policy.id,\n497:           after={\"version\": version, \"payout_mode\": policy.payout_mode, \"threshold_mode\": policy.threshold_mode,\n498:                  \"late_approval_mode\": policy.late_approval_mode,\n499:                  \"threshold_paise\": policy.threshold_paise}, reason=payload.reason,\n500:           request_id=request.headers.get(\"x-request-id\"))\n501:     db.commit()\n502:     return {\"id\": str(policy.id), \"version\": version, \"status\": policy.status,\n503:             \"payout_mode\": policy.payout_mode, \"threshold_mode\": policy.threshold_mode}\n504: \n505: \n506: @router.get(\"/policies\")\n507: def list_policies(_user: User = Depends(admin_reader), db: Session = Depends(get_db)) -> list[dict]:\n508:     rows = db.scalars(select(RewardPolicy).order_by(RewardPolicy.version.desc())).all()\n509:     return [{\"id\": str(row.id), \"version\": row.version, \"status\": row.status,\n510:              \"cycle_months\": row.cycle_months, \"threshold_paise\": row.threshold_paise,\n511:              \"points_per_rupee\": row.points_per_rupee, \"points_per_reward_rupee\": row.points_per_reward_rupee,\n512:             \"payout_mode\": row.payout_mode, \"threshold_mode\": row.threshold_mode,\n513:             \"late_approval_mode\": row.late_approval_mode,\n514:              \"eligible_sales_basis\": row.eligible_sales_basis, \"expires_unused_points\": row.expires_unused_points,\n515:              \"created_at\": row.created_at.isoformat()} for row in rows]\n516: \n517: \n518: @router.post(\"/policies/{policy_id}/approve\")\n519: def approve_policy(policy_id: uuid.UUID, request: Request,\n520:                    reason: str = Query(min_length=5, max_length=500), user: User = Depends(super_admin),\n521:                    db: Session = Depends(get_db)) -> dict:\n522:     policy = db.scalar(select(RewardPolicy).where(RewardPolicy.id == policy_id).with_for_update())\n523:     if not policy:\n524:         raise HTTPException(status_code=404, detail=\"Reward policy not found\")\n525:     if policy.created_by_id == user.id:\n526:         raise HTTPException(status_code=403, detail=\"A different authorized reviewer must approve this policy\")\n527:     if policy.status != \"draft\":\n528:         raise HTTPException(status_code=409, detail=\"Only a draft policy can be approved\")\n529:     if (policy.payout_mode == \"unselected\" or policy.threshold_mode == \"unselected\"\n530:             or policy.late_approval_mode == \"unselected\"):\n531:         raise HTTPException(status_code=409, detail=\"Select the payout method, threshold rule, and late-approval rule before approval\")\n532:     now = utcnow()\n533:     policy.status = \"approved\"\n534:     policy.approved_by_id = user.id\n535:     policy.approved_at = now\n536:     policy.effective_from = now\n537:     audit(db, actor_id=user.id, action=\"reward_policy.approved\", entity_type=\"reward_policy\", entity_id=policy.id,\n538:   