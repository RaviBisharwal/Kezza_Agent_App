{"step_index":20,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-17T06:44:54Z","content":"Created At: 2026-11-17T12:14:54+05:30\nCompleted At: 2026-11-17T12:14:56+05:30\nCreated At: 2026-11-17T12:14:54+05:30\nCompleted At: 2026-11-17T12:14:56+05:30\nShowing lines 800-973 of 973\n800:     if payload.decision == \"approve\":\n801:         old_branch = agent.branch_id\n802:         agent.branch_id = row.requested_branch_id\n803:         audit(db, actor_id=user.id, action=\"agent.branch_changed\", entity_type=\"user\", entity_id=agent.id,\n804:               before={\"branch_id\": str(old_branch) if old_branch else None},\n805:               after={\"branch_id\": str(agent.branch_id)}, reason=payload.reason)\n806:     notify(db, user_id=agent.id, event_type=f\"branch_change.{row.status}\", title=\"Branch request updated\",\n807:            body=f\"Your branch-change request is {row.status}. Open the app for details.\",\n808:            entity_type=\"branch_change_request\", entity_id=row.id)\n809:     audit(db, actor_id=user.id, action=f\"branch_change.{row.status}\", entity_type=\"branch_change_request\", entity_id=row.id,\n810:           before={\"status\": before}, after={\"status\": row.status}, reason=payload.reason,\n811:           request_id=request.headers.get(\"x-request-id\"))\n812:     db.commit()\n813:     return {\"id\": str(row.id), \"status\": row.status}\n814: \n815: \n816: @router.get(\"/feedback\")\n817: def list_feedback(status_filter: str | None = Query(default=None, alias=\"status\"),\n818:                   user: User = Depends(admin_reader), db: Session = Depends(get_db)) -> list[dict]:\n819:     query = select(Feedback).order_by(Feedback.created_at.desc()).limit(500)\n820:     if status_filter:\n821:         query = query.where(Feedback.status == status_filter)\n822:     if user.role != \"super_admin\" and user.branch_id is not None:\n823:         query = query.join(User, User.id == Feedback.user_id).where(User.branch_id == user.branch_id)\n824:     rows = db.scalars(query).all()\n825:     return [{\"id\": str(row.id), \"user_id\": str(row.user_id), \"category\": row.category, \"message\": row.message,\n826:              \"rating\": row.rating, \"contact_permission\": row.contact_permission, \"status\": row.status,\n827:              \"response\": row.response, \"created_at\": row.created_at.isoformat()} for row in rows]\n828: \n829: \n830: @router.patch(\"/feedback/{feedback_id}\")\n831: def update_feedback(feedback_id: uuid.UUID, payload: FeedbackUpdateBody, request: Request,\n832:                     user: User = Depends(admin_reader), db: Session = Depends(get_db)) -> dict:\n833:     row = db.get(Feedback, feedback_id)\n834:     if not row:\n835:         raise HTTPException(status_code=404, detail=\"Feedback not found\")\n836:     owner = db.get(User, row.user_id)\n837:     if owner and not _branch_allowed(user, owner.branch_id):\n838:         raise HTTPException(status_code=404, detail=\"Feedback not found\")\n839:     before = row.status\n840:     row.status = payload.status\n841:     row.response = payload.response\n842:     row.assigned_to_id = user.id\n843:     row.resolved_at = utcnow() if payload.status in {\"resolved\", \"closed\"} else None\n844:     audit(db, actor_id=user.id, action=\"feedback.updated\", entity_type=\"feedback\", entity_id=row.id,\n845:           before={\"status\": before}, after={\"status\": row.status}, reason=payload.response,\n846:           request_id=request.headers.get(\"x-request-id\"))\n847:     db.commit()\n848:     return {\"id\": str(row.id), \"status\": row.status}\n849: \n850: \n851: @router.post(\"/legal-documents\", status_code=201)\n852: def create_legal_document(payload: LegalDocumentCreateBody, request: Request,\n853:                           user: User = Depends(policy_admin), db: Session = Depends(get_db)) -> dict:\n854:     _require_global_admin(user)\n855:     row = LegalDocument(document_type=payload.document_type, version=payload.version, title=payload.title.strip(),\n856:                         body=payload.body, source_url=payload.source_url, is_active=False, created_by_id=user.id)\n857:     db.add(row)\n858:     db.flush()\n859:     audit(db, actor_id=user.id, action=\"legal_document.created\", entity_type=\"legal_document\", entity_id=row.id,\n860:           after={\"type\": row.document_type, \"version\": row.version, \"title\": row.title}, reason=payload.reason,\n861:           request_id=request.headers.get(\"x-request-id\"))\n862:     try:\n863:         db.commit()\n864:     except IntegrityError:\n865:         db.rollback()\n866:         raise HTTPException(status_code=409, detail=\"This document type and version already exist\") from None\n867:     return {\"id\": str(row.id), \"document_type\": row.document_type, \"version\": row.version, \"is_active\": row.is_active}\n868: \n869: \n870: @router.get(\"/legal-documents\")\n871: def list_legal_documents(_user: User = Depends(admin_reader), db: Session = Depends(get_db)) -> list[dict]:\n872:     rows = db.scalars(select(LegalDocument).order_by(LegalDocument.document_type, LegalDocument.created_at.desc())).all()\n873:     return [{\"id\": str(row.id), \"document_type\": row.document_type, \"version\": row.version, \"title\": row.title,\n874:              \"body\": row.body, \"source_url\": row.source_url, \"is_active\": row.is_active,\n875:              \"created_at\": row.created_at.isoformat()} for row in rows]\n876: \n877: \n878: @router.post(\"/legal-documents/{document_id}/approve\")\n879: def approve_legal_document(document_id: uuid.UUID, payload: LegalDocumentApprovalBody, request: Request,\n880:                            user: User = Depends(require_roles(\"super_admin\")), db: Session = Depends(get_db)) -> dict:\n881:     row = db.scalar(select(LegalDocument).where(LegalDocument.id == document_id).with_for_update())\n882:     if not row:\n883:         raise HTTPException(status_code=404, detail=\"Legal document not found\")\n884:     if row.created_by_id == user.id:\n885:         raise HTTPException(status_code=403, detail=\"A different administrator must approve this document\")\n886:     old_active = db.scalars(select(LegalDocument).where(LegalDocument.document_type == row.document_type,\n887:                                                        LegalDocument.is_active.is_(True)).with_for_update()).all()\n888:     for old in old_active:\n889:         old.is_active = False\n890:     row.is_active = payload.activate\n891:     row.approved_by_id = user.id\n892:     row.approved_at = utcnow()\n893:     audit(db, actor_id=user.id, action=\"legal_document.approved\", entity_type=\"legal_document\", entity_id=row.id,\n894:           after={\"is_active\": row.is_active, \"version\": row.version}, reason=payload.reason,\n895:           request_id=request.headers.get(\"x-request-id\"))\n896:     db.commit()\n897:     return {\"id\": str(row.id), \"is_active\": row.is_active}\n898: \n899: \n900: @router.post(\"/releases\", status_code=201)\n901: def create_release(payload: ReleaseCreateBody, request: Request,\n902:                    user: User = Depends(policy_admin), db: Session = Depends(get_db)) -> dict:\n903:     _require_global_admin(user)\n904:     row = AppRelease(**payload.model_dump(), created_by_id=user.id, is_published=False)\n905:     db.add(row)\n906:     db.flush()\n907:     audit(db, actor_id=user.id, action=\"app_release.created\", entity_type=\"app_release\", entity_id=row.id,\n908:           after={\"platform\": row.platform, \"channel\": row.channel, \"version\": row.version},\n909:           request_id=request.headers.get(\"x-request-id\"))\n910:     try:\n911:         db.commit()\n912:     except IntegrityError:\n913:         db.rollback()\n914:         raise HTTPException(status_code=409, detail=\"This platform, channel, and version already exists\") from None\n915:     return {\"id\": str(row.id), \"version\": row.version, \"is_published\": row.is_published}\n916: \n917: \n918: @router.get(\"/releases\")\n919: def list_releases(_user: User = Depends(admin_reader), db: Session = Depends(get_db)) -> list[dict]:\n920:     rows = db.scalars(select(AppRelease).order_by(AppRelease.created_at.desc())).all()\n921:     return [{\"id\": str(row.id), \"platform\": row.platform, \"channel\": row.channel, \"version\": row.version,\n922:              \"minimum_supported_version\": row.minimum_supported_version, \"release_notes\": row.release_notes,\n923:              \"download_url\": row.download_url, \"is_published\": row.is_published} for row in rows]\n924: \n925: \n926: @router.post(\"/releases/{release_id}/publish\")\n927: def publish_release(release_id: uuid.UUID, request: Request,\n928:                     reason: str = Query(min_length=5, max_length=500),\n929:                     user: User = Depends(require_roles(\"super_admin\")), db: Session = Depends(get_db)) -> dict:\n930:     row = db.scalar(select(AppRelease).where(AppRelease.id == release_id).with_for_update())\n931:     if not row:\n932:         raise HTTPException(status_code=404, detail=\"App release not found\")\n933:     if row.created_by_id == user.id:\n934:         raise HTTPException(status_code=403, detail=\"A different administrator must publish this release\")\n935:     row.is_published = True\n936:     audit(db, actor_id=user.id, action=\"app_release.published\", entity_type=\"app_release\", entity_id=row.id,\n937:           after={\"is_published\": True}, reason=reason,\n938:           request_id=request.headers.get(\"x-request-id\") if request else None)\n939:     db.commit()\n940:     return {\"id\": str(row.id), \"is_published\": row.is_published}\n941: \n942: \n943: @router.get(\"/audit-logs\")\n944: def list_audit_logs(user: User = Depends(require_roles(\"operations_admin\", \"super_admin\")),\n945:                     limit: int = Query(default=100, ge=1, le=500), db: Session = Depends(get_db)) -> list[dict]:\n946:     query = select(AuditLog).order_by(AuditLog.created_at.desc()).limit(limit)\n947:     if user.role != \"super_admin\" and user.branch_id is not None:\n948:         branch_users = select(User.id).where(User.branch_id == user.branch_id)\n949:         query = query.where((AuditLog.actor_id.in_(branch_users)) | (AuditLog.actor_id.is_(None)))\n950:     rows = db.scalars(query).all()\n951:     return [{\"id\": str(row.id), \"actor_id\": str(row.actor_id) if row.actor_id else None,\n952:              \"action\": row.action, \"entity_type\": row.entity_type,\n953:              \"entity_id\": str(row.entity_id) if row.entity_id else None,\n954:              \"before\": row.before_snapshot, \"after\": row.after_snapshot, \"reason\": row.reason,\n955:              \"created_at\": row.created_at.isoformat()} for row in rows]\n956: \n957: \n958: @router.get(\"/reports/agent-rewards.csv\")\n959: def rewards_csv(user: User = Depends(admin_reader), db: Session = Depends(get_db)) -> StreamingResponse:\n960:     query = select(RewardCycle, RewardLedgerEntry, User).join(\n961:         RewardLedgerEntry, RewardLedgerEntry.cycle_id == RewardCycle.id).join(User, User.id == RewardLedgerEntry.agent_id)\n962:     if user.role != \"super_admin\" and user.branch_id is not None:\n963:         query = query.where(User.branch_id == user.branch_id)\n964:     rows = db.execute(query.order_by(RewardCycle.starts_at.desc(), User.full_name)).all()\n965:     output = io.StringIO()\n966:     writer = csv.writer(output)\n967:     writer.writerow([\"cycle\", \"agent_code\", \"agent_name\", \"entry_type\", \"points_delta\", \"policy_version\", \"created_at\"])\n968:     for cycle, entry, agent in rows:\n969:         writer.writerow([cycle.name, agent.agent_code or \"\", agent.full_name, entry.entry_type,\n970:                          entry.points_delta, entry.policy_version, entry.created_at.isoformat()])\n971:     output.seek(0)\n972:     return StreamingResponse(iter([output.getvalue()]), media_type=\"text/csv\",\n973:                              headers={\"Content-Disposition\": \"attachment; filename=kezza-agent-rewards.csv\"})"}
