-Type-Options\"] = \"nosniff\"\n44:     response.headers[\"Referrer-Policy\"] = \"no-referrer\"\n45:     return response\n46: \n47: \n48: app.include_router(auth_router, prefix=\"/api/v1\")\n49: app.include_router(mobile_router, prefix=\"/api/v1\")\n50: app.include_router(admin_router, prefix=\"/api/v1\")\n51: app.include_router(public_router, prefix=\"/api/v1\")\n52: \n53: \n54: @app.get(\"/\")\n55: def home() -> dict:\n56:     return {\"application\": \"Kezza Agent Rewards\", \"status\": \"running\", \"version\": app.version,\n57:             \"docs\": \"/docs\", \"health\": \"/health\"}\n58: \n59: \n60: @app.get(\"/health\")\n61: def health() -> dict:\n62:     return {\"status\": \"healthy\", \"application\": \"Kezza Agent Rewards API\"}\n63: \n64: \n65: @app.get(\"/health/db\")\n66: def database_health() -> dict:\n67:     try:\n68:         with engine.connect() as connection:\n69:             database_name = connection.execute(text(\"select current_database()\")).scalar_one()\n70:         if database_name != \"kezza_rewards_db\":\n71:             logger.error(\"Refusing unexpected database name: %s\", database_name)\n72:             raise HTTPException(status_code=503, detail=\"Rewards API is connected to the wrong database\")\n73:         return {\"status\": \"connected\", \"database\": database_name}\n74:     except HTTPException:\n75:         raise\n76:     except SQLAlchemyError:\n77:         logger.exception(\"Database health check failed\")\n78:         raise HTTPException(status_code=503, detail=\"Rewards database is unavailable\") from None"}
