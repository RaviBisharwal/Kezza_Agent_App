{"step_index":24,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-17T06:45:01Z","content":"Created At: 2026-11-17T12:15:01+05:30\nCompleted At: 2026-11-17T12:15:01+05:30\nCreated At: 2026-11-17T12:15:01+05:30\nCompleted At: 2026-11-17T12:15:01+05:30\nShowing lines 650-800 of 973\n650: \n651: @router.post(\"/cycles/{cycle_id}/expire-points\")\n652: def expire_cycle_points(cycle_id: uuid.UUID, payload: CycleExpiryBody, request: Request,\n653:                         user: User = Depends(super_admin), db: Session = Depends(get_db)) -> dict:\n654:     cycle = db.scalar(select(RewardCycle).where(RewardCycle.id == cycle_id).with_for_update())\n655:     if not cycle or cycle.status != \"closed\":\n656:         raise HTTPException(status_code=409, detail=\"Only a closed reward cycle can be considered for expiry\")\n657:     policy = db.get(RewardPolicy, cycle.policy_id)\n658:     if not policy or not policy.expires_unused_points:\n659:         raise HTTPException(status_code=409, detail=\"The approved policy does not expire unused points\")\n660:     unsettled = db.scalar(select(func.count()).select_from(CycleSettlement).where(\n661:         CycleSettlement.cycle_id == cycle.id, CycleSettlement.status.in_((\"eligible\", \"approved\")))) or 0\n662:     if unsettled:\n663:         raise HTTPException(status_code=409, detail=\"Settle or formally cancel cycle settlement records before expiring points\")\n664:     rows = db.execute(select(RewardLedgerEntry.agent_id,\n665:                              func.coalesce(func.sum(RewardLedgerEntry.points_delta), 0))\n666:                       .where(RewardLedgerEntry.cycle_id == cycle.id)\n667:                       .group_by(RewardLedgerEntry.agent_id)).all()\n668:     expired_total = 0\n669:     for agent_id, balance in rows:\n670:         if balance <= 0:\n671:             continue\n672:         idempotency_key = f\"expiry:{cycle.id}:{agent_id}\"\n673:         exists = db.scalar(select(RewardLedgerEntry.id).where(RewardLedgerEntry.idempotency_key == idempotency_key))\n674:         if exists:\n675:             continue\n676:         db.add(RewardLedgerEntry(agent_id=agent_id, cycle_id=cycle.id, source_type=\"reward_cycle\",\n677:             source_id=uuid.uuid4(), entry_type=\"expiry\", points_delta=-int(balance), policy_version=policy.version,\n678:             reason=payload.reason.strip(), actor_id=user.id, idempotency_key=idempotency_key))\n679:         expired_total += int(balance)\n680:     audit(db, actor_id=user.id, action=\"reward_cycle.points_expired\", entity_type=\"reward_cycle\", entity_id=cycle.id,\n681:           after={\"points_expired\": expired_total}, reason=payload.reason,\n682:           request_id=request.headers.get(\"x-request-id\"))\n683:     db.commit()\n684:     return {\"cycle_id\": str(cycle.id), \"points_expired\": expired_total, \"status\": \"recorded\"}\n685: \n686: \n687: @router.get(\"/settlements\")\n688: def list_settlements(user: User = Depends(admin_reader), db: Session = Depends(get_db)) -> list[dict]:\n689:     query = select(CycleSettlement).order_by(CycleSettlement.created_at.desc())\n690:     if user.role != \"super_admin\" and user.branch_id is not None:\n691:         branch_agent_ids = select(User.id).where(User.branch_id == user.branch_id)\n692:         query = query.where(CycleSettlement.agent_id.in_(branch_agent_ids))\n693:     rows = db.scalars(query.limit(500)).all()\n694:     return [{\"id\": str(row.id), \"cycle_id\": str(row.cycle_id), \"agent_id\": str(row.agent_id),\n695:              \"points\": row.points, \"estimated_value_paise\": row.reward_value_paise,\n696:              \"payout_mode\": row.payout_mode, \"status\": row.status,\n697:              \"created_by_id\": str(row.created_by_id),\n698:              \"approved_by_id\": str(row.approved_by_id) if row.approved_by_id else None,\n699:              \"external_reference\": row.external_reference, \"settled_at\": row.settled_at.isoformat() if row.settled_at else None} for row in rows]\n700: \n701: \n702: @router.post(\"/settlements/{settlement_id}/approve\")\n703: def approve_settlement(settlement_id: uuid.UUID, request: Request,\n704:                        reason: str = Query(min_length=5, max_length=500),\n705:                        user: User = Depends(require_roles(\"finance_reviewer\", \"super_admin\")),\n706:                        db: Session = Depends(get_db)) -> dict:\n707:     row = db.scalar(select(CycleSettlement).where(CycleSettlement.id == settlement_id).with_for_update())\n708:     if not row:\n709:         raise HTTPException(status_code=404, detail=\"Settlement record not found\")\n710:     agent = db.get(User, row.agent_id)\n711:     if agent and (agent.branch_id is None or not _branch_allowed(user, agent.branch_id)):\n712:         raise HTTPException(status_code=404, detail=\"Settlement record not found\")\n713:     if row.created_by_id == user.id:\n714:         raise HTTPException(status_code=403, detail=\"A different finance reviewer must approve this settlement\")\n715:     if row.status != \"eligible\":\n716:         raise HTTPException(status_code=409, detail=\"Only eligible settlement records can be approved\")\n717:     row.status = \"approved\"\n718:     row.approved_by_id = user.id\n719:     audit(db, actor_id=user.id, action=\"settlement.approved\", entity_type=\"cycle_settlement\", entity_id=row.id,\n720:           after={\"status\": \"approved\"}, reason=reason,\n721:           request_id=request.headers.get(\"x-request-id\") if request else None)\n722:     db.commit()\n723:     return {\"id\": str(row.id), \"status\": row.status}\n724: \n725: \n726: @router.post(\"/settlements/{settlement_id}/mark-settled\")\n727: def mark_settlement(settlement_id: uuid.UUID, payload: SettlementMarkBody, request: Request,\n728:                     user: User = Depends(require_roles(\"finance_reviewer\", \"super_admin\")),\n729:                     db: Session = Depends(get_db)) -> dict:\n730:     row = db.scalar(select(CycleSettlement).where(CycleSettlement.id == settlement_id).with_for_update())\n731:     if not row:\n732:         raise HTTPException(status_code=404, detail=\"Settlement record not found\")\n733:     agent = db.get(User, row.agent_id)\n734:     if agent and (agent.branch_id is None or not _branch_allowed(user, agent.branch_id)):\n735:         raise HTTPException(status_code=404, detail=\"Settlement record not found\")\n736:     if user.id == row.created_by_id:\n737:         raise HTTPException(status_code=403, detail=\"A different authorized user must record the completed transfer\")\n738:     if row.approved_by_id == user.id:\n739:         raise HTTPException(status_code=403, detail=\"A different finance reviewer must record the completed transfer\")\n740:     if row.status != \"approved\":\n741:         raise HTTPException(status_code=409, detail=\"Settlement must be approved before it can be marked settled\")\n742:     row.status = \"paid\"\n743:     row.external_reference = payload.external_reference\n744:     row.settled_at = utcnow()\n745:     cycle = db.get(RewardCycle, row.cycle_id)\n746:     policy = db.get(RewardPolicy, cycle.policy_id) if cycle else None\n747:     if not cycle or not policy:\n748:         raise HTTPException(status_code=409, detail=\"Cycle policy is unavailable for settlement ledger posting\")\n749:     db.add(RewardLedgerEntry(agent_id=row.agent_id, cycle_id=row.cycle_id, source_type=\"cycle_settlement\",\n750:         source_id=row.id, entry_type=\"settlement\", points_delta=-row.points,\n751:         value_minor_units=row.reward_value_paise, policy_version=policy.version, reason=payload.reason,\n752:         actor_id=user.id, idempotency_key=f\"settlement:{row.id}\"))\n753:     notify(db, user_id=row.agent_id, event_type=\"reward.settled\", title=\"Reward settlement recorded\",\n754:            body=\"A reward settlement has been recorded. Contact Kezza support if you need details.\",\n755:            entity_type=\"c