{"step_index":202,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-13T06:23:09Z","input_tokens":2111,"cache_read_tokens":101425,"output_tokens":1319,"thinking":"Creating the referrals endpoint, focusing on the specified routes for code retrieval, referral listing, lead addition, and status checks. This will involve defining handlers for each route to interact with the referral data.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"import uuid\nfrom fastapi import APIRouter, Depends, HTTPException, status\nfrom sqlalchemy import select\nfrom sqlalchemy.orm import Session\n\nfrom app.database import get_db\nfrom app.models.agent import Agent\nfrom app.models.patient import Patient\nfrom app.models.referral import Referral\nfrom app.schemas.referrals import (\n    AgentReferralCodeSchema,\n    ReferralLeadCreateSchema,\n    ReferralResponseSchema,\n)\nfrom app.services.auth_service import get_current_user\nfrom app.services.referral_service import (\n    create_referral_lead,\n    get_agent_referral_summary,\n    list_agent_referrals,\n)\n\nrouter = APIRouter(prefix=\"/referrals\", tags=[\"Referrals\"])\n\n\n@router.get(\"/my-code\", response_model=AgentReferralCodeSchema)\ndef get_my_referral_code(\n    current_user: dict = Depends(get_current_user),\n    db: Session = Depends(get_db),\n):\n    \"\"\"\n    Step 1: Agent retrieves their unique referral code, shareable link, and stats.\n    \"\"\"\n    if current_user.get(\"role\") != \"agent\" or not current_user.get(\"agent_id\"):\n        raise HTTPException(\n            status_code=status.HTTP_403_FORBIDDEN,\n            detail=\"Only agents have a referral code\",\n        )\n\n    agent_id = uuid.UUID(current_user[\"agent_id\"])\n    try:\n        summary = get_agent_referral_summary(agent_id, db)\n        return AgentReferralCodeSchema(**summary)\n    except Exception as e:\n        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(e))\n\n\n@router.get(\"\", response_model=list[ReferralResponseSchema])\ndef get_agent_referrals(\n    current_user: dict = Depends(get_current_user),\n    db: Session = Depends(get_db),\n):\n    \"\"\"\n    Agent retrieves list of referred patients and their progression.\n    \"\"\"\n    if current_user.get(\"role\") != \"agent\" or not current_user.get(\"agent_id\"):\n        raise HTTPException(\n            status_code=status.HTTP_403_FORBIDDEN,\n            detail=\"Only agents can view referral lists\",\n        )\n\n    agent_id = uuid.UUID(current_user[\"agent_id\"])\n    return list_agent_referrals(agent_id, db)\n\n\n@router.post(\"/lead\", response_model=ReferralResponseSchema)\ndef create_lead(\n    payload: ReferralLeadCreateSchema,\n    current_user: dict = Depends(get_current_user),\n    db: Session = Depends(get_db),\n):\n    \"\"\"\n    Agent registers a patient lead before they download the app.\n    Prevents duplicate referrals.\n    \"\"\"\n    if current_user.get(\"role\") != \"agent\" or not current_user.get(\"agent_id\"):\n        raise HTTPException(\n            status_code=status.HTTP_403_FORBIDDEN,\n            detail=\"Only agents can register referral leads\",\n        )\n\n    agent_id = uuid.UUID(current_user[\"agent_id\"])\n    try:\n        result = create_referral_lead(\n            agent_id=agent_id,\n            patient_name=payload.patient_name,\n            patient_phone_e164=payload.patient_phone_e164,\n            service_interest=payload.service_interest,\n            preferred_branch_id=payload.preferred_branch_id,\n            db=db,\n        )\n        return ReferralResponseSchema(**result)\n    except ValueError as e:\n        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(e))\n\n\n@router.get(\"/patient-attribution\")\ndef get_patient_attribution(\n    current_user: dict = Depends(get_current_user),\n    db: Session = Depends(get_db),\n):\n    \"\"\"\n    Patient checks which agent referred them.\n    \"\"\"\n    user_id = uuid.UUID(current_user[\"id\"])\n    referral = db.scalars(\n        select(Referral).where(Referral.patient_user_id == user_id)\n    ).first()\n\n    if not referral:\n        return {\"has_referral\": False, \"message\": \"Direct sign up without referral\"}\n\n    agent = db.get(Agent, referral.referring_agent_id)\n    return {\n        \"has_referral\": True,\n        \"referring_agent_code\": agent.agent_code if agent else \"UNKNOWN\",\n        \"status\": referral.status,\n        \"converted_at\": referral.converted_at.isoformat() if referral.converted_at else None,\n    }\n","Path":"/Users/ravi/Desktop/Kezza_mobile-main/backend/app/api/v1/endpoints/referrals.py"}}]}
{"step_index":203,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-13T06:23:15Z","content":"Created At: 2026-11-13T11:53:15+05:30\nCompleted At: 2026-11-13T11:53:15+05:30\nCreated At: 2026-11-13T11:53:15+05:30\nCompleted At: 2026-11-13T11:53:15+05:30\nCreated file."}
{"step_index":204,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-13T06:23:15Z","input_tokens":3503,"cache_read_tokens":101428,"output_tokens":982,"thinking":"Defining the API endpoints for payments, specifically a purchase endpoint for treatments and a history endpoint to retrieve patient payment records. The purchase endpoint will handle authenticated patient requests or admin/clinic requests specifying a patient ID, using a dedicated payment processing function. The endpoints will return a structured response adhering to a defined schema.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"import uuid\nfrom fastapi import APIRouter, Depends, HTTPException, status\nfrom sqlalchemy import select\nfrom sqlalchemy.orm import Session\n\nfrom app.database import get_db\nfrom app.models.patient import Patient\nfrom app.models.payment import Payment\nfrom app.schemas.payments import PaymentResponseSchema, TreatmentPaymentCreateSchema\nfrom app.services.auth_service import get_current_user\nfrom app.services.payment_service import process_treatment_payment\n\nrouter = APIRouter(prefix=\"/payments\", tags=[\"Payments\"])\n\n\n@router.post(\"/purchase-treatment\", response_model=PaymentResponseSchema)\ndef purchase_treatment_endpoint(\n    payload: TreatmentPaymentCreateSchema,\n    current_user: dict = Depends(get_current_user),\n    db: Session = Depends(get_db),\n):\n    \"\"\"\n    Step 4, 5, 6:\n    Records verified treatment payment.\n    - Credits patient points ledger (1 point per R10 spent).\n    - If patient was referred by an agent, marks referral converted and awards 10% commission!\n    \"\"\"\n    # Determine target patient\n    target_patient_id = None\n    if payload.patient_id:\n        target_patient_id = uuid.UUID(payload.patient_id)\n    elif current_user.get(\"patient_id\"):\n        target_patient_id = uuid.UUID(current_user[\"patient_id\"])\n    else:\n        raise HTTPException(\n            status_code=status.HTTP_400_BAD_REQUEST,\n            detail=\"No patient profile found. Please register as a patient or specify patient_id.\",\n        )\n\n    try:\n        result = process_treatment_payment(\n            patient_id=target_patient_id,\n            treatment_name=payload.treatment_name,\n            amount_rands=payload.amount_rands,\n            payment_reference=payload.payment_reference,\n            branch_id=payload.branch_id,\n            db=db,\n        )\n        return PaymentResponseSchema(**result)\n    except ValueError as e:\n        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(e))\n\n\n@router.get(\"/history\")\ndef get_payment_history(\n    current_user: dict = Depends(get_current_user),\n    db: Session = Depends(get_db),\n):\n    if not current_user.get(\"patient_id\"):\n        raise HTTPException(\n            status_code=status.HTTP_400_BAD_REQUEST,\n            detail=\"Patient profile required\",\n        )\n\n    patient_id = uuid.UUID(current_user[\"patient_id\"])\n    stmt = (\n        select(Payment)\n        .where(Payment.patient_id == patient_id)\n        .order_by(Payment.created_at.desc())\n    )\n    payments = db.scalars(stmt).all()\n\n    return [\n        {\n            \"id\": str(p.id),\n            \"treatment_name\": p.treatment_name,\n            \"amount_rands\": p.amount_cents / 100.0,\n            \"currency\": p.currency,\n            \"status\": p.status,\n            \"payment_reference\": p.payment_reference,\n            \"verified_at\": p.verified_at.isoformat() if p.verified_at else None,\n            \"created_at\": p.created_at.isoformat() if p.created_at else \"\",\n        }\n        for p in payments\n    ]\n","Path":"/Users/ravi/Desktop/Kezza_mobile-main/backend/app/api/v1/endpoints/payments.py"}}]}
{"step_index":205,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-13T06:23:20Z","content":"Created At: 2026-11-13T11:53:20+05:30\nCompleted At: 2026-11-13T11:53:20+05:30\nCreated At: 2026-11-13T11:53:20+05:30\nCompleted At: 2026-11-13T11:53:20+05:30\nCreated file."}
{"step_index":206,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-13T06:23:20Z","input_tokens":4561,"cache_read_tokens":101428,"output_tokens":579,"tool_calls":[{"name":"write_file","args":{"Content":"import uuid\nfrom fastapi import APIRouter, Depends, HTTPException, status\nfrom sqlalchemy.orm import Session\n\nfrom app.database import get_db\nfrom app.schemas.wallet import AgentEarningsResponseSchema, PatientWalletResponseSchema\nfrom app.services.auth_service import get_current_user\nfrom app.services.wallet_service import get_agent_earnings, get_patient_wallet\n\nrouter = APIRouter(prefix=\"/wallet\", tags=[\"Wallet & Commissions\"])\n\n\n@router.get(\"/patient\", response_model=PatientWalletResponseSchema)\ndef get_patient_wallet_endpoint(\n    current_user: dict = Depends(get_current_user),\n    db: Session = Depends(get_db),\n):\n    \"\"\"\n    Step 7 (Patient): Patient views earned treatment credit and reward points ledger.\n    \"\"\"\n    if not current_user.get(\"patient_id\"):\n        raise HTTPException(\n            status_code=status.HTTP_400_BAD_REQUEST,\n            detail=\"User does not have a patient profile\",\n        )\n\n    patient_id = uuid.UUID(current_user[\"patient_id\"])\n    return get_patient_wallet(patient_id, db)\n\n\n@router.get(\"/agent\", response_model=AgentEarningsResponseSchema)\ndef get_agent_earnings_endpoint(\n    current_user: dict = Depends(get_current_user),\n    db: Session = Depends(get_db),\n):\n    \"\"\"\n    Step 7 (Agent): Agent views commission tier, pending/approved earnings, and commission ledger.\n    \"\"\"\n    if not current_user.get(\"agent_id\"):\n        raise HTTPException(\n            status_code=status.HTTP_400_BAD_REQUEST,\n            detail=\"User does not have an agent profile\",\n        )\n\n    agent_id = uuid.UUID(current_user[\"agent_id\"])\n    return get_agent_earnings(agent_id, db)\n","Path":"/Users/ravi/Desktop/Kezza_mobile-main/backend/app/api/v1/endpoints/wallet.py"}}]}
{"step_index":207,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-13T06:23:26Z","content":"Created At: 2026-11-13T11:53:26+05:30\nCompleted At: 2026-11-13T11:53:26+05:30\nCreated At: 2026-11-13T11:53:26+05:30\nCompleted At: 2026-11-13T11:53:26+05:30\nCreated file."}
{"step_index":208,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-13T06:23:26Z","input_tokens":5219,"cache_read_tokens":101425,"output_tokens":692,"tool_calls":[{"name":"write_file","args":{"Content":"import logging\n\nfrom fastapi import FastAPI, HTTPException\nfrom fastapi.middleware.cors import CORSMiddleware\nfrom sqlalchemy import text\nfrom sqlalchemy.exc import SQLAlchemyError\n\nfrom app.database import engine\n\n# Register all models with the declarative base\nimport app.models  # noqa: F401\n\nfrom app.api.v1.endpoints.auth import router as auth_router\nfrom app.api.v1.endpoints.referrals import router as referrals_router\nfrom app.api.v1.endpoints.payments import router as payments_router\nfrom app.api.v1.endpoints.wallet import router as wallet_router\n\nlogging.basicConfig(level=logging.INFO)\nlogger = logging.getLogger(__name__)\n\napp = FastAPI(\n    title=\"Kezza API\",\n    description=\"Patient Rewards and Referral Management API\",\n    version=\"1.0.0\",\n)\n\n# Enable CORS for React Native & Web clients\napp.add_middleware(\n    CORSMiddleware,\n    allow_origins=[\"*\"],\n    allow_credentials=True,\n    allow_methods=[\"*\"],\n    allow_headers=[\"*\"],\n)\n\n# Include v1 routers\napp.include_router(auth_router, prefix=\"/api/v1\")\napp.include_router(referrals_router, prefix=\"/api/v1\")\napp.include_router(payments_router, prefix=\"/api/v1\")\napp.include_router(wallet_router, prefix=\"/api/v1\")\n\n\n@app.get(\"/\")\ndef home():\n    return {\n        \"application\": \"Kezza\",\n        \"message\": \"Kezza API is running successfully\",\n        \"version\": \"1.0.0\",\n        \"endpoints\": {\n            \"auth\": \"/api/v1/auth\",\n            \"referrals\": \"/api/v1/referrals\",\n            \"payments\": \"/api/v1/payments\",\n            \"wallet\": \"/api/v1/wallet\",\n        },\n    }\n\n\n@app.get(\"/health\")\ndef health_check():\n    return {\n        \"status\": \"healthy\",\n        \"application\": \"Kezza API\",\n    }\n\n\n@app.get(\"/health/db\")\ndef database_health():\n    try:\n        with engine.connect() as connection:\n            result = connection.execute(\n                text(\"SELECT 1\")\n            ).one()\n\n        return {\n            \"status\": \"connected\",\n            \"check\": result[0],\n        }\n\n    except SQLAlchemyError:\n        logger.exception(\"Database health check failed\")\n        raise HTTPException(\n            status_code=503,\n            detail=\"Database connection unavailable\",\n        )\n","Overwrite":true,"Path":"/Users/ravi/Desktop/Kezza_mobile-main/backend/app/main.py"}}]}
{"step_index":209,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-13T06:23:30Z","content":"Created At: 2026-11-13T11:53:30+05:30\nCompleted At: 2026-11-13T11:53:30+05:30\nCreated At: 2026-11-13T11:53:30+05:30\nCompleted At: 2026-11-13T11:53:30+05:30\nCreated file."}
{"step_index":210,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-13T06:23:31Z","input_tokens":5990,"cache_read_tokens":101422,"output_tokens":1139,"thinking":"Initial test setup focuses on the 7-step journey, starting with agent registration and referral link retrieval. The first steps involve sending a registration request to the authentication endpoint, followed by a request to get the agent's referral code and link. Key assertions will be to ensure the returned agent code is present and the referral link includes this code.\n\n\nNow testing the end-to-end referral journey by simulating patient registration and treatment purchase. The tests will verify referral attribution, reward points earned by the patient, and commission earned by the agent. The setup includes checking the status updates for both the patient and the agent within the referrals and wallet endpoints.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"import os\nimport pytest\nfrom fastapi.testclient import TestClient\nfrom sqlalchemy import create_engine\nfrom sqlalchemy.orm import sessionmaker\n\n# Set testing database URL before importing app modules\nos.environ[\"DATABASE_URL\"] = \"sqlite:///:memory:\"\n\nfrom app.base import Base\nfrom app.database import get_db\nfrom app.main import app\nimport app.models  # Ensure all models are registered\n\n# Create in-memory test engine\ntest_engine = create_engine(\n    \"sqlite:///:memory:\",\n    connect_args={\"check_same_thread\": False},\n)\nTestingSessionLocal = sessionmaker(\n    bind=test_engine,\n    autocommit=False,\n    autoflush=False,\n    expire_on_commit=False,\n)\n\n\n@pytest.fixture(scope=\"session\", autouse=True)\ndef setup_database():\n    \"\"\"Create all tables in the test database once per session.\"\"\"\n    Base.metadata.create_all(bind=test_engine)\n    yield\n    Base.metadata.drop_all(bind=test_engine)\n\n\n@pytest.fixture\ndef db_session():\n    \"\"\"Yield a clean database session per test function.\"\"\"\n    connection = test_engine.connect()\n    transaction = connection.begin()\n    session = TestingSessionLocal(bind=connection)\n\n    yield session\n\n    session.close()\n    transaction.rollback()\n    connection.close()\n\n\n@pytest.fixture\ndef client(db_session):\n    \"\"\"Override get_db with test database session.\"\"\"\n    def override_get_db():\n        yield db_session\n\n    app.dependency_overrides[get_db] = override_get_db\n    with TestClient(app) as c:\n        yield c\n    app.dependency_overrides.clear()\n","Overwrite":true,"Path":"/Users/ravi/Desktop/Kezza_mobile-main/backend/app/tests/conftest.py"}}]}
{"step_index":211,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-13T06:23:39Z","content":"Created At: 2026-11-13T11:53:39+05:30\nCompleted At: 2026-11-13T11:53:39+05:30\nCreated At: 2026-11-13T11:53:39+05:30\nCompleted At: 2026-11-13T11:53:39+05:30\nCreated file."}
{"step_index":212,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-13T06:23:39Z","input_tokens":3146,"cache_read_tokens":105481,"output_tokens":1887,"tool_calls":[{"name":"write_file","args":{"Content":"\"\"\"\nEnd-to-End MVP Journey Test:\nTests the complete 7-step business flow from agent referral to reward & commission:\n1. Agent generates a referral link\n2. Patient registers with the referral link\n3. Referral attribution is locked\n4. Patient purchases a treatment\n5. Patient receives points rewards in ledger\n6. Agent receives commission in ledger\n7. Both see their results (Patient sees credit; Agent sees commission & conversion)\n\"\"\"\n\nfrom fastapi.testclient import TestClient\n\n\ndef test_complete_kezza_journey(client: TestClient):\n    # =========================================================================\n    # Step 1: Agent registers and gets unique referral code & link\n    # =========================================================================\n    agent_phone = \"+27821110001\"\n    agent_reg_res = client.post(\n        \"/api/v1/auth/register\",\n        json={\n            \"phone_e164\": agent_phone,\n            \"full_name\": \"Dr. Sarah Agent\",\n            \"role\": \"agent\",\n            \"email\": \"sarah.agent@example.com\",\n        },\n    )\n    assert agent_reg_res.status_code == 200, agent_reg_res.text\n    agent_data = agent_reg_res.json()\n    agent_token = agent_data[\"access_token\"]\n    agent_code = agent_data[\"user\"][\"agent_code\"]\n    assert agent_code.startswith(\"AGT-\")\n\n    # Agent checks their referral link\n    agent_auth_headers = {\"Authorization\": f\"Bearer {agent_token}\"}\n    ref_code_res = client.get(\"/api/v1/referrals/my-code\", headers=agent_auth_headers)\n    assert ref_code_res.status_code == 200\n    ref_info = ref_code_res.json()\n    assert ref_info[\"agent_code\"] == agent_code\n    assert f\"ref={agent_code}\" in ref_info[\"referral_link\"]\n    assert ref_info[\"total_referrals\"] == 0\n\n    # =========================================================================\n    # Step 2: Patient registers using agent's referral link\n    # =========================================================================\n    patient_phone = \"+27822220002\"\n    patient_reg_res = client.post(\n        \"/api/v1/auth/register\",\n        json={\n            \"phone_e164\": patient_phone,\n            \"full_name\": \"John Doe Patient\",\n            \"role\": \"patient\",\n            \"email\": \"john.doe@example.com\",\n            \"referral_code\": agent_code,\n        },\n    )\n    assert patient_reg_res.status_code == 200, patient_reg_res.text\n    patient_data = patient_reg_res.json()\n    patient_token = patient_data[\"access_token\"]\n    patient_id = patient_data[\"user\"][\"patient_id\"]\n    patient_auth_headers = {\"Authorization\": f\"Bearer {patient_token}\"}\n\n    # =========================================================================\n    # Step 3: Referral attribution is locked\n    # =========================================================================\n    # Check patient side: attribution is confirmed\n    attr_res = client.get(\"/api/v1/referrals/patient-attribution\", headers=patient_auth_headers)\n    assert attr_res.status_code == 200\n    attr_data = attr_res.json()\n    assert attr_data[\"has_referral\"] is True\n    assert attr_data[\"referring_agent_code\"] == agent_code\n    assert attr_data[\"status\"] == \"registered\"\n\n    # Check agent side: referral shows up in agent's pipeline\n    agent_refs_res = client.get(\"/api/v1/referrals\", headers=agent_auth_headers)\n    assert agent_refs_res.status_code == 200\n    agent_refs = agent_refs_res.json()\n    assert len(agent_refs) == 1\n    assert agent_refs[0][\"patient_name\"] == \"John Doe Patient\"\n    assert agent_refs[0][\"status\"] == \"registered\"\n\n    # =========================================================================\n    # Step 4, 5, 6: Patient purchases a treatment for R 1,500\n    # =========================================================================\n    treatment_res = client.post(\n        \"/api/v1/payments/purchase-treatment\",\n        headers=patient_auth_headers,\n        json={\n            \"treatment_name\": \"Premium Teeth Whitening\",\n            \"amount_rands\": 1500.00,\n            \"payment_reference\": \"INV-2026-001\",\n        },\n    )\n    assert treatment_res.status_code == 200, treatment_res.text\n    treatment_data = treatment_res.json()\n\n    # Step 5: Verify Patient received points (10% back = 150 points)\n    assert treatment_data[\"points_earned\"] == 150\n    assert treatment_data[\"new_points_balance\"] == 150\n\n    # Step 6: Verify Agent received commission (10% of R1,500 = R150)\n    assert treatment_data[\"referral_converted\"] is True\n    assert treatment_data[\"agent_commission_rands\"] == 150.00\n\n    # =========================================================================\n    # Step 7: Both see their results!\n    # =========================================================================\n    # 7a. Patient sees treatment credit in wallet\n    patient_wallet_res = client.get(\"/api/v1/wallet/patient\", headers=patient_auth_headers)\n    assert patient_wallet_res.status_code == 200\n    wallet_data = patient_wallet_res.json()\n    assert wallet_data[\"total_points\"] == 150\n    assert wallet_data[\"credit_rands\"] == 150.00\n    assert len(wallet_data[\"ledger\"]) == 1\n    assert \"Premium Teeth Whitening\" in wallet_data[\"ledger\"][0][\"description\"]\n\n    # 7b. Agent sees earnings and updated referral details\n    agent_earnings_res = client.get(\"/api/v1/wallet/agent\", headers=agent_auth_headers)\n    assert agent_earnings_res.status_code == 200\n    earnings_data = agent_earnings_res.json()\n    assert earnings_data[\"approved_rands\"] == 150.00\n    assert earnings_data[\"total_earned_rands\"] == 150.00\n    assert len(earnings_data[\"ledger\"]) == 1\n    assert earnings_data[\"ledger\"][0][\"amount_rands\"] == 150.00\n    assert earnings_data[\"ledger\"][0][\"treatment_name\"] == \"Premium Teeth Whitening\"\n\n    # 7c. Agent sees referral status converted\n    updated_refs_res = client.get(\"/api/v1/referrals\", headers=agent_auth_headers)\n    assert updated_refs_res.status_code == 200\n    updated_refs = updated_refs_res.json()\n    assert updated_refs[0][\"status\"] == \"converted\"\n    assert updated_refs[0][\"converted_at\"] is not None\n\n    # Agent checks summary stats\n    updated_summary_res = client.get(\"/api/v1/referrals/my-code\", headers=agent_auth_headers)\n    assert updated_summary_res.status_code == 200\n    summary = updated_summary_res.json()\n    assert summary[\"total_referrals\"] == 1\n    assert summary[\"converted_count\"] == 1\n","Path":"/Users/ravi/Desktop/Kezza_mobile-main/backend/app/tests/test_journey.py"}}]}
