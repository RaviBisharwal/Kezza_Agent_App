{"step_index":231,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-13T06:24:30Z","input_tokens":4745,"cache_read_tokens":113585,"output_tokens":461,"tool_calls":[{"name":"write_file","args":{"Content":"export interface CommissionLedgerEntry {\n  id: string;\n  tier_percent: float;\n  amount_rands: number;\n  status: string;\n  created_at: string;\n  treatment_name: string | null;\n}\n\nexport interface AgentEarningsInfo {\n  agent_code: string;\n  commission_tier: string;\n  tier_percent: number;\n  pending_rands: number;\n  approved_rands: number;\n  paid_rands: number;\n  total_earned_rands: number;\n  ledger: CommissionLedgerEntry[];\n}\n","Overwrite":true,"Path":"/Users/ravi/Desktop/Kezza_mobile-main/src/features/commissions/types.ts"}},{"name":"write_file","args":{"Content":"import { useQuery } from '@tanstack/react-query';\nimport { api } from '@/lib/api';\nimport { useAuthStore } from '@/store/auth-store';\nimport type { AgentEarningsInfo } from './types';\n\nexport const commissionKeys = {\n  all: ['commissions'] as const,\n  earnings: () => [...commissionKeys.all, 'earnings'] as const,\n};\n\n/** Agent retrieves commission tier, earnings breakdown, and ledger */\nexport function useAgentEarnings() {\n  const role = useAuthStore((s) => s.user?.role);\n  return useQuery({\n    queryKey: commissionKeys.earnings(),\n    queryFn: async () => {\n      const res = await api.get<AgentEarningsInfo>('/wallet/agent');\n      return res.data;\n    },\n    enabled: role === 'agent',\n  });\n}\n","Overwrite":true,"Path":"/Users/ravi/Desktop/Kezza_mobile-main/src/features/commissions/hooks.ts"}}]}
