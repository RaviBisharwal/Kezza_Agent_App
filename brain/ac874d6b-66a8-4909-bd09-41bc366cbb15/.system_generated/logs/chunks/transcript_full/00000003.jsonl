{"step_index":225,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-13T06:24:17Z","input_tokens":2611,"cache_read_tokens":113599,"output_tokens":1026,"tool_calls":[{"name":"write_file","args":{"Content":"export type ReferralStatus =\n  | 'registered'\n  | 'contacted'\n  | 'consultation_booked'\n  | 'converted'\n  | 'not_converted'\n  | 'rejected';\n\nexport interface Referral {\n  id: string;\n  patient_name: string;\n  patient_phone_e164: string;\n  referring_agent_id: string;\n  status: ReferralStatus;\n  service_interest: string | null;\n  created_at: string;\n  converted_at: string | null;\n}\n\nexport interface CreateReferralLeadBody {\n  patient_name: string;\n  patient_phone_e164: string;\n  preferred_branch_id?: string;\n  service_interest?: string;\n}\n\nexport interface AgentReferralCodeInfo {\n  agent_code: string;\n  referral_link: string;\n  total_referrals: number;\n  converted_count: number;\n}\n\nexport interface PatientAttributionInfo {\n  has_referral: boolean;\n  referring_agent_code?: string;\n  status?: string;\n  converted_at?: string | null;\n  message?: string;\n}\n","Overwrite":true,"Path":"/Users/ravi/Desktop/Kezza_mobile-main/src/features/referrals/types.ts"}},{"name":"write_file","args":{"Content":"import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';\nimport { api } from '@/lib/api';\nimport { useAuthStore } from '@/store/auth-store';\nimport type {\n  AgentReferralCodeInfo,\n  CreateReferralLeadBody,\n  PatientAttributionInfo,\n  Referral,\n} from './types';\n\nexport const referralKeys = {\n  all: ['referrals'] as const,\n  agentCode: () => [...referralKeys.all, 'my-code'] as const,\n  agentList: () => [...referralKeys.all, 'list'] as const,\n  attribution: () => [...referralKeys.all, 'attribution'] as const,\n};\n\n/** Agent retrieves their referral code, link, and counts */\nexport function useAgentReferralCode() {\n  const role = useAuthStore((s) => s.user?.role);\n  return useQuery({\n    queryKey: referralKeys.agentCode(),\n    queryFn: async () => {\n      const res = await api.get<AgentReferralCodeInfo>('/referrals/my-code');\n      return res.data;\n    },\n    enabled: role === 'agent',\n  });\n}\n\n/** Agent retrieves list of referred patients */\nexport function useAgentReferrals() {\n  const role = useAuthStore((s) => s.user?.role);\n  return useQuery({\n    queryKey: referralKeys.agentList(),\n    queryFn: async () => {\n      const res = await api.get<Referral[]>('/referrals');\n      return res.data;\n    },\n    enabled: role === 'agent',\n  });\n}\n\n/** Agent creates a new patient lead */\nexport function useCreateReferralLead() {\n  const qc = useQueryClient();\n  return useMutation({\n    mutationFn: async (body: CreateReferralLeadBody) => {\n      const res = await api.post<Referral>('/referrals/lead', body);\n      return res.data;\n    },\n    onSuccess: () => {\n      qc.invalidateQueries({ queryKey: referralKeys.agentList() });\n      qc.invalidateQueries({ queryKey: referralKeys.agentCode() });\n    },\n  });\n}\n\n/** Patient checks which agent referred them */\nexport function usePatientAttribution() {\n  const role = useAuthStore((s) => s.user?.role);\n  return useQuery({\n    queryKey: referralKeys.attribution(),\n    queryFn: async () => {\n      const res = await api.get<PatientAttributionInfo>('/referrals/patient-attribution');\n      return res.data;\n    },\n    enabled: role === 'patient',\n  });\n}\n","Overwrite":true,"Path":"/Users/ravi/Desktop/Kezza_mobile-main/src/features/referrals/hooks.ts"}}]}
