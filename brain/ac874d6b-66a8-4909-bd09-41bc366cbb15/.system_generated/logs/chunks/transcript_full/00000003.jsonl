code(header_json)}.{_b64url_encode(payload_json)}\"\n    signature = hmac.new(\n        JWT_SECRET.encode(\"utf-8\"),\n        unsigned_token.encode(\"utf-8\"),\n        hashlib.sha256,\n    ).digest()\n\n    return f\"{unsigned_token}.{_b64url_encode(signature)}\"\n\n\ndef decode_access_token(token: str) -> dict:\n    parts = token.split(\".\")\n    if len(parts) != 3:\n        raise ValueError(\"Invalid JWT format\")\n\n    unsigned_token = f\"{parts[0]}.{parts[1]}\"\n    expected_sig = hmac.new(\n        JWT_SECRET.encode(\"utf-8\"),\n        unsigned_token.encode(\"utf-8\"),\n        hashlib.sha256,\n    ).digest()\n    actual_sig = _b64url_decode(parts[2])\n\n    if not hmac.compare_digest(expected_sig, actual_sig):\n        raise ValueError(\"Invalid token signature\")\n\n    payload_bytes = _b64url_decode(parts[1])\n    payload = json.loads(payload_bytes.decode(\"utf-8\"))\n\n    if \"exp\" in payload and payload[\"exp\"] < time.time():\n        raise ValueError(\"Token has expired\")\n\n    return payload\n\n\n# ---------------------------------------------------------------------------\n# OTP & Authentication Services\n# ---------------------------------------------------------------------------\n\ndef request_otp(phone_e164: str, db: Session) -> str:\n    \"\"\"\n    Creates an OTP record for the phone number.\n    In development/testing, standard mock code '123456' is generated.\n    \"\"\"\n    code = \"123456\"\n    expires_at = datetime.now(timezone.utc) + timedelta(minutes=10)\n\n    otp_record = OtpRequest(\n        phone_e164=phone_e164,\n        otp_code=code,\n        expires_at=expires_at,\n        is_verified=False,\n    )\n    db.add(otp_record)\n    db.commit()\n    return code\n\n\ndef verify_otp_code(phone_e164: str, otp_code: str, db: Session) -> bool:\n    \"\"\"\n    Verifies that the OTP code matches for the given phone number.\n    Accepts '123456' as standard test code or valid active OTP record.\n    \"\"\"\n    if otp_code == \"123456\":\n        return True\n\n    stmt = (\n        select(OtpRequest)\n        .where(\n            OtpRequest.phone_e164 == phone_e164,\n            OtpRequest.otp_code == otp_code,\n            OtpRequest.is_verified.is_(False),\n            OtpRequest.expires_at > datetime.now(timezone.utc),\n        )\n        .order_by(OtpRequest.created_at.desc())\n    )\n    record = db.scalars(stmt).first()\n    if record:\n        record.is_verified = True\n        db.commit()\n        return True\n    return False\n\n\ndef get_user_by_phone(phone_e164: str, db: Session) -> User | None:\n    return db.scalars(select(User).where(User.phone_e164 == phone_e164)).first()\n\n\ndef build_user_profile(user: User, db: Session) -> dict:\n    \"\"\"\n    Determines whether the user is an agent or patient and returns full profile.\n    \"\"\"\n    agent = db.scalars(select(Agent).where(Agent.user_id == user.id)).first()\n    patient = db.scalars(select(Patient).where(Patient.user_id == user.id)).first()\n\n    role = \"agent\" if agent else \"patient\"\n    agent_code = agent.agent_code if agent else None\n\n    return {\n        \"id\": str(user.id),\n        \"phone_e164\": user.phone_e164,\n        \"full_name\": user.full_name,\n        \"email\": user.email,\n        \"role\": role,\n        \"agent_code\": agent_code,\n        \"patient_id\": str(patient.id) if patient else None,\n        \"agent_id\": str(agent.id) if agent else None,\n        \"is_active\": user.is_active,\n    }\n\n\ndef register_user(\n    phone_e164: str,\n    full_name: str,\n    role: str,\n    email: str | None,\n    referral_code: str | None,\n    db: Session,\n) -> tuple[str, dict]:\n    \"\"\"\n    Registers a new user as Patient or Agent.\n    If Patient registers with a referral_code, links and locks referral attribution!\n    \"\"\"\n    user = get_user_by_phone(phone_e164, db)\n    if not user:\n        user = User(\n            phone_e164=phone_e164,\n            full_name=full_name,\n            email=email,\n            is_active=True,\n        )\n        db.add(user)\n        db.flush()\n\n    if role == \"agent\":\n        agent = db.scalars(select(Agent).where(Agent.user_id == user.id)).first()\n        if not agent:\n            # Generate unique agent code (e.g. AGT-847291)\n            code_suffix = secrets.token_hex(3).upper()\n            code = f\"AGT-{code_suffix}\"\n            agent = Agent(\n                user_id=user.id,\n                agent_code=code,\n                status=\"active\",\n            )\n            db.add(agent)\n            db.flush()\n    else:\n        # Patient\n        patient = db.scalars(select(Patient).where(Patient.user_id == user.id)).first()\n        if not patient:\n            patient = Patient(user_id=user.id)\n            db.add(patient)\n            db.flush()\n\n        # Check referral attribution locking\n        if referral_code:\n            referral_code_clean = referral_code.strip().upper()\n            referring_agent = db.scalars(\n                select(Agent).where(Agent.agent_code == referral_code_clean)\n            ).first()\n\n            if referring_agent:\n                # Check if lead already exists for this phone\n                existing_ref = db.scalars(\n                    select(Referral).where(\n                        Referral.patient_phone_e164 == phone_e164\n                    )\n                ).first()\n\n                if existing_ref:\n                    existing_ref.patient_user_id = user.id\n                    existing_ref.status = \"registered\"\n                else:\n                    new_ref = Referral(\n                        patient_user_id=user.id,\n                        patient_name=full_name,\n                        patient_phone_e164=phone_e164,\n                        referring_agent_id=referring_agent.id,\n                        status=\"registered\",\n                    )\n                    db.add(new_ref)\n                db.flush()\n\n    db.commit()\n    db.refresh(user)\n\n    profile = build_user_profile(user, db)\n    token = create_access_token({\n        \"sub\": str(user.id),\n        \"phone\": user.phone_e164,\n        \"role\": profile[\"role\"],\n    })\n\n    return token, profile\n\n\ndef get_current_user(\n    credentials: HTTPAuthorizationCredentials | None = Depends(security),\n    db: Session = Depends(get_db),\n) -> dict:\n    if not credentials:\n        raise HTTPException(\n            status_code=status.HTTP_401_UNAUTHORIZED,\n            detail=\"Authentication token required\",\n        )\n\n    try:\n        payload = decode_access_token(credentials.credentials)\n        user_id = payload.get(\"sub\")\n        if not user_id:\n            raise ValueError()\n        user = db.get(User, uuid.UUID(user_id))\n        if not user:\n            raise ValueError()\n        return build_user_profile(user, db)\n    except Exception:\n        raise HTTPException(\n            status_code=status.HTTP_401_UNAUTHORIZED,\n            detail=\"Invalid or expired access token\",\n        )\n","Path":"/Users/ravi/Desktop/Kezza_mobile-main/backend/app/services/auth_service.py"}}]}
{"step_index":193,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-13T06:22:40Z","content":"Created At: 2026-11-13T11:52:40+05:30\nCompleted At: 2026-11-13T11:52:40+05:30\nCreated At: 2026-11-13T11:52:40+05:30\nCompleted At: 2026-11-13T11:52:40+05:30\nCreated file."}
{"step_index":194,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-13T06:22:40Z","input_tokens":4892,"cache_read_tokens":93300,"output_tokens":1303,"thinking":"Creating the specified service files. The `referral_service` file will handle referral data retrieval and creation, including summaries and listing referrals for a given agent ID, alongside functions for generating referral leads with patient information.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"import uuid\nfrom sqlalchemy import func, select\nfrom sqlalchemy.orm import Session\n\nfrom app.models.agent import Agent\nfrom app.models.referral import Referral\nfrom app.models.user import User\n\n\ndef get_agent_referral_summary(agent_id: uuid.UUID, db: Session) -> dict:\n    agent = db.get(Agent, agent_id)\n    if not agent:\n        raise ValueError(\"Agent not found\")\n\n    total_count = db.scalar(\n        select(func.count(Referral.id)).where(Referral.referring_agent_id == agent.id)\n    ) or 0\n\n    converted_count = db.scalar(\n        select(func.count(Referral.id)).where(\n            Referral.referring_agent_id == agent.id,\n            Referral.status == \"converted\",\n        )\n    ) or 0\n\n    referral_link = f\"kezzamobile://register?ref={agent.agent_code}\"\n\n    return {\n        \"agent_code\": agent.agent_code,\n        \"referral_link\": referral_link,\n        \"total_referrals\": total_count,\n        \"converted_count\": converted_count,\n    }\n\n\ndef list_agent_referrals(agent_id: uuid.UUID, db: Session) -> list[dict]:\n    stmt = (\n        select(Referral)\n        .where(Referral.referring_agent_id == agent_id)\n        .order_by(Referral.created_at.desc())\n    )\n    referrals = db.scalars(stmt).all()\n    results = []\n    for r in referrals:\n        results.append({\n            \"id\": str(r.id),\n            \"patient_name\": r.patient_name,\n            \"patient_phone_e164\": r.patient_phone_e164,\n            \"referring_agent_id\": str(r.referring_agent_id),\n            \"status\": r.status,\n            \"service_interest\": r.service_interest,\n            \"created_at\": r.created_at.isoformat() if r.created_at else \"\",\n            \"converted_at\": r.converted_at.isoformat() if r.converted_at else None,\n        })\n    return results\n\n\ndef create_referral_lead(\n    agent_id: uuid.UUID,\n    patient_name: str,\n    patient_phone_e164: str,\n    service_interest: str | None,\n    preferred_branch_id: str | None,\n    db: Session,\n) -> dict:\n    # Rule 4: Prevent duplicate referrals for the same phone number\n    existing = db.scalars(\n        select(Referral).where(Referral.patient_phone_e164 == patient_phone_e164)\n    ).first()\n\n    if existing:\n        raise ValueError(f\"Patient with number {patient_phone_e164} has already been registered or referred.\")\n\n    # Check if patient already has a user account\n    patient_user = db.scalars(\n        select(User).where(User.phone_e164 == patient_phone_e164)\n    ).first()\n\n    branch_uuid = uuid.UUID(preferred_branch_id) if preferred_branch_id else None\n\n    referral = Referral(\n        patient_user_id=patient_user.id if patient_user else None,\n        patient_name=patient_name,\n        patient_phone_e164=patient_phone_e164,\n        referring_agent_id=agent_id,\n        preferred_branch_id=branch_uuid,\n        service_interest=service_interest,\n        status=\"registered\",\n    )\n    db.add(referral)\n    db.commit()\n    db.refresh(referral)\n\n    return {\n        \"id\": str(referral.id),\n        \"patient_name\": referral.patient_name,\n        \"patient_phone_e164\": referral.patient_phone_e164,\n        \"referring_agent_id\": str(referral.referring_agent_id),\n        \"status\": referral.status,\n        \"service_interest\": referral.service_interest,\n        \"created_at\": referral.created_at.isoformat() if referral.created_at else \"\",\n        \"converted_at\": None,\n    }\n","Path":"/Users/ravi/Desktop/Kezza_mobile-main/backend/app/services/referral_service.py"}}]}
{"step_index":195,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-13T06:22:46Z","content":"Created At: 2026-11-13T11:52:46+05:30\nCompleted At: 2026-11-13T11:52:47+05:30\nCreated At: 2026-11-13T11:52:46+05:30\nCompleted At: 2026-11-13T11:52:47+05:30\nCreated file."}
{"step_index":196,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-13T06:22:47Z","input_tokens":2211,"cache_read_tokens":97360,"output_tokens":1473,"thinking":"Creating the `payment_service.py` module, focusing on payment processing, reward calculations, and agent commission logic. The patient purchases a treatment, triggering payment verification and reward point calculation: one point per ten Rands spent, which adds to the `points_ledger`. Then evaluating if the patient was referred to compute the agent's commission based on their referral.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"import uuid\nfrom datetime import datetime, timezone\nfrom sqlalchemy import func, select\nfrom sqlalchemy.orm import Session\n\nfrom app.models.agent import Agent\nfrom app.models.commission import CommissionLedger, CommissionTier\nfrom app.models.patient import Patient\nfrom app.models.payment import Payment\nfrom app.models.points import PointsLedger\nfrom app.models.referral import Referral\n\n\ndef process_treatment_payment(\n    patient_id: uuid.UUID,\n    treatment_name: str,\n    amount_rands: float,\n    payment_reference: str | None,\n    branch_id: str | None,\n    db: Session,\n) -> dict:\n    \"\"\"\n    Core Journey Step 4, 5 & 6:\n    1. Verifies & records treatment payment.\n    2. Credits rewards to patient's points ledger.\n    3. Converts referral and records agent's commission in commission ledger.\n    \"\"\"\n    patient = db.get(Patient, patient_id)\n    if not patient:\n        raise ValueError(\"Patient not found\")\n\n    amount_cents = int(round(amount_rands * 100))\n    if amount_cents <= 0:\n        raise ValueError(\"Amount must be greater than zero\")\n\n    ref = payment_reference or f\"KZ-TX-{uuid.uuid4().hex[:8].upper()}\"\n    branch_uuid = uuid.UUID(branch_id) if branch_id else patient.preferred_branch_id\n\n    # 1. Record verified Payment\n    payment = Payment(\n        patient_id=patient.id,\n        branch_id=branch_uuid,\n        treatment_name=treatment_name,\n        amount_cents=amount_cents,\n        currency=\"ZAR\",\n        status=\"verified\",\n        payment_reference=ref,\n        verified_at=datetime.now(timezone.utc),\n    )\n    db.add(payment)\n    db.flush()\n\n    # 2. Step 5: Reward Patient with Points (1 point per R10 spent = 10% back)\n    points_to_award = max(1, int(amount_rands // 10))\n\n    # Fetch current balance\n    latest_entry = db.scalars(\n        select(PointsLedger)\n        .where(PointsLedger.patient_id == patient.id)\n        .order_by(PointsLedger.created_at.desc())\n    ).first()\n    previous_balance = latest_entry.balance_after if latest_entry else 0\n    new_points_balance = previous_balance + points_to_award\n\n    points_entry = PointsLedger(\n        patient_id=patient.id,\n        payment_id=payment.id,\n        points=points_to_award,\n        balance_after=new_points_balance,\n        event_type=\"treatment_reward\",\n        description=f\"Reward points for {treatment_name}\",\n    )\n    db.add(points_entry)\n\n    # 3. Step 6: Determine and award Agent Commission\n    agent_commission_rands = None\n    referral_converted = False\n\n    referral = db.scalars(\n        select(Referral).where(Referral.patient_user_id == patient.user_id)\n    ).first()\n\n    if referral:\n        # Lock and convert referral if not already converted\n        if referral.status != \"converted\":\n            referral.status = \"converted\"\n            referral.converted_at = datetime.now(timezone.utc)\n            referral_converted = True\n\n        # Determine agent tier (default 10% commission on sales)\n        tier_percent = 10.0\n        commission_cents = int(round(amount_cents * (tier_percent / 100.0)))\n        agent_commission_rands = commission_cents / 100.0\n\n        commission_entry = CommissionLedger(\n            agent_id=referral.referring_agent_id,\n            referral_id=referral.id,\n            payment_id=payment.id,\n            tier_percent=tier_percent,\n            amount_cents=commission_cents,\n            status=\"approved\",\n            approved_at=datetime.now(timezone.utc),\n        )\n        db.add(commission_entry)\n\n    db.commit()\n    db.refresh(payment)\n\n    return {\n        \"payment_id\": str(payment.id),\n        \"treatment_name\": payment.treatment_name,\n        \"amount_rands\": amount_rands,\n        \"status\": payment.status,\n        \"points_earned\": points_to_award,\n        \"new_points_balance\": new_points_balance,\n        \"agent_commission_rands\": agent_commission_rands,\n        \"referral_converted\": referral_converted,\n    }\n","Path":"/Users/ravi/Desktop/Kezza_mobile-main/backend/app/services/payment_service.py"}}]}
{"step_index":197,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-13T06:22:54Z","content":"Created At: 2026-11-13T11:52:54+05:30\nCompleted At: 2026-11-13T11:52:54+05:30\nCreated At: 2026-11-13T11:52:54+05:30\nCompleted At: 2026-11-13T11:52:54+05:30\nCreated file."}
{"step_index":198,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-13T06:22:54Z","input_tokens":3755,"cache_read_tokens":97365,"output_tokens":1104,"thinking":"Constructing the `wallet_service` module, starting with functions to fetch patient wallet details and agent earnings. The `get_patient_wallet` function calculates a patient's total points and converts them to rand value. The `get_agent_earnings` function will query and aggregate commission ledger data to summarize an agent's earnings.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"import uuid\nfrom sqlalchemy import func, select\nfrom sqlalchemy.orm import Session\n\nfrom app.models.agent import Agent\nfrom app.models.commission import CommissionLedger\nfrom app.models.payment import Payment\nfrom app.models.points import PointsLedger\n\n\ndef get_patient_wallet(patient_id: uuid.UUID, db: Session) -> dict:\n    latest_entry = db.scalars(\n        select(PointsLedger)\n        .where(PointsLedger.patient_id == patient_id)\n        .order_by(PointsLedger.created_at.desc())\n    ).first()\n\n    total_points = latest_entry.balance_after if latest_entry else 0\n    credit_rands = float(total_points)  # 1 Point = R 1.00 treatment credit\n\n    stmt = (\n        select(PointsLedger)\n        .where(PointsLedger.patient_id == patient_id)\n        .order_by(PointsLedger.created_at.desc())\n    )\n    entries = db.scalars(stmt).all()\n\n    ledger = [\n        {\n            \"id\": str(e.id),\n            \"points\": e.points,\n            \"balance_after\": e.balance_after,\n            \"event_type\": e.event_type,\n            \"description\": e.description,\n            \"created_at\": e.created_at.isoformat() if e.created_at else \"\",\n        }\n        for e in entries\n    ]\n\n    return {\n        \"total_points\": total_points,\n        \"credit_rands\": credit_rands,\n        \"points_rate_description\": \"1 reward point per R10 spent. 1 point = R1.00 treatment credit.\",\n        \"ledger\": ledger,\n    }\n\n\ndef get_agent_earnings(agent_id: uuid.UUID, db: Session) -> dict:\n    agent = db.get(Agent, agent_id)\n    if not agent:\n        raise ValueError(\"Agent not found\")\n\n    stmt = (\n        select(CommissionLedger, Payment.treatment_name)\n        .join(Payment, CommissionLedger.payment_id == Payment.id)\n        .where(CommissionLedger.agent_id == agent_id)\n        .order_by(CommissionLedger.created_at.desc())\n    )\n    results = db.execute(stmt).all()\n\n    pending_cents = 0\n    approved_cents = 0\n    paid_cents = 0\n    ledger = []\n\n    for item, treatment_name in results:\n        if item.status == \"pending\":\n            pending_cents += item.amount_cents\n        elif item.status == \"approved\":\n            approved_cents += item.amount_cents\n        elif item.status == \"paid\":\n            paid_cents += item.amount_cents\n\n        ledger.append({\n            \"id\": str(item.id),\n            \"tier_percent\": item.tier_percent,\n            \"amount_rands\": item.amount_cents / 100.0,\n            \"status\": item.status,\n            \"created_at\": item.created_at.isoformat() if item.created_at else \"\",\n            \"treatment_name\": treatment_name,\n        })\n\n    total_earned_cents = approved_cents + paid_cents\n\n    return {\n        \"agent_code\": agent.agent_code,\n        \"commission_tier\": \"Standard Tier (10%)\",\n        \"tier_percent\": 10.0,\n        \"pending_rands\": pending_cents / 100.0,\n        \"approved_rands\": approved_cents / 100.0,\n        \"paid_rands\": paid_cents / 100.0,\n        \"total_earned_rands\": total_earned_cents / 100.0,\n        \"ledger\": ledger,\n    }\n","Path":"/Users/ravi/Desktop/Kezza_mobile-main/backend/app/services/wallet_service.py"}}]}
{"step_index":199,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-13T06:23:02Z","content":"Created At: 2026-11-13T11:53:02+05:30\nCompleted At: 2026-11-13T11:53:02+05:30\nCreated At: 2026-11-13T11:53:02+05:30\nCompleted At: 2026-11-13T11:53:02+05:30\nCreated file."}
{"step_index":200,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-13T06:23:02Z","input_tokens":4934,"cache_read_tokens":97366,"output_tokens":1160,"thinking":"Creating the API endpoints for authentication, referrals, payments, and the wallet functionalities, establishing the necessary structure within the `backend/app/api/v1/endpoints/` directory. Defined specific routes for each module, including OTP request/verification, registration, user information retrieval, referral code management, lead creation, treatment purchases, and payment history. This structure lays the foundation for all API interactions.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"from fastapi import APIRouter, Depends, HTTPException, status\nfrom sqlalchemy.orm import Session\n\nfrom app.database import get_db\nfrom app.schemas.auth import (\n    OtpRequestSchema,\n    OtpVerifySchema,\n    TokenResponseSchema,\n    UserProfileSchema,\n    UserRegisterSchema,\n)\nfrom app.services.auth_service import (\n    build_user_profile,\n    create_access_token,\n    get_current_user,\n    get_user_by_phone,\n    register_user,\n    request_otp,\n    verify_otp_code,\n)\n\nrouter = APIRouter(prefix=\"/auth\", tags=[\"Authentication\"])\n\n\n@router.post(\"/otp/request\")\ndef request_otp_endpoint(payload: OtpRequestSchema, db: Session = Depends(get_db)):\n    \"\"\"\n    Step 1: Request 6-digit OTP for mobile verification.\n    \"\"\"\n    code = request_otp(payload.phone_e164, db)\n    return {\n        \"status\": \"success\",\n        \"message\": f\"Verification code sent to {payload.phone_e164}\",\n        \"dev_code\": code,  # Provided for seamless local testing\n    }\n\n\n@router.post(\"/otp/verify\")\ndef verify_otp_endpoint(payload: OtpVerifySchema, db: Session = Depends(get_db)):\n    \"\"\"\n    Step 2: Verify OTP. Returns JWT and user profile if existing,\n    or signals that registration is required.\n    \"\"\"\n    is_valid = verify_otp_code(payload.phone_e164, payload.otp_code, db)\n    if not is_valid:\n        raise HTTPException(\n            status_code=status.HTTP_400_BAD_REQUEST,\n            detail=\"Invalid or expired verification code\",\n        )\n\n    user = get_user_by_phone(payload.phone_e164, db)\n    if not user:\n        return {\n            \"status\": \"needs_registration\",\n            \"phone_e164\": payload.phone_e164,\n            \"message\": \"User not registered. Please complete registration.\",\n        }\n\n    profile = build_user_profile(user, db)\n    token = create_access_token({\n        \"sub\": str(user.id),\n        \"phone\": user.phone_e164,\n        \"role\": profile[\"role\"],\n    })\n\n    return {\n        \"status\": \"success\",\n        \"access_token\": token,\n        \"token_type\": \"bearer\",\n        \"user\": profile,\n    }\n\n\n@router.post(\"/register\", response_model=TokenResponseSchema)\ndef register_endpoint(payload: UserRegisterSchema, db: Session = Depends(get_db)):\n    \"\"\"\n    Step 3: Register user account. If patient signs up with referral_code,\n    locks attribution to the referring agent.\n    \"\"\"\n    try:\n        token, profile = register_user(\n            phone_e164=payload.phone_e164,\n            full_name=payload.full_name,\n            role=payload.role,\n            email=payload.email,\n            referral_code=payload.referral_code,\n            db=db,\n        )\n        return TokenResponseSchema(access_token=token, user=UserProfileSchema(**profile))\n    except Exception as e:\n        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(e))\n\n\n@router.get(\"/me\", response_model=UserProfileSchema)\ndef get_me_endpoint(current_user: dict = Depends(get_current_user)):\n    \"\"\"\n    Returns current authenticated user profile.\n    \"\"\"\n    return UserProfileSchema(**current_user)\n","Path":"/Users/ravi/Desktop/Kezza_mobile-main/backend/app/api/v1/endpoints/auth.py"}}]}
