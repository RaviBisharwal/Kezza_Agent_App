{"step_index":222,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-13T06:24:11Z","input_tokens":5315,"cache_read_tokens":109547,"output_tokens":1198,"tool_calls":[{"name":"write_file","args":{"Content":"export interface OtpRequestBody {\n  phone_e164: string;\n}\n\nexport interface OtpVerifyBody {\n  phone_e164: string;\n  otp_code: string;\n}\n\nexport interface UserRegisterBody {\n  phone_e164: string;\n  full_name: string;\n  role: 'patient' | 'agent';\n  email?: string;\n  referral_code?: string;\n}\n\nexport interface UserProfileResponse {\n  id: string;\n  phone_e164: string;\n  full_name: string;\n  email: string | null;\n  role: 'patient' | 'agent';\n  agent_code: string | null;\n  patient_id: string | null;\n  agent_id: string | null;\n  is_active: boolean;\n}\n\nexport interface AuthTokenResponse {\n  access_token: string;\n  token_type: string;\n  user: UserProfileResponse;\n}\n\nexport interface OtpVerifyResponse {\n  status: 'success' | 'needs_registration';\n  access_token?: string;\n  token_type?: string;\n  user?: UserProfileResponse;\n  phone_e164?: string;\n  message?: string;\n}\n","Overwrite":true,"Path":"/Users/ravi/Desktop/Kezza_mobile-main/src/features/auth/types.ts"}},{"name":"write_file","args":{"Content":"import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';\nimport { api } from '@/lib/api';\nimport { useAuthStore } from '@/store/auth-store';\nimport type {\n  AuthTokenResponse,\n  OtpRequestBody,\n  OtpVerifyBody,\n  OtpVerifyResponse,\n  UserProfileResponse,\n  UserRegisterBody,\n} from './types';\n\n/** Step 1: Request an OTP for the phone number */\nexport function useRequestOtp() {\n  return useMutation({\n    mutationFn: async (body: OtpRequestBody) => {\n      const response = await api.post('/auth/otp/request', body);\n      return response.data;\n    },\n  });\n}\n\n/** Step 2: Verify the OTP */\nexport function useVerifyOtp() {\n  const signIn = useAuthStore((s) => s.signIn);\n\n  return useMutation({\n    mutationFn: async (body: OtpVerifyBody): Promise<OtpVerifyResponse> => {\n      const response = await api.post<OtpVerifyResponse>('/auth/otp/verify', body);\n      return response.data;\n    },\n    onSuccess: async (data) => {\n      if (data.status === 'success' && data.access_token && data.user) {\n        await signIn({\n          accessToken: data.access_token,\n          user: {\n            id: data.user.id,\n            fullName: data.user.full_name,\n            phone: data.user.phone_e164,\n            role: data.user.role,\n            agentCode: data.user.agent_code ?? undefined,\n            patientId: data.user.patient_id ?? undefined,\n            agentId: data.user.agent_id ?? undefined,\n            email: data.user.email ?? undefined,\n          },\n        });\n      }\n    },\n  });\n}\n\n/** Step 3: Register user account (Patient with optional referral code, or Agent) */\nexport function useRegisterUser() {\n  const signIn = useAuthStore((s) => s.signIn);\n\n  return useMutation({\n    mutationFn: async (body: UserRegisterBody): Promise<AuthTokenResponse> => {\n      const response = await api.post<AuthTokenResponse>('/auth/register', body);\n      return response.data;\n    },\n    onSuccess: async (data) => {\n      await signIn({\n        accessToken: data.access_token,\n        user: {\n          id: data.user.id,\n          fullName: data.user.full_name,\n          phone: data.user.phone_e164,\n          role: data.user.role,\n          agentCode: data.user.agent_code ?? undefined,\n          patientId: data.user.patient_id ?? undefined,\n          agentId: data.user.agent_id ?? undefined,\n          email: data.user.email ?? undefined,\n        },\n      });\n    },\n  });\n}\n\n/** Fetch latest profile of authenticated user */\nexport function useCurrentUser() {\n  return useQuery({\n    queryKey: ['auth', 'me'],\n    queryFn: async () => {\n      const res = await api.get<UserProfileResponse>('/auth/me');\n      return res.data;\n    },\n    enabled: !!useAuthStore.getState().accessToken,\n  });\n}\n","Overwrite":true,"Path":"/Users/ravi/Desktop/Kezza_mobile-main/src/features/auth/hooks.ts"}}]}
