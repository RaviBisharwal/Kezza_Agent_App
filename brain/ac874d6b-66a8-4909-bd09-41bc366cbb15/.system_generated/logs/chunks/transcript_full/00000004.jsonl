abBarIcon: () => (\n            <Text style={{ fontSize: 20 }}>{role === 'agent' ? '💰' : '🎁'}</Text>\n          ),\n        }}\n      />\n    </Tabs>\n  );\n}\n","Overwrite":true,"Path":"/Users/ravi/Desktop/Kezza_mobile-main/src/app/(app)/(tabs)/_layout.tsx"}}]}
