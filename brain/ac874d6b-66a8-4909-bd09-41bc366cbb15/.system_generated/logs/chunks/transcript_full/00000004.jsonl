et / Points ── */}\n51:       <Tabs.Screen\n52:         name=\"wallet\"\n53:         options={{\n54:           title: role === 'agent' ? 'Earnings' : 'Wallet',\n55:         }}\n56:       />\n57:     </Tabs>\n58:   );\n59: }"}
