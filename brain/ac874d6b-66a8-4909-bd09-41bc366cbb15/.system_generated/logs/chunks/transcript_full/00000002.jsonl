t = R 1) */\n  creditRands: number;\n}\n\nexport type LedgerEntryType = 'earn' | 'redeem' | 'reverse' | 'expire';\n\nexport interface PointsLedgerEntry {\n  id: string;\n  type: LedgerEntryType;\n  points: number;\n  description: string;\n  createdAt: string;\n}\n\nexport interface RedeemPointsBody {\n  points: number;\n  branch_id: string;\n  note?: string;\n}\n","Path":"/Users/ravi/Desktop/Kezza_mobile-main/src/features/points/types.ts"}},{"name":"write_file","args":{"Content":"/**\n * Points feature — React Query hooks.\n * Phase 5: implement when wallet endpoints are live.\n */\n\nimport { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';\nimport { api } from '@/lib/api';\nimport type { PointsBalance, PointsLedgerEntry, RedeemPointsBody } from './types';\n\nexport const pointsKeys = {\n  balance: ['points', 'balance'] as const,\n  ledger: ['points', 'ledger'] as const,\n};\n\nexport function usePointsBalance() {\n  return useQuery({\n    queryKey: pointsKeys.balance,\n    queryFn: () =>\n      api.get<PointsBalance>('/wallet/balance').then((r) => r.data),\n  });\n}\n\nexport function usePointsLedger() {\n  return useQuery({\n    queryKey: pointsKeys.ledger,\n    queryFn: () =>\n      api.get<PointsLedgerEntry[]>('/wallet/ledger').then((r) => r.data),\n  });\n}\n\nexport function useRedeemPoints() {\n  const qc = useQueryClient();\n  return useMutation({\n    mutationFn: (body: RedeemPointsBody) =>\n      api.post('/wallet/redeem', body),\n    onSuccess: () => {\n      qc.invalidateQueries({ queryKey: pointsKeys.balance });\n      qc.invalidateQueries({ queryKey: pointsKeys.ledger });\n    },\n  });\n}\n","Path":"/Users/ravi/Desktop/Kezza_mobile-main/src/features/points/hooks.ts"}},{"name":"write_file","args":{"Content":"/**\n * Commissions feature — shared types.\n * Phase 6: agent network and commission tracking.\n */\n\nexport type CommissionStatus = 'pending' | 'approved' | 'paid' | 'reversed';\n\nexport interface CommissionBalance {\n  pendingRands: number;\n  approvedRands: number;\n  paidRands: number;\n}\n\nexport interface CommissionLedgerEntry {\n  id: string;\n  status: CommissionStatus;\n  amountRands: number;\n  /** Percentage tier at which commission was calculated */\n  tierPercent: number;\n  referralId: string;\n  createdAt: string;\n}\n\nexport interface AgentNetworkMember {\n  id: string;\n  fullName: string;\n  agentCode: string;\n  status: 'active' | 'pending_verification' | 'inactive' | 'suspended';\n  referralCount: number;\n}\n","Path":"/Users/ravi/Desktop/Kezza_mobile-main/src/features/commissions/types.ts"}},{"name":"write_file","args":{"Content":"/**\n * Commissions feature — React Query hooks.\n * Phase 6: implement when commission endpoints are live.\n */\n\nimport { useQuery } from '@tanstack/react-query';\nimport { api } from '@/lib/api';\nimport type {\n  AgentNetworkMember,\n  CommissionBalance,\n  CommissionLedgerEntry,\n} from './types';\n\nexport const commissionKeys = {\n  balance: ['commissions', 'balance'] as const,\n  ledger: ['commissions', 'ledger'] as const,\n  network: ['commissions', 'network'] as const,\n};\n\nexport function useCommissionBalance() {\n  return useQuery({\n    queryKey: commissionKeys.balance,\n    queryFn: () =>\n      api.get<CommissionBalance>('/commissions/balance').then((r) => r.data),\n  });\n}\n\nexport function useCommissionLedger() {\n  return useQuery({\n    queryKey: commissionKeys.ledger,\n    queryFn: () =>\n      api.get<CommissionLedgerEntry[]>('/commissions/ledger').then((r) => r.data),\n  });\n}\n\nexport function useAgentNetwork() {\n  return useQuery({\n    queryKey: commissionKeys.network,\n    queryFn: () =>\n      api.get<AgentNetworkMember[]>('/agents/network').then((r) => r.data),\n  });\n}\n","Path":"/Users/ravi/Desktop/Kezza_mobile-main/src/features/commissions/hooks.ts"}}]}
