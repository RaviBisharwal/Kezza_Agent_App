ase):\n    __tablename__ = \"agents\"\n\n    id: Mapped[uuid.UUID] = mapped_column(\n        Uuid(as_uuid=True),\n        primary_key=True,\n        default=uuid.uuid4,\n    )\n\n    user_id: Mapped[uuid.UUID] = mapped_column(\n        Uuid(as_uuid=True),\n        ForeignKey(\"users.id\"),\n        nullable=False,\n        unique=True,\n    )\n\n    agent_code: Mapped[str] = mapped_column(\n        String(40),\n        nullable=False,\n        unique=True,\n    )\n\n    # The agent who recruited this agent\n    sponsor_agent_id: Mapped[uuid.UUID | None] = mapped_column(\n        Uuid(as_uuid=True),\n        ForeignKey(\"agents.id\"),\n        nullable=True,\n    )\n\n    status: Mapped[str] = mapped_column(\n        String(30),\n        nullable=False,\n        server_default=\"pending_verification\",\n    )\n\n    created_at: Mapped[DateTime] = mapped_column(\n        DateTime(timezone=True),\n        nullable=False,\n        server_default=func.now(),\n    )\n\n    __table_args__ = (\n        CheckConstraint(\n            \"status IN \"\n            \"('pending_verification', 'active', 'inactive', 'suspended')\",\n            name=\"ck_agents_status\",\n        ),\n        Index(\"ix_agents_sponsor_agent_id\", \"sponsor_agent_id\"),\n    )\n","Path":"/Users/ravi/Desktop/Kezza_mobile-main/backend/app/models/agent.py"}},{"name":"write_file","args":{"Content":"import uuid\n\nfrom sqlalchemy import CheckConstraint, DateTime, ForeignKey, Index, String, Uuid, func\nfrom sqlalchemy.orm import Mapped, mapped_column\n\nfrom app.base import Base\n\n\nclass Referral(Base):\n    __tablename__ = \"referrals\"\n\n    id: Mapped[uuid.UUID] = mapped_column(\n        Uuid(as_uuid=True),\n        primary_key=True,\n        default=uuid.uuid4,\n    )\n\n    # Nullable because an agent can register a lead\n    # before the patient creates an account.\n    patient_user_id: Mapped[uuid.UUID | None] = mapped_column(\n        Uuid(as_uuid=True),\n        ForeignKey(\"users.id\"),\n      