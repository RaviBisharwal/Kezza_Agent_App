{"step_index":79,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-13T06:09:56Z","input_tokens":415,"cache_read_tokens":73828,"output_tokens":2069,"tool_calls":[{"name":"write_file","args":{"Content":"\"/**\\n * Root layout — providers, splash overlay, and auth-aware routing.\\n *\\n * Authentication flow (Expo Router protected-route pattern):\\n *   • `useProtectedRoute` watches the Zustand auth store.\\n *   • Unauthenticated users are pushed to /(auth)/login.\\n *   • Authenticated users who land on an auth screen are pushed to the app.\\n *   • Navigation only fires once the router is ready AND auth state is hydrated,\\n *     so there is never a flash of the wrong screen.\\n *\\n * NOTE: Client-side redirects here are UX convenience only.\\n *       Every sensitive endpoint on the backend MUST still verify the JWT.\\n */\\n\\nimport { QueryClientProvider } from '@tanstack/react-query';\\nimport { DarkTheme, DefaultTheme, ThemeProvider } from 'expo-router';\\nimport { Slot, useRouter, useSegments } from 'expo-router';\\nimport * as SplashScreen from 'expo-splash-screen';\\nimport { useEffect } from 'react';\\nimport { useColorScheme } from 'react-native';\\n\\nimport { AnimatedSplashOverlay } from '@/components/animated-icon';\\nimport { queryClient } from '@/lib/query-client';\\nimport { useAuthStore } from '@/store/auth-store';\\n\\nSplashScreen.preventAutoHideAsync();\\n\\n// ---------------------------------------------------------------------------\\n// Hook: redirect based on auth state\\n// ---------------------------------------------------------------------------\\nfunction useProtectedRoute() {\\n  const router = useRouter();\\n  const segments = useSegments();\\n  const { isAuthenticated, isHydrated } = useAuthStore();\\n\\n  useEffect(() => {\\n    // Wait until SecureStore hydration is complete before redirecting.\\n    if (!isHydrated) return;\\n\\n    const inAuthGroup = segments[0] === '(auth)';\\n\\n    if (!isAuthenticated && !inAuthGroup) {\\n      // Not signed in → send to login.\\n      router.replace('/(auth)/login');\\n    } else if (isAuthenticated && inAuthGroup) {\\n      // Already signed in → skip auth screens.\\n      router.replace('/(app)/(tabs)');\\n    }\\n  }, [isAuthenticated, isHydrated, segments, router\n<truncated 813 bytes>","Overwrite":"true","Path":"\"/Users/ravi/Desktop/Kezza_mobile-main/src/app/_layout.tsx\""}},{"name":"write_file","args":{"Content":"\"/**\\n * Auth group layout — wraps /(auth)/login and /(auth)/verify-otp.\\n *\\n * Uses a Stack navigator with no visible header so each auth screen can\\n * define its own full-screen UI without interference from navigation chrome.\\n */\\n\\nimport { Stack } from 'expo-router';\\n\\nexport default function AuthLayout() {\\n  return (\\n    <Stack screenOptions={{ headerShown: false }}>\\n      <Stack.Screen name=\\\"login\\\" />\\n      <Stack.Screen name=\\\"verify-otp\\\" />\\n    </Stack>\\n  );\\n}\\n\"","Path":"\"/Users/ravi/Desktop/Kezza_mobile-main/src/app/(auth)/_layout.tsx\""}},{"name":"write_file","args":{"Content":"\"/**\\n * Protected app group layout.\\n *\\n * Acts as the second line of defence against unauthenticated access:\\n * if the root layout redirect hasn't fired yet (edge case on slow devices),\\n * this layout also redirects to login.\\n *\\n * Contains a Stack that hosts:\\n *  • (tabs)  — the three main tabs\\n *  • profile — the profile screen (pushed modally from any tab)\\n */\\n\\nimport { Redirect, Stack } from 'expo-router';\\n\\nimport { useAuthStore } from '@/store/auth-store';\\n\\nexport default function AppLayout() {\\n  const { isAuthenticated, isHydrated } = useAuthStore();\\n\\n  // Still loading from SecureStore — render nothing to avoid a flash.\\n  if (!isHydrated) return null;\\n\\n  // Belt-and-suspenders redirect (the root layout does this too).\\n  if (!isAuthenticated) {\\n    return <Redirect href=\\\"/(auth)/login\\\" />;\\n  }\\n\\n  return (\\n    <Stack screenOptions={{ headerShown: false }}>\\n      {/* Transparent group: (tabs) renders the tab bar */}\\n      <Stack.Screen name=\\\"(tabs)\\\" />\\n      {/* Profile is pushed as a card over the tabs */}\\n      <Stack.Screen\\n        name=\\\"profile\\\"\\n        options={{\\n          headerShown: true,\\n          title: 'Profile',\\n          presentation: 'card',\\n        }}\\n      />\\n    </Stack>\\n  );\\n}\\n\"","Path":"\"/Users/ravi/Desktop/Kezza_mobile-main/src/app/(app)/_layout.tsx\""}},{"name":"write_file","args":{"Content":"\"/**\\n * Tab navigator layout for the three main app tabs.\\n *\\n * Tab visibility can be made role-aware here — e.g. hide the\\n * Referrals tab for patients — by reading from the auth store.\\n */\\n\\nimport { Tabs } from 'expo-router';\\nimport { useColorScheme } from 'react-native';\\n\\nimport { Colors } from '@/constants/theme';\\nimport { useAuthStore } from '@/store/auth-store';\\n\\nexport default function TabsLayout() {\\n  const colorScheme = useColorScheme() ?? 'light';\\n  const colors = Colors[colorScheme === 'dark' ? 'dark' : 'light'];\\n  const role = useAuthStore((s) => s.user?.role);\\n\\n  return (\\n    <Tabs\\n      screenOptions={{\\n        headerShown: false,\\n        tabBarActiveTintColor: '#3C9FFE',\\n        tabBarInactiveTintColor: colors.textSecondary,\\n        tabBarStyle: { backgroundColor: colors.background },\\n      }}\\n    >\\n      {/* ── Home / Dashboard ── */}\\n      <Tabs.Screen\\n        name=\\\"index\\\"\\n        options={{\\n          title: 'Home',\\n          tabBarIcon: ({ color, size }) => (\\n            // SymbolView not available here without native view context;\\n            // replace with expo-symbols <SymbolView> once screens are built.\\n            null\\n          ),\\n        }}\\n      />\\n\\n      {/* ── Referrals (agents + patients) ── */}\\n      <Tabs.Screen\\n        name=\\\"referrals\\\"\\n        options={{\\n          title: 'Referrals',\\n          // Agents see their referral pipeline; patients see their own status.\\n        }}\\n      />\\n\\n      {/* ── Wallet / Points ── */}\\n      <Tabs.Screen\\n        name=\\\"wallet\\\"\\n        options={{\\n          title: role === 'agent' ? 'Earnings' : 'Wallet',\\n        }}\\n      />\\n    </Tabs>\\n  );\\n}\\n\"","Path":"\"/Users/ravi/Desktop/Kezza_mobile-main/src/app/(app)/(tabs)/_layout.tsx\""}}],"truncated_fields":["tool_calls"]}
