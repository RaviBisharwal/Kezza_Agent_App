{"step_index":96,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-13T06:12:24Z","input_tokens":2411,"cache_read_tokens":84535,"output_tokens":2897,"content":"Now create the feature folders with their types and hook stubs:","tool_calls":[{"name":"write_file","args":{"Content":"\"/**\\n * Auth feature — shared types.\\n * Expanded in Phase 3 when real auth endpoints are built.\\n */\\n\\nexport interface OtpRequestBody {\\n  phone_e164: string;\\n}\\n\\nexport interface OtpVerifyBody {\\n  phone_e164: string;\\n  otp_code: string;\\n}\\n\\nexport interface AuthTokenResponse {\\n  access_token: string;\\n  token_type: 'bearer';\\n  user: {\\n    id: string;\\n    full_name: string;\\n    phone_e164: string;\\n    role: 'patient' | 'agent';\\n    agent_code?: string;\\n  };\\n}\\n\"","Path":"\"/Users/ravi/Desktop/Kezza_mobile-main/src/features/auth/types.ts\""}},{"name":"write_file","args":{"Content":"\"/**\\n * Auth feature — React Query hooks.\\n * Phase 3: implement these when OTP endpoints are live.\\n */\\n\\nimport { useMutation } from '@tanstack/react-query';\\nimport { api } from '@/lib/api';\\nimport { useAuthStore } from '@/store/auth-store';\\nimport type { AuthTokenResponse, OtpRequestBody, OtpVerifyBody } from './types';\\n\\n/** Step 1: Request an OTP for the given phone number. */\\nexport function useRequestOtp() {\\n  return useMutation({\\n    mutationFn: (body: OtpRequestBody) =>\\n      api.post('/auth/otp/request', body),\\n  });\\n}\\n\\n/** Step 2: Verify the OTP and receive tokens. */\\nexport function useVerifyOtp() {\\n  const signIn = useAuthStore((s) => s.signIn);\\n\\n  return useMutation({\\n    mutationFn: (body: OtpVerifyBody) =>\\n      api.post<AuthTokenResponse>('/auth/otp/verify', body).then((r) => r.data),\\n    onSuccess: async (data) => {\\n      await signIn({\\n        accessToken: data.access_token,\\n        user: {\\n          id: data.user.id,\\n          fullName: data.user.full_name,\\n          phone: data.user.phone_e164,\\n          role: data.user.role,\\n          agentCode: data.user.agent_code,\\n        },\\n      });\\n    },\\n  });\\n}\\n\"","Path":"\"/Users/ravi/Desktop/Kezza_mobile-main/src/features/auth/hooks.ts\""}},{"name":"write_file","args":{"Content":"\"/**\\n * Referrals feature — shared types.\\n * Mirrors the backend Referral model; extended in Phase 4.\\n */\\n\\nexport type ReferralStatus =\\n  | 'registered'\\n  | 'contacted'\\n  | 'consultation_booked'\\n  | 'converted'\\n  | 'not_converted'\\n  | 'rejected';\\n\\nexport interface Referral {\\n  id: string;\\n  patientName: string;\\n  patientPhone: string;\\n  status: ReferralStatus;\\n  serviceInterest: string | null;\\n  preferredBranchId: string | null;\\n  createdAt: string;\\n  convertedAt: string | null;\\n}\\n\\nexport interface CreateReferralBody {\\n  patient_name: string;\\n  patient_phone_e164: string;\\n  preferred_branch_id?: string;\\n  service_interest?: string;\\n}\\n\"","Path":"\"/Users/ravi/Desktop/Kezza_mobile-main/src/features/referrals/types.ts\""}},{"name":"write_file","args":{"Content":"\"/**\\n * Referrals feature — React Query hooks.\\n * Phase 4: implement when referral endpoints are live.\\n */\\n\\nimport { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';\\nimport { api } from '@/lib/api';\\nimport type { CreateReferralBody, Referral } from './types';\\n\\nexport const referralKeys = {\\n  all: ['referrals'] as const,\\n  list: () => [...referralKeys.all, 'list'] as const,\\n  detail: (id: string) => [...referralKeys.all, id] as const,\\n};\\n\\n/** Fetch all referrals for the current agent. */\\nexport function useReferrals() {\\n  return useQuery({\\n    queryKey: referralKeys.list(),\\n    queryFn: () =>\\n      api.get<Referral[]>('/referrals').then((r) => r.data),\\n  });\\n}\\n\\n/** Create a new patient referral. */\\nexport function useCreateReferral() {\\n  const qc = useQueryClient();\\n  return useMutation({\\n    mutationFn: (body: CreateReferralBody) =>\\n      api.post<Referral>('/referrals', body).then((r) => r.data),\\n    onSuccess: () => {\\n      qc.invalidateQueries({ queryKey: referralKeys.list() });\\n    },\\n  });\\n}\\n\"","Path":"\"/Users/ravi/Desktop/Kezza_mobile-main/src/features/referrals/hooks.ts\""}},{"name":"write_file","args":{"Content":"\"/**\\n * Points feature — shared types.\\n * Phase 5: patient wallet — balance, ledger, redemptions.\\n */\\n\\nexport interface PointsBalance {\\n  totalPoints: number;\\n  /** Monetary value of points (e.g. 1 pt = R 1) */\\n  creditRands: number;\\n}\\n\\nexport type LedgerEntryType = 'earn' | 'redeem' | 'reverse' | 'expire';\\n\\nexport interface PointsLedgerEntry {\\n  id: string;\\n  type: LedgerEntryType;\\n  points: number;\\n  description: string;\\n  createdAt: string;\\n}\\n\\nexport interface RedeemPointsBody {\\n  points: number;\\n  branch_id: string;\\n  note?: string;\\n}\\n\"","Path":"\"/Users/ravi/Desktop/Kezza_mobile-main/src/features/points/types.ts\""}},{"name":"write_file","args":{"Content":"\"/**\\n * Points feature — React Query hooks.\\n * Phase 5: implement when wallet endpoints are live.\\n */\\n\\nimport { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';\\nimport { api } from '@/lib/api';\\nimport type { PointsBalance, PointsLedgerEntry, RedeemPointsBody } from './types';\\n\\nexport const pointsKeys = {\\n  balance: ['points', 'balance'] as const,\\n  ledger: ['points', 'ledger'] as const,\\n};\\n\\nexport function usePointsBalance() {\\n  return useQuery({\\n    queryKey: pointsKeys.balance,\\n    queryFn: () =>\\n      api.get<PointsBalance>('/wallet/balance').then((r) => r.data),\\n  });\\n}\\n\\nexport function usePointsLedger() {\\n  return useQuery({\\n    queryKey: pointsKeys.ledger,\\n    queryFn: () =>\\n      api.get<PointsLedgerEntry[]>('/wallet/ledger').then((r) => r.data),\\n  });\\n}\\n\\nexport function useRedeemPoints() {\\n  const qc = useQueryClient();\\n  return useMutation({\\n    mutationFn: (body: RedeemPointsBody) =>\\n      api.post('/wallet/redeem', body),\\n    onSuccess: () => {\\n      qc.invalidateQueries({ queryKey: pointsKeys.balance });\\n      qc.invalidateQueries({ queryKey: pointsKeys.ledger });\\n    },\\n  });\\n}\\n\"","Path":"\"/Users/ravi/Desktop/Kezza_mobile-main/src/features/points/hooks.ts\""}},{"name":"write_file","args":{"Content":"\"/**\\n * Commissions feature — shared types.\\n * Phase 6: agent network and commission tracking.\\n */\\n\\nexport type CommissionStatus = 'pending' | 'approved' | 'paid' | 'reversed';\\n\\nexport interface CommissionBalance {\\n  pendingRands: number;\\n  approvedRands: number;\\n  paidRands: number;\\n}\\n\\nexport interface CommissionLedgerEntry {\\n  id: string;\\n  status: CommissionStatus;\\n  amountRands: number;\\n  /** Percentage tier at which commission was calculated */\\n  tierPercent: number;\\n  referralId: string;\\n  createdAt: string;\\n}\\n\\nexport interface AgentNetworkMember {\\n  id: string;\\n  fullName: string;\\n  agentCode: string;\\n  status: 'active' | 'pending_verification' | 'inactive' | 'suspended';\\n  referralCount: number;\\n}\\n\"","Path":"\"/Users/ravi/Desktop/Kezza_mobile-main/src/features/commissions/types.ts\""}},{"name":"write_file","args":{"Content":"\"/**\\n * Commissions feature — React Query hooks.\\n * Phase 6: implement when commission endpoints are live.\\n */\\n\\nimport { useQuery } from '@tanstack/react-query';\\nimport { api } from '@/lib/api';\\nimport type {\\n  AgentNetworkMember,\\n  CommissionBalance,\\n  CommissionLedgerEntry,\\n} from './types';\\n\\nexport const commissionKeys = {\\n  balance: ['commissions', 'balance'] as const,\\n  ledger: ['commissions', 'ledger'] as const,\\n  network: ['commissions', 'network'] as const,\\n};\\n\\nexport function useCommissionBalance() {\\n  return useQuery({\\n    queryKey: commissionKeys.balance,\\n    queryFn: () =>\\n      api.get<CommissionBalance>('/commissions/balance').then((r) => r.data),\\n  });\\n}\\n\\nexport function useCommissionLedger() {\\n  return useQuery({\\n    queryKey: commissionKeys.ledger,\\n    queryFn: () =>\\n      api.get<CommissionLedgerEntry[]>('/commissions/ledger').then((r) => r.data),\\n  });\\n}\\n\\nexport function useAgentNetwork() {\\n  return useQuery({\\n    queryKey: commissionKeys.network,\\n    queryFn: () =>\\n      api.get<AgentNetworkMember[]>('/agents/network').then((r) => r.data),\\n  });\\n}\\n\"","Path":"\"/Users/ravi/Desktop/Kezza_mobile-main/src/features/commissions/hooks.ts\""}}]}
