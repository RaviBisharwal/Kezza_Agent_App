  </View>\\n\\n        <View style={[styles.empty, { backgroundColor: theme.backgroundElement }]}>\\n          <Text style={{ color: theme.textSecondary }}>\\n            {role === 'agent'\\n              ? 'Coming in Phase 6 — Agent Commissions'\\n              : 'Coming in Phase 5 — Patient Wallet'}\\n          </Text>\\n        </View>\\n      </View>\\n    </SafeAreaView>\\n  );\\n}\\n\\nconst styles = StyleSheet.create({\\n  safe: { flex: 1 },\\n  container: { flex: 1, padding: Spacing.four, gap: Spacing.three },\\n  ti\n<truncated 474 bytes>","Path":"\"/Users/ravi/Desktop/Kezza_mobile-main/src/app/(app)/(tabs)/wallet.tsx\""}},{"name":"write_file","args":{"Content":"\"/**\\n * Profile screen — accessible from any tab via the header button.\\n *\\n * Shows the signed-in user's details and provides a sign-out action.\\n * Phase 3: wire the sign-out button to DELETE /api/v1/auth/token (revoke).\\n */\\n\\nimport { router } from 'expo-router';\\nimport { Pressable, StyleSheet, Text, View } from 'react-native';\\nimport { SafeAreaView } from 'react-native-safe-area-context';\\n\\nimport { useTheme } from '@/hooks/use-theme';\\nimport { useAuthStore } from '@/store/auth-store';\\nimport { Spacing } from '@/constants/theme';\\n\\nexport default function ProfileScreen() {\\n  const theme = useTheme();\\n  const { user, signOut } = useAuthStore();\\n\\n  async function handleSignOut() {\\n    await signOut();\\n    router.replace('/(auth)/login');\\n  }\\n\\n  return (\\n    <SafeAreaView style={[styles.safe, { backgroundColor: theme.background }]}>\\n      <View style={styles.container}>\\n        {/* ── Avatar placeholder ── */}\\n        <View style={[styles.avatar, { backgroundColor: '#3C9FFE' }]}>\\n          <Text style={styles.avatarInitial}>\\n            {user?.fullName?.[0]?.toUpperCase() ?? '?'}\\n          </Text>\\n        </View>\\n\\n        {/* ── User info ── */}\\n        <Text style={[styles.name, { color: theme.text }]}>\\n          {user?.fullName ?? '—'}\\n        </Text>\\n        <Text style={[styles.phone, { color: theme.textSecondary }]}>\\n          {user?.phone ?? '—'}\\n        </Text>\\n\\n        <View style={[styles.roleBadge, { backgroundColor: theme.backgroundElement }]}>\\n          <Text style={{ color: theme.text, fontSize: 13, fontWeight: '600' }}>\\n            {user?.role === 'agent' ? '🏷️ Agent' : '🏥 Patient'}\\n          </Text>\\n        </View>\\n\\n        {/* ── Spacer ── */}\\n        <View style={{ flex: 1 }} />\\n\\n        {/* ── Sign out ── */}\\n        <Pressable\\n          style={({ pressed }) => [styles.signOut, pressed && { opacity: 0.7 }]}\\n          onPress={handleSignOut}\\n        >\\n          <Text style={styles.signOutText}>Sign o\n<truncated 959 bytes>","Path":"\"/Users/ravi/Desktop/Kezza_mobile-main/src/app/(app)/profile.tsx\""}}],"truncated_fields":["tool_calls"]}
