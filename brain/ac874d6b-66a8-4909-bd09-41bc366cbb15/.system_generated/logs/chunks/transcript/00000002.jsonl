{"step_index":228,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-13T06:24:25Z","input_tokens":3793,"cache_read_tokens":113593,"output_tokens":794,"tool_calls":[{"name":"write_file","args":{"Content":"\"export interface PointsLedgerEntry {\\n  id: string;\\n  points: number;\\n  balance_after: number;\\n  event_type: string;\\n  description: string;\\n  created_at: string;\\n}\\n\\nexport interface PatientWalletInfo {\\n  total_points: number;\\n  credit_rands: number;\\n  points_rate_description: string;\\n  ledger: PointsLedgerEntry[];\\n}\\n\\nexport interface TreatmentPaymentCreateBody {\\n  treatment_name: string;\\n  amount_rands: number;\\n  payment_reference?: string;\\n  branch_id?: string;\\n  patient_id?: string;\\n}\\n\\nexport interface TreatmentPaymentResponse {\\n  payment_id: string;\\n  treatment_name: string;\\n  amount_rands: number;\\n  status: string;\\n  points_earned: number;\\n  new_points_balance: number;\\n  agent_commission_rands: number | null;\\n  referral_converted: boolean;\\n}\\n\"","Overwrite":"true","Path":"\"/Users/ravi/Desktop/Kezza_mobile-main/src/features/points/types.ts\""}},{"name":"write_file","args":{"Content":"\"import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';\\nimport { api } from '@/lib/api';\\nimport { useAuthStore } from '@/store/auth-store';\\nimport { commissionKeys } from '@/features/commissions/hooks';\\nimport { referralKeys } from '@/features/referrals/hooks';\\nimport type {\\n  PatientWalletInfo,\\n  TreatmentPaymentCreateBody,\\n  TreatmentPaymentResponse,\\n} from './types';\\n\\nexport const pointsKeys = {\\n  wallet: ['wallet', 'patient'] as const,\\n};\\n\\n/** Patient fetches their points balance and wallet ledger */\\nexport function usePatientWallet() {\\n  const role = useAuthStore((s) => s.user?.role);\\n  return useQuery({\\n    queryKey: pointsKeys.wallet,\\n    queryFn: async () => {\\n      const res = await api.get<PatientWalletInfo>('/wallet/patient');\\n      return res.data;\\n    },\\n    enabled: role === 'patient',\\n  });\\n}\\n\\n/** Patient purchases a treatment — generates points reward and agent commission */\\nexport function usePurchaseTreatment() {\\n  const qc = useQueryClient();\\n  return useMutation({\\n    mutationFn: async (body: TreatmentPaymentCreateBody): Promise<TreatmentPaymentResponse> => {\\n      const res = await api.post<TreatmentPaymentResponse>('/payments/purchase-treatment', body);\\n      return res.data;\\n    },\\n    onSuccess: () => {\\n      // Invalidate patient wallet\\n      qc.invalidateQueries({ queryKey: pointsKeys.wallet });\\n      // Invalidate agent earnings & referrals in case user is testing both\\n      qc.invalidateQueries({ queryKey: commissionKeys.earnings });\\n      qc.invalidateQueries({ queryKey: referralKeys.agentList() });\\n      qc.invalidateQueries({ queryKey: referralKeys.agentCode() });\\n    },\\n  });\\n}\\n\"","Overwrite":"true","Path":"\"/Users/ravi/Desktop/Kezza_mobile-main/src/features/points/hooks.ts\""}}]}
