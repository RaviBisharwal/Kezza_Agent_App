ert ref_info[\\\"agent_code\\\"] == agent_code\\n    assert f\\\"ref={agent_code}\\\" in ref_info[\\\"referral_link\\\"]\\n    assert ref_info[\\\"total_referrals\\\"] == 0\\n\\n    # =========================================================================\\n    # Step 2: Patient registers using agent's referral link\\n    # =========================================================================\\n    patient_phone =\n<truncated 4581 bytes>","Path":"\"/Users/ravi/Desktop/Kezza_mobile-main/backend/app/tests/test_journey.py\""}}],"truncated_fields":["tool_calls"]}
