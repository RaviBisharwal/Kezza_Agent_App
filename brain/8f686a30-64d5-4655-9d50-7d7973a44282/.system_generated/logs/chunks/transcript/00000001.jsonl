{"step_index":183,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-14T06:15:47Z","content":"Created At: 2026-11-14T11:45:47+05:30\nCompleted At: 2026-11-14T11:45:47+05:30\nCreated At: 2026-11-14T11:45:47+05:30\nCompleted At: 2026-11-14T11:45:47+05:30\nShowing lines 1-45 of 45\n1: \"\"\"Create the first admin user from environment variables (writes to admins collection).\"\"\"\n2: \n3: from __future__ import annotations\n4: \n5: import os\n6: from datetime import datetime, timezone\n7: \n8: from dotenv import load_dotenv\n9: \n10: from .mongodb import get_database\n11: from .security import hash_password\n12: \n13: load_dotenv()\n14: \n15: \n16: def main() -> None:\n17:     email = os.getenv(\"ADMIN_EMAIL\", \"\").strip().lower()\n18:     password = os.getenv(\"ADMIN_PASSWORD\", \"\")\n19:     name = os.getenv(\"ADMIN_NAME\", \"Administrator\").strip()\n20: \n21:     if not email or len(password) < 8:\n22:         raise SystemExit(\"Set ADMIN_EMAIL and ADMIN_PASSWORD (min 8 chars) to bootstrap an admin account.\")\n23: \n24:     db = get_database()\n25:     existing = db.admins.find_one({\"email\": email})\n26: \n27:     if existing:\n28:         changes: dict = {\"name\": name, \"status\": \"active\"}\n29:         if password:\n30:             changes[\"password_hash\"] = hash_password(password)\n31:         db.admins.update_one({\"_id\": existing[\"_id\"]}, {\"$set\": changes})\n32:         print(f\"Admin account updated: {email}\")\n33:     else:\n34:         admin = {\n35:             \"name\": name,\n36:             \"email\": email,\n37:             \"password_hash\": hash_password(password),\n38:             \"status\": \"active\",\n39:             \"created_at\": datetime.now(timezone.utc),\n40:         }\n41:         db.admins.insert_one(admin)\n42:         print(f\"Admin account created: {email}\")\n43: \n44: \n45: main()"}
