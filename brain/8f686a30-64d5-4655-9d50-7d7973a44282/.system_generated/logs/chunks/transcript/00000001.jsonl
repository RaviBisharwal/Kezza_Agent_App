{"step_index":177,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-14T06:15:36Z","content":"Created At: 2026-11-14T11:45:36+05:30\nCompleted At: 2026-11-14T11:45:37+05:30\nCreated At: 2026-11-14T11:45:36+05:30\nCompleted At: 2026-11-14T11:45:37+05:30\nShowing lines 1-31 of 31\n1: const API_URL = (import.meta.env.VITE_API_URL || 'http://localhost:8001').replace(/\\/$/, '')\n2: \n3: export class ApiError extends Error {\n4:   status: number\n5: \n6:   constructor(message: string, status: number) {\n7:     super(message)\n8:     this.status = status\n9:   }\n10: }\n11: \n12: export async function api<T>(path: string, options: RequestInit = {}): Promise<T> {\n13:   const token = localStorage.getItem('adminToken')\n14:   const response = await fetch(`${API_URL}${path}`, {\n15:     ...options,\n16:     headers: {\n17:       Accept: 'application/json',\n18:       ...(options.body ? { 'Content-Type': 'application/json' } : {}),\n19:       ...(token ? { Authorization: `Bearer ${token}` } : {}),\n20:       ...options.headers,\n21:     },\n22:   })\n23: \n24:   if (!response.ok) {\n25:     const body = await response.json().catch(() => ({}))\n26:     throw new ApiError(body.detail || `Request failed (${response.status})`, response.status)\n27:   }\n28: \n29:   if (response.status === 204) return undefined as T\n30:   return response.json() as Promise<T>\n31: }"}
